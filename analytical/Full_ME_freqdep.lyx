\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\Sigma_{ME}''\left(\boldsymbol{k},\omega\right) & =-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu-\epsilon\right)\left(B^{-}\left(\boldsymbol{q},\epsilon\right)-B^{+}\left(\boldsymbol{q},\epsilon\right)\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\\
\\
 & =-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu-\epsilon\right)\left(B^{-}\left(\boldsymbol{q},\epsilon\right)\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\\
 & +=-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu-\epsilon\right)\left(-B^{-}\left(\boldsymbol{q},\epsilon\right)\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\\
\\
 & =-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu-\epsilon\right)\left(B^{-}\left(\boldsymbol{q},\epsilon\right)\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\\
 & +=-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu+\epsilon\right)\left(-B^{-}\left(\boldsymbol{q},-\epsilon\right)\right)\left[n_{B}\left(-\epsilon\right)+n_{F}\left(-\epsilon-\nu\right)\right]\\
\\
 & =-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu-\epsilon\right)\left(B^{-}\left(\boldsymbol{q},\epsilon\right)\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\\
 & +=-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu+\epsilon\right)\left(B^{-}\left(\boldsymbol{q},\epsilon\right)\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon+\nu\right)\right]\\
\\
 & =-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\left[A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu+\epsilon\right)+A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu-\epsilon\right)\right]\left(B^{-}\left(\boldsymbol{q},\epsilon\right)\right)\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon-\nu\right)+n_{F}\left(\epsilon+\nu\right)\right]\\
