\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\Sigma_{ME}''\left(\boldsymbol{k},\omega\right) & =-\pi\Lambda_{\boldsymbol{k}}\int\frac{d\nu}{\pi}\ \chi''\left(\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\left[2n_{B}\left(\omega_{0}\right)+n_{F}\left(\omega_{0}-\nu\right)+n_{F}\left(\nu+\omega_{0}\right)\right]\\
\\
 & =-2n_{B}\left(\omega_{0}\right)\Lambda_{\boldsymbol{k}}\int d\nu\ \chi''\left(\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\\
 & =-\Lambda_{\boldsymbol{k}}\int d\nu\ \chi''\left(\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\left[n_{F}\left(\omega_{0}-\nu\right)+n_{F}\left(\nu+\omega_{0}\right)\right]\\
\\
 & =-2\pi\kappa\alpha n_{B}\left(\omega_{0}\right)\Lambda_{\boldsymbol{k}}Y\left(\beta\omega,\alpha\beta J\right)\\
 & -2\pi\kappa\alpha\Lambda_{\boldsymbol{k}}Z\left(\beta\omega,\alpha\beta J,\beta\omega_{0}\right)\\
\\
 & =-2\pi\kappa\alpha\Lambda_{\boldsymbol{k}}\left(n_{B}\left(\omega_{0}\right)Y\left(\beta\omega,\alpha\pi\beta J\right)+Z\left(\beta\omega,\alpha\pi\beta J,\beta\omega_{0}\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we defined 
\begin_inset Formula 
\begin{align*}
\int d\nu\ \chi''\left(\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\\
=\int d\nu\ \chi''\left(\nu\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\\
=\int_{-\alpha\pi J}^{\alpha\pi J}d\nu\ \frac{\kappa\beta\nu}{J}\left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\\
=\frac{\kappa\beta}{J}\int_{-\alpha\pi J}^{\alpha\pi J}d\nu\ \nu\left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\\
=\frac{\kappa}{\beta J}\int_{-\alpha\pi\beta J}^{\alpha\pi\beta J}d\nu\ \nu\left[\frac{1}{e^{\nu}-1}+\frac{1}{e^{\nu-\beta\omega}+1}\right]\\
=\pi\kappa\alpha Y\left(\beta\omega,\alpha\pi\beta J\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula 
\[
Y\left(x,y\right)=-\frac{y}{2}-\log\left[\left(e^{-y-x}+1\right)\left(e^{y-x}+1\right)\right]+\frac{\text{Li}_{2}\left(-e^{-y-x}\right)-\text{Li}_{2}\left(-e^{y-x}\right)-2\text{Li}_{2}\left(1-e^{y}\right)}{y}
\]

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula 
\begin{align*}
\int d\nu\ \chi''\left(\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\left[n_{F}\left(\omega_{0}-\nu\right)+n_{F}\left(\nu+\omega_{0}\right)\right]\\
\int d\nu\ \chi''\left(\nu\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\left[n_{F}\left(\nu-\omega+\omega_{0}\right)+n_{F}\left(\omega-\nu+\omega_{0}\right)\right]\\
\int d\nu\ \chi''\left(\nu\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\left[n_{F}\left(\omega_{0}-\omega+\nu\right)+n_{F}\left(\omega_{0}+\omega-\nu\right)\right]\\
\frac{\kappa}{\beta J}\int_{-\alpha\pi\beta J}^{\alpha\pi\beta J}d\nu\ \nu\left[\frac{1}{e^{\nu}-1}+\frac{1}{e^{\nu-\beta\omega}+1}\right]\left[\frac{1}{e^{\beta\left(\omega_{0}-\omega\right)+\nu}+1}+\frac{1}{e^{\beta\left(\omega_{0}+\omega\right)-\nu}+1}\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The relevant integrals are 
\begin_inset Formula 
