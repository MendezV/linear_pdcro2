\begin{align*}
\alpha_{\boldsymbol{k}}^{2}F_{ME}\left(\omega,\epsilon,\nu\right) & =\frac{1}{\pi^{3}}\frac{1}{N^{2}}\sum_{\ell}\sum_{\boldsymbol{q}\boldsymbol{p}}\left|\lambda_{\ell}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\left(A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon+\nu\right)+A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon-\nu\right)\right)B^{-}\left(\boldsymbol{q},\epsilon\right)\\
 & =\frac{1}{\pi^{3}}\frac{1}{N}\sum_{\ell}\sum_{\boldsymbol{q}}\left|\lambda_{\ell}\left(\boldsymbol{q},\boldsymbol{k}\right)\right|^{2}\chi''\left(\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\left(A\left(\boldsymbol{q},\epsilon+\nu\right)+A\left(\boldsymbol{q},\epsilon-\nu\right)\right)B^{-}\left(\epsilon\right)
