\begin_inset Formula 
\begin{align*}
\frac{e^{2}\kappa\alpha}{\tau}\left(\frac{4g^{2}}{U}\right)^{2}\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{3}}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\sin\left(p_{z}+2q_{z}\right)^{2}\delta\left(\xi_{\bm{p}}\right)\left(\frac{1}{\left(\bm{q}\cdot\boldsymbol{v}_{F}\left(\boldsymbol{p}\right)\right)^{2}+\left(1/\tau\right)^{2}}\right)\\
\frac{e^{2}\kappa\alpha}{\tau}\left(\frac{4g^{2}}{U}\right)^{2}\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{2}}\frac{dp_{z}}{\left(2\pi\right)}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\sin\left(p_{z}+2q_{z}\right)^{2}\delta\left(\xi_{\bm{p}}\right)\left(\frac{1}{\left(\bm{q}\cdot\boldsymbol{v}_{F}\left(\boldsymbol{p}\right)\right)^{2}+\left(1/\tau\right)^{2}}\right)\\
\frac{e^{2}\kappa\alpha}{\tau}\left(\frac{4g^{2}}{U}\right)^{2}\frac{1}{4\pi}\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{2}}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\delta\left(\xi_{\bm{p}}\right)\left(\frac{1}{\left(\bm{q}\cdot\boldsymbol{v}_{F}\left(\boldsymbol{p}\right)\right)^{2}+\left(1/\tau\right)^{2}}\right)\\
e^{2}\tau\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\frac{m}{4\pi}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\int\frac{d\theta}{\left(2\pi\right)^{2}}\left(\frac{1}{\left(q_{xy}\tau v_{f}\cos\theta\right)^{2}+1}\right)\\
\sim e^{2}\tau\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\frac{m}{4\pi}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\int\frac{d\theta}{\left(2\pi\right)^{2}}\\
e^{2}\tau\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\frac{m}{8\pi^{2}}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\\
e^{2}\tau\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\frac{m}{8\pi^{2}}\\
\sim\lambda_{K}\frac{ne^{2}\tau}{m}\\
\\
\end{align*}

