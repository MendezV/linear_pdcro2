}
}\left(X_{i}\left(\boldsymbol{q}'\right)+X_{k}\left(\boldsymbol{q}'\right)\right)e^{-i\bm{q}\bm{R}_{j}+i\bm{k}\bm{R}_{i}-i\bm{k}'\bm{R}_{k}-i\bm{q}'\bm{R}_{j}}p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
 & =-\frac{\lambda K}{4N}\sum_{\bm{k}\bm{k}'\bm{q}\boldsymbol{q}'}\sum_{\substack{ik\\
\alpha\beta
}
}e^{i\bm{k}\bm{R}_{i}-i\bm{k}'\bm{R}_{k}}\delta\left(\boldsymbol{q}+\boldsymbol{q}'+\boldsymbol{k}'-\boldsymbol{k}\right)\left(X_{i}\left(\boldsymbol{q}'\right)+X_{k}\left(\boldsymbol{q}'\right)\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
 & =-\frac{\lambda K}{4N}\sum_{\bm{k}\bm{k}'\bm{q}\boldsymbol{q}'}\sum_{\substack{ik\\
\alpha\beta
}
}e^{-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{k}}\left(X_{i}\left(\boldsymbol{q}\right)+X_{k}\left(\boldsymbol{q}\right)\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}'}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}
\end{align*}

\end_inset


