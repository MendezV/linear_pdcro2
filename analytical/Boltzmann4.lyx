\begin_layout Standard
First we fourier transform the Hamiltonian using 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
p_{i\alpha}^{\dagger}=\frac{1}{\sqrt{N}}\sum_{\bm{k}}e^{i\bm{k}\bm{R}_{i}}p_{\boldsymbol{k}\alpha}^{\dagger}
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
\vec{S}_{j}=\frac{1}{\sqrt{N}}\sum_{\bm{q}}e^{-i\bm{q}\bm{R}_{j}}\vec{S}_{\boldsymbol{q}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
For the first term in the interaction Hamiltonian, we have 
\begin_inset Formula 
\[
H_{\text{int}}=H_{\text{int}}^{I}+H_{\text{int}}^{II}
\]

\end_inset


\end_layout

\begin_layout Standard
where we have:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
H_{\text{int}}^{I} & =\frac{1}{N^{3/2}}\frac{4g^{2}}{U}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{\substack{\langle i,j,k\rangle\\
\alpha\beta
}
}e^{-i\bm{q}\bm{R}_{j}+i\bm{k}\left(\bm{R}_{j}+\bm{R}_{i}\right)-i\bm{k}'\left(\bm{R}_{j}+\bm{R}_{k}\right)}p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
 & =\frac{1}{\sqrt{N}}\frac{4g^{2}}{U}\sum_{ik}\sum_{\substack{\bm{k}\bm{k}'\bm{q}\\
\alpha\beta
}
}\delta\left(\boldsymbol{q}+\boldsymbol{k}'-\boldsymbol{k}\right)e^{-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{k}}p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
 & =\frac{1}{\sqrt{N}}K\sum_{\substack{\bm{k}\bm{k}'\bm{q}\\
\alpha\beta
}
}\delta\left(\boldsymbol{q}+\boldsymbol{k}-\boldsymbol{k}'\right)\cos k_{z}\cos k_{z}'p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula 
\[
K=16\frac{g^{2}}{U}
\]

\end_inset


\end_layout

