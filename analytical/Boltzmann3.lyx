\frac{1}{\tau\left(\boldsymbol{k}\right)} & =k_{b}T\lambda^{2}\sum_{\bm{k}'\bm{q}}\frac{\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}\chi''\left(\bm{q},-\epsilon_{\boldsymbol{k}'}\right)\left[n_{f}\left(-\epsilon_{\boldsymbol{k}'}\right)+n_{b}\left(-\epsilon_{\boldsymbol{k}'}\right)\right]\\
 & =k_{b}T\lambda^{2}\int\frac{d\epsilon}{2\pi}\sum_{\bm{k}'\bm{q}}\frac{\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}A_{\text{Pd}}\left(\boldsymbol{k}',\epsilon\right)\chi''\left(\bm{q},\epsilon\right)\left[n_{f}\left(\epsilon\right)+n_{b}\left(\epsilon\right)\right]\\
 & k_{b}T\lambda^{2}\int\frac{d\epsilon}{2\pi}\sum_{\bm{k}'\bm{q}}\frac{\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}A_{\text{Pd}}\left(\boldsymbol{k}',\epsilon\right)\kappa\frac{\beta\epsilon}{J}\theta\left(J-\left|\epsilon\right|\right)\text{csch}\left(\beta\epsilon\right)\\
 & \kappa\frac{k_{b}T}{J}\lambda^{2}\int\frac{d\epsilon}{2\pi}\sum_{\bm{k}'\bm{q}}\frac{\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}A_{\text{Pd}}\left(\boldsymbol{k}',\epsilon\right)\theta\left(J-\left|\epsilon\right|\right)
