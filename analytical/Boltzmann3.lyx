-\frac{2\pi}{\hbar^{2}}\sum_{\bm{k}'\boldsymbol{q}}\frac{\hbar}{2m\omega}g^{2}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}\left(\left(1+n_{\boldsymbol{q}}\right)\left(1-f_{\boldsymbol{k}}\right)f_{\boldsymbol{k}'}\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)+n_{\boldsymbol{q}}\left(1-f_{\boldsymbol{k}}\right)f_{\boldsymbol{k}'}\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)
