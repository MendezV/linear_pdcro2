 & -\frac{1}{M\omega_{0}}2\pi\sum_{\bm{k}'}M\left(\bm{k},\bm{k}'\right)A_{\text{Pd}}\left(\bm{k}',\epsilon_{1}+\omega_{0}\right)\left(n_{B}\left(-\omega_{0}\right)+n_{F}\left(-\omega_{0}-\epsilon_{1}\right)\right)\\
\\
 & \sim\frac{1}{M\omega_{0}}2\pi\sum_{\bm{k}'}M\left(\bm{k},\bm{k}'\right)A_{\text{Pd}}\left(\bm{k}',\epsilon_{1}\right)\left(n_{B}\left(\omega_{0}\right)+n_{F}\left(\omega_{0}-\epsilon_{1}\right)-n_{B}\left(-\omega_{0}\right)-n_{F}\left(-\omega_{0}-\epsilon_{1}\right)\right)\\
