backgroundcolor "none"
status open

\begin_layout Plain Layout
\begin_inset Formula 
\begin{equation}
\sigma_{\perp}^{2}=e^{2}\sum_{\bm{k}}\int\frac{d\epsilon_{1}}{2\pi}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)A_{\perp,2}\left(\boldsymbol{k},\epsilon_{1}\right)\left(-\frac{\partial n_{f}}{\partial\epsilon_{1}}\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Plain Layout
with 
\begin_inset Formula 
\begin{align}
A_{\perp,2}\left(\boldsymbol{k},\epsilon_{1}\right) & =\sum_{\bm{q}\bm{k}'}\frac{\hbar\lambda^{2}}{2M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}}\Gamma^{II}\left(\bm{k},\bm{k}'\right)\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}',\epsilon_{2}\right)\left[n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)+n_{F}\left(-\epsilon_{2}\right)\right]\\
 & \times\left\{ \left[1+n_{b}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{b}\left(\epsilon_{1}-\epsilon_{2}-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)\right]\chi''\left(\bm{q},\epsilon_{1}-\epsilon_{2}-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)\right.\\
 & +\left.\left[1+n_{b}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{b}\left(\epsilon_{2}-\epsilon_{1}-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)\right]\chi''\left(\bm{q},\epsilon_{2}-\epsilon_{1}-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)\right\} 
\end{align}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
here the first two lines in the rate 
\series bold

\begin_inset Formula $\gamma$
\end_inset


\series default
 corresponds to emission of a phonon and the second two lines corresponds
 to absorption.
 
\end_layout

\begin_layout Section
Self energy
\end_layout

\begin_layout Standard
The self energy in the RPA approximation has the following self consistent
 equation
\begin_inset Formula 
\begin{align*}
\Sigma\left(\boldsymbol{k},i\omega_{n}\right) & =\sum_{\bm{k}'}\int_{0}^{\beta}d\tau e^{i\omega_{n}\tau}\left[\left\langle \left\langle \overline{U_{\boldsymbol{k}\boldsymbol{k}'}^{\alpha\beta}\left(\tau\right)}U_{\boldsymbol{k}\boldsymbol{k}'}^{\alpha\beta}\left(0\right)\right\rangle \right\rangle +\left\langle \left\langle \overline{W_{\boldsymbol{k}\boldsymbol{k}'}^{\alpha\beta}\left(\tau\right)}W_{\boldsymbol{k}\boldsymbol{k}'}^{\alpha\beta}\left(0\right)\right\rangle \right\rangle \right]\mathcal{G}\left(\boldsymbol{k}',\tau\right)\\
 & =\frac{1}{\beta}\sum_{\bm{k}'}\sum_{i\nu_{n}}\left[\Lambda_{I}\left(\boldsymbol{k},\boldsymbol{k}'\right)S\left(\boldsymbol{k}-\boldsymbol{k}',i\omega_{n}-i\nu_{n}\right)+\lambda^{2}\frac{1}{\beta}\sum_{\bm{q}}\sum_{i\mu_{n}}\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)\frac{1}{M}\frac{1}{\left(i\omega_{n}-i\nu_{n}-i\mu_{n}\right)^{2}-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}S\left(\boldsymbol{q},i\mu_{n}\right)\right]\\
 & \times\mathcal{G}\left(\boldsymbol{k}',i\nu_{n}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where the form factors are again:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\Lambda_{I}\left(\boldsymbol{k},\boldsymbol{k}'\right)=\frac{1}{N}\sum_{iki'k'}g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)\overline{g_{i'k'}}\left(\boldsymbol{k},\boldsymbol{k}'\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)=\frac{1}{N}\sum_{iki'k'}g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)\overline{g_{i'k'}}\left(\boldsymbol{k},\boldsymbol{k}'\right)\left(\delta_{ii'}+\delta_{ik'}+\delta_{ki'}+\delta_{kk'}\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Simplifying the self energy in the limit where 
\begin_inset Formula $T\gg\omega_{D},$
\end_inset

we have
\begin_inset Formula 
\begin{align*}
\Sigma\left(\boldsymbol{k},i\omega_{n}\right) & =\frac{\lambda^{2}}{\beta^{2}}\sum_{\bm{k}'\bm{q}}\sum_{i\nu_{n}}\left[\frac{\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}S\left(\boldsymbol{q},i\omega_{n}-i\nu_{n}\right)\right]\mathcal{G}\left(\boldsymbol{k}',i\nu_{n}\right)\\
 & =\frac{\lambda^{2}}{\beta^{2}}\sum_{\bm{k}'\bm{q}}\sum_{i\nu_{n}}\left[\frac{\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}\int\frac{d\nu}{\pi}\frac{-\chi''\left(\bm{q},\nu\right)}{i\omega_{n}-i\nu_{n}-\nu}\right]\mathcal{G}\left(\boldsymbol{k}',i\nu_{n}\right)\\
 & =\frac{\lambda^{2}}{\beta}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{2\pi}\sum_{\bm{k}'\bm{q}}\left[\frac{\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}\chi''\left(\bm{q},\nu\right)A_{\text{Pd}}\left(\boldsymbol{k}',\epsilon\right)\right]\frac{1}{\beta}\sum_{i\nu_{n}}\frac{-1}{i\omega_{n}-i\nu_{n}-\nu}\frac{1}{i\nu_{n}-\epsilon}\\
 & =\frac{\lambda^{2}}{\beta}\int\frac{d\nu d\epsilon}{2\pi^{2}}\sum_{\bm{k}'\bm{q}}\frac{\Lambda_{II}\left(\boldsymbol{k},\boldsymbol{k}'\right)}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}^{2}}\chi''\left(\bm{q},\nu\right)A_{\text{Pd}}\left(\boldsymbol{k}',\epsilon\right)\left[-\frac{n_{f}\left(\epsilon\right)+n_{b}\left(-\nu\right)}{i\omega_{n}-\nu-\epsilon}\right]
\end{align*}

\end_inset


\end_layout

