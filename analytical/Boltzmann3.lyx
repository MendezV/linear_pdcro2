 & =\sum_{\bm{k}'}\Gamma^{I}\left(\bm{k},\bm{k}'\right)\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}',\epsilon_{2}\right)\theta\left(J-\left|\epsilon_{1}-\epsilon_{2}\right|\right)\left(\frac{-\epsilon_{2}+\epsilon_{1}-\epsilon_{2}}{-\epsilon_{2}}\right)\\
 & =\sum_{\bm{k}'}\Gamma^{I}\left(\bm{k},\bm{k}'\right)\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}',\epsilon_{2}\right)\theta\left(J-\left|\epsilon_{1}-\epsilon_{2}\right|\right)\left(\frac{2\epsilon_{2}-\epsilon_{1}}{\epsilon_{2}}\right)
