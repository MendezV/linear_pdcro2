\begin_layout Section
Simple electron phonon: scattering rate
\end_layout

\begin_layout Standard
For the self energy of the electron phonon interaction consider the following
 model with a single phonon mode 
\begin_inset Formula 
\begin{align*}
V & =\sum_{i}gx_{i}n_{i}\\
 & =\sum_{\boldsymbol{k}\boldsymbol{q}}gx_{\boldsymbol{q}}c_{\boldsymbol{k}+\boldsymbol{q}}^{\dagger}c_{\boldsymbol{k}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where the phonon operator is given by 
\begin_inset Formula 
\[
x_{\boldsymbol{k}}\left(t\right)=\sqrt{\frac{\hbar}{2m\omega}}\left(a_{\boldsymbol{k}}e^{i\omega_{\boldsymbol{k}}t}+a_{-\boldsymbol{k}}^{\dagger}e^{-i\omega_{\boldsymbol{k}}t}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
we want to use Fermi's golden rule to calculate the scattering rate of a
 quasiparticle with momentum 
\begin_inset Formula $\boldsymbol{k}$
\end_inset

 into a quasiparticle with momentum 
\begin_inset Formula $\boldsymbol{k}'$
\end_inset

 and a phonon with momentum 
\begin_inset Formula $\boldsymbol{q}$
\end_inset

.
 As such we calculate the matrix element
\begin_inset Formula 
\begin{align*}
\langle\boldsymbol{k}'|V\left(t\right)|\boldsymbol{k}\rangle & =\langle\boldsymbol{k}'|\sum_{\tilde{\boldsymbol{k}}\tilde{\boldsymbol{q}}}gx_{\tilde{\boldsymbol{q}}}\left(t\right)c_{\tilde{\boldsymbol{k}}+\tilde{\boldsymbol{q}}}^{\dagger}c_{\tilde{\boldsymbol{k}}}|\boldsymbol{k}\rangle\\
 & =\sum_{\tilde{\boldsymbol{k}}\tilde{\boldsymbol{q}}}gx_{\tilde{\boldsymbol{q}}}\left(t\right)\langle c_{\boldsymbol{k}'}c_{\tilde{\boldsymbol{k}}+\tilde{\boldsymbol{q}}}^{\dagger}c_{\tilde{\boldsymbol{k}}}c_{\boldsymbol{k}}^{\dagger}\rangle\\
 & =\sum_{\tilde{\boldsymbol{k}}\tilde{\boldsymbol{q}}}gx_{\tilde{\boldsymbol{q}}}\left(t\right)\left(\sqrt{\left(1-f_{\boldsymbol{k}}\right)f_{\boldsymbol{k}'}}\delta_{\tilde{\boldsymbol{k}}+\tilde{\boldsymbol{q}},\boldsymbol{k}'}\delta_{\boldsymbol{k},\tilde{\boldsymbol{k}}}-\delta_{\tilde{\boldsymbol{k}}+\tilde{\boldsymbol{q}},\tilde{\boldsymbol{k}}}\delta_{\boldsymbol{k},\boldsymbol{k'}}\right)\\
 & =\sum_{\tilde{\boldsymbol{q}}}gx_{\tilde{\boldsymbol{q}}}\left(t\right)\delta_{\boldsymbol{k}+\tilde{\boldsymbol{q}},\boldsymbol{k}'}-\delta_{\boldsymbol{k},\boldsymbol{k'}}g\sum_{\tilde{\boldsymbol{q}}}x_{\tilde{\boldsymbol{q}}}\left(t\right)\\
 & =gx_{\boldsymbol{k}'-\boldsymbol{k}}\left(t\right)-g\delta_{\boldsymbol{k},\boldsymbol{k'}}\sum_{\tilde{\boldsymbol{q}}}x_{\tilde{\boldsymbol{q}}}\left(t\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
then we have the formal relation from time dependent perturbation theory
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
c_{\boldsymbol{k}'}^{\left(1\right)}\left(t\right) & =\frac{-i}{\hbar}\int_{-\infty}^{t}dt'\langle\boldsymbol{k}'|V\left(t'\right)|\boldsymbol{k}\rangle e^{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}\right)t'}\\
 & \supset\frac{-i}{\hbar}\sqrt{\frac{\hbar}{2m\omega}}g\int_{-\infty}^{t}dt'e^{\delta t'}\left(a_{\boldsymbol{k}'-\boldsymbol{k}}e^{i\omega_{\boldsymbol{k}'-\boldsymbol{k}}t'}+a_{-\left(\boldsymbol{k}'-\boldsymbol{k}\right)}^{\dagger}e^{-i\omega_{\boldsymbol{k}'-\boldsymbol{k}}t'}\right)e^{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}\right)t'}\\
 & =\frac{-i}{\hbar}\sqrt{\frac{\hbar}{2m\omega}}g\int_{-\infty}^{t}dt'\ e^{\delta t'}\left(a_{\boldsymbol{k}'-\boldsymbol{k}}e^{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)t'}+a_{-\left(\boldsymbol{k}'-\boldsymbol{k}\right)}^{\dagger}e^{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)t'}\right)\\
 & =\frac{-i}{\hbar}\sqrt{\frac{\hbar}{2m\omega}}ge^{\delta t}\left(\frac{a_{\boldsymbol{k}'-\boldsymbol{k}}e^{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)t}}{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)+\delta}+\frac{a_{-\left(\boldsymbol{k}'-\boldsymbol{k}\right)}^{\dagger}e^{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)t}}{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)+\delta}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Taking expectation values with respect to the phonon subsystem, we have
\begin_inset Formula 
\[
A_{\boldsymbol{k}'}^{\left(1\right)}\left(t\right)=\frac{-i}{\hbar}\sqrt{\frac{\hbar}{2m\omega}}ge^{\delta t}\left(\frac{\sqrt{n_{\boldsymbol{k}'-\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}}e^{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)t}}{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)+\delta}+\frac{\sqrt{\left(1+n_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}}e^{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)t}}{i\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)+\delta}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
The probability for transitioning into a state with a quasiparticle with
 momentum 
\begin_inset Formula $\boldsymbol{k}'$
\end_inset

 is then 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}'}^{\left(1\right)}\left(t\right)\supset\frac{1}{\hbar^{2}}\frac{\hbar}{2m\omega}g^{2}e^{2\delta t}\left(\frac{n_{\boldsymbol{k}'-\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}}{\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)^{2}+\delta^{2}}+\frac{\left(1+n_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}}{\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)^{2}+\delta^{2}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
taking the time derivative to calculate the rate 
\begin_inset Formula 
\[
\tilde{P}_{\boldsymbol{k}'}^{\left(1\right)}\left(t\right)=\frac{1}{\hbar^{2}}\frac{\hbar}{2m\omega}g^{2}\left(n_{\boldsymbol{k}'-\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}\frac{2\delta e^{2\delta t}}{\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)^{2}+\delta^{2}}+\left(1+n_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}\frac{2\delta e^{2\delta t}}{\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)^{2}+\delta^{2}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
taking the limit 
\begin_inset Formula $\delta\rightarrow0$
\end_inset

 and calculating the total transition rate out of the state with momentum
 
\begin_inset Formula $\boldsymbol{k}$
\end_inset

 , we have 
\begin_inset Formula 
\begin{align*}
\Gamma_{\bm{k}} & =\frac{2\pi}{\hbar^{2}}\sum_{\bm{k}'}\frac{\hbar}{2m\omega}g^{2}\left(n_{\boldsymbol{k}'-\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)+\left(1+n_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{k}'-\boldsymbol{k}}\right)\right)\\
 & =\frac{2\pi}{\hbar^{2}}\sum_{\bm{k}'\boldsymbol{q}}\frac{\hbar}{2m\omega}g^{2}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}\left(n_{\boldsymbol{q}}\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)+\left(1+n_{\boldsymbol{q}}\right)\left(1-f_{\boldsymbol{k}'}\right)f_{\boldsymbol{k}}\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
the first term corresponds to absorption and the second to emission.
 The question now is whether we can simplify 
\begin_inset Formula 
\[
\left(1+n_{\boldsymbol{q}}\right)\left(1-f_{\boldsymbol{k}'}\right)=?\ 1+n_{\boldsymbol{q}}-f_{\boldsymbol{k}'}
\]

\end_inset


\begin_inset Formula 
\[
\left(1+n_{\boldsymbol{q}}\right)\left(1-f_{\boldsymbol{k}'}\right)=1+n_{\boldsymbol{q}}-f_{\boldsymbol{k}'}-f_{\boldsymbol{k}'}n_{\boldsymbol{q}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
n_{\boldsymbol{q}}\left(1-f_{\boldsymbol{k}'}\right) & =n_{\boldsymbol{q}}-n_{\boldsymbol{q}}f_{\boldsymbol{k}'}\\
 & =n_{\boldsymbol{q}}+f_{\boldsymbol{k}'}-\left(1+n_{\boldsymbol{q}}\right)f_{\boldsymbol{k}'}
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
= & \frac{2\pi}{\hbar^{2}}f_{\boldsymbol{k}}\sum_{\bm{k}'\boldsymbol{q}}\frac{\hbar}{2m\omega}g^{2}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}\left(\left(n_{\boldsymbol{q}}+f_{\boldsymbol{k}'}\right)\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)+\left(1+n_{\boldsymbol{q}}-f_{\boldsymbol{k}'}\right)\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)\\
 & -\frac{2\pi}{\hbar^{2}}f_{\boldsymbol{k}}\sum_{\bm{k}'\boldsymbol{q}}\frac{\hbar}{2m\omega}g^{2}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}f_{\boldsymbol{k}'}\left(\left(1+n_{\boldsymbol{q}}\right)\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)+n_{\boldsymbol{q}}\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Focusing only on the last term
\begin_inset Formula 
\begin{align*}
-\frac{2\pi}{\hbar^{2}}f_{\boldsymbol{k}}\sum_{\bm{k}'\boldsymbol{q}}\frac{\hbar}{2m\omega}g^{2}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}f_{\boldsymbol{k}'}\left(\left(1+n_{\boldsymbol{q}}\right)\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)+n_{\boldsymbol{q}}\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)\\
=-\frac{2\pi}{\hbar^{2}}f_{\boldsymbol{k}}\sum_{\bm{k}'\boldsymbol{q}}\frac{\hbar}{2m\omega}g^{2}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}f_{\boldsymbol{k}'}\left(\left(1+n\left(\varepsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\right)\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)+n\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}\right)\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)\\
=-\frac{2\pi}{\hbar^{2}}f_{\boldsymbol{k}}\sum_{\bm{k}'\boldsymbol{q}}\frac{\hbar}{2m\omega}g^{2}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}f_{\boldsymbol{k}'}\left(\left(1+n\left(\varepsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\right)\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)-\left(1+n\left(\varepsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\right)\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)\\
=-\frac{2\pi}{\hbar^{2}}f_{\boldsymbol{k}}\sum_{\bm{k}'\boldsymbol{q}}\frac{\hbar}{2m\omega}g^{2}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}f_{\boldsymbol{k}'}\left(1+n\left(\varepsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\right)\left(\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)-\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)\\
=-\frac{2\pi}{\hbar^{2}}\frac{\hbar}{2m\omega}g^{2}\sum_{\bm{k}'}f_{\boldsymbol{k}}f_{\boldsymbol{k}'}\left(1+n\left(\varepsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\right)\sum_{\boldsymbol{q}}\delta_{\boldsymbol{k}',\boldsymbol{q}+\boldsymbol{k}}\left(\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}+\omega_{\boldsymbol{q}}\right)-\delta\left(\varepsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}-\omega_{\boldsymbol{q}}\right)\right)
\end{align*}

\end_inset


\end_layout

