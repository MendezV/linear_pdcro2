\begin_layout Standard
introducing the function we calculated above, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tau_{tr}^{-1} & =\frac{8\pi\lambda_{A}}{\hbar\beta}\int_{0}^{\omega_{D}}d\nu\ \frac{1}{\nu}\frac{\left(\frac{\nu}{\omega_{D}}\right)^{3}}{\sqrt{1-\left(\frac{\nu}{\omega_{D}}\right)^{2}}}\left[\frac{\beta\nu}{2}\text{csch}\left(\frac{\beta\nu}{2}\right)\right]^{2}\\
 & =\frac{8\pi\lambda_{A}}{\hbar\beta}\frac{8}{\beta^{3}}\int_{0}^{\omega_{D}}\frac{\beta}{2}d\nu\ \frac{2}{\beta\nu}\frac{\left(\frac{\beta\nu}{2\omega_{D}}\right)^{3}}{\sqrt{1-\left(\frac{2}{\beta}\right)^{2}\left(\frac{\beta\nu}{2\omega_{D}}\right)^{2}}}\left[\frac{\beta\nu}{2}\text{csch}\left(\frac{\beta\nu}{2}\right)\right]^{2}\\
 & =\frac{8\pi\lambda_{A}}{\hbar\beta}\frac{8}{\beta^{3}}\int_{0}^{\omega_{D}}\frac{\beta}{2}d\nu\ \frac{\beta\nu}{2}\frac{\left(\frac{\beta\nu}{2\omega_{D}}\right)^{3}}{\sqrt{1-\left(\frac{2}{\beta}\right)^{2}\left(\frac{\beta\nu}{2\omega_{D}}\right)^{2}}}\left[\text{csch}\left(\frac{\beta\nu}{2}\right)\right]^{2}\\
 & =\frac{8\pi\lambda_{A}}{\hbar\beta}\frac{8}{\beta^{3}}\int_{0}^{\frac{\beta\omega_{D}}{2}}dx\ x\frac{\left(\frac{x}{\omega_{D}}\right)^{3}}{\sqrt{1-\left(\frac{2}{\beta}\right)^{2}\left(\frac{x}{\omega_{D}}\right)^{2}}}\left[\text{csch}\left(x\right)\right]^{2}\\
 & =\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{2}{\beta\omega_{D}}\right)^{3}\int_{0}^{\frac{\beta\omega_{D}}{2}}dx\ \frac{x^{4}}{\sqrt{1-\left(\frac{2}{\beta\omega_{D}}\right)^{2}x^{2}}}\left[\text{csch}\left(x\right)\right]^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We have that as 
\series bold

\begin_inset Formula $\beta\omega_{D}\rightarrow\infty$
\end_inset

 
\series default
we have
\series bold
 
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{2}{\beta\omega_{D}}\right)^{3}\int_{0}^{\infty}dx\ x^{4}\left[\text{csch}\left(x\right)\right]^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
so that 
\begin_inset Formula 
\[
\tau_{tr}^{-1}\sim T^{4}
\]

\end_inset


\end_layout

\begin_layout Standard
If we take the opposite limit, we have again
\begin_inset Formula 
\[
\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{2}{\beta\omega_{D}}\right)^{3}\int_{0}^{\frac{\beta\omega_{D}}{2}}dx\ \frac{x^{4}}{\sqrt{1-\left(\frac{2}{\beta\omega_{D}}\right)^{2}x^{2}}}\left[\text{csch}\left(x\right)\right]^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
If we change variables
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{\beta\omega_{D}}{2}\right)^{2}\int_{0}^{1}dx\ \frac{x^{4}}{\sqrt{1-x^{2}}}\left[\text{csch}\left(\frac{\beta\omega_{D}}{2}x\right)\right]^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
in the limit where 
\begin_inset Formula $\beta\rightarrow0$
\end_inset

 we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{\beta\omega_{D}}{2}\right)^{2}\int_{0}^{1}dx\ \frac{x^{4}}{\sqrt{1-x^{2}}}\frac{1}{\left[\frac{\beta\omega_{D}}{2}x\right]^{2}}\\
=\frac{8\pi\lambda_{A}}{\hbar\beta}\int_{0}^{1}dx\ \frac{x^{2}}{\sqrt{1-x^{2}}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula 
\[
\int_{0}^{1}dx\ \frac{x^{2}}{\sqrt{1-x^{2}}}=\frac{\pi}{4}
\]

\end_inset


\end_layout

\begin_layout Standard
so overall this behaves as a constant at high temperature, giving rise to
 a T-linear behavior with 
\begin_inset Formula 
\[
\tau_{tr}^{-1}\sim T
\]

\end_inset


\end_layout

\begin_layout Subsection*
Acoustic phonon dimensionless coupling
\end_layout

\begin_layout Standard
First we verify 
\begin_inset Formula 
\[
\lambda_{A}=\frac{2^{D-1}}{2\pi D}\frac{\alpha^{2}\nu_{0}}{Mc^{2}}\frac{\overline{S_{D-1}}}{\overline{S_{D}}}
\]

\end_inset


\end_layout

\begin_layout Standard
With 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{1}{\left(2\pi\right)^{D}}\frac{2\pi^{\frac{D}{2}}}{\Gamma\left(\frac{D}{2}\right)}=\bar{S}_{D}
\]

\end_inset


\end_layout

\begin_layout Standard
so we have 
\begin_inset Formula 
\begin{align*}
\frac{\overline{S_{D-1}}}{\overline{S_{D}}} & =\frac{\frac{1}{\left(2\pi\right)^{D-1}}\frac{2\pi^{\frac{D-1}{2}}}{\Gamma\left(\frac{D-1}{2}\right)}}{\frac{1}{\left(2\pi\right)^{D}}\frac{2\pi^{\frac{D}{2}}}{\Gamma\left(\frac{D}{2}\right)}}\\
 & =\left(2\pi\right)\frac{1}{\sqrt{\pi}}\frac{\Gamma\left(\frac{D}{2}\right)}{\Gamma\left(\frac{D-1}{2}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
For 
\begin_inset Formula $D=2$
\end_inset

 we have 
\begin_inset Formula 
\begin{align*}
\left(2\pi\right)\frac{1}{\sqrt{\pi}}\frac{\Gamma\left(1\right)}{\Gamma\left(\frac{1}{2}\right)} & =4\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
so we have 
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{2}{4\pi}\frac{\alpha^{2}\nu_{0}}{Mc^{2}}4\\
 & =\frac{2}{\pi}\frac{\alpha^{2}\nu_{0}}{Mc^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
comparing, we found before 
\begin_inset Formula 
\[
\lambda_{A}=\frac{1}{\pi}\frac{\alpha^{2}\nu_{0}}{Mc^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
the extra factor of 2 comes from the fact that the 
\begin_inset Formula $D$
\end_inset

-dim integration has the range 
\begin_inset Formula $[0,\pi]$
\end_inset

 while the 2-dim integration has the range 
\begin_inset Formula $[0,2\pi]$
\end_inset

.
\end_layout

\begin_layout Standard
We calculate the coupling for 3d and then 2d explicitly to verify that we
 didn't miss anything
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{\sum_{\boldsymbol{k}\boldsymbol{k}'}\frac{2}{\omega_{\boldsymbol{k}-\boldsymbol{k}'}}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(v_{\boldsymbol{k}x}-v_{\boldsymbol{k}'x}\right)^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{k}'}\right)}{\sum_{\boldsymbol{k}}2v_{\boldsymbol{k}z}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We have then
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{\sum_{\boldsymbol{k}\boldsymbol{k}'}\frac{2}{\omega_{\boldsymbol{k}-\boldsymbol{k}'}}\frac{\alpha^{2}\left(\boldsymbol{k}-\boldsymbol{k}'\right)^{2}}{M\omega_{\boldsymbol{k}-\boldsymbol{k}'}}\left(v_{\boldsymbol{k}x}-v_{\boldsymbol{k}'x}\right)^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{k}'}\right)}{\sum_{\boldsymbol{k}}2v_{\boldsymbol{k}z}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Cancelling the twos
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{\alpha^{2}}{Mc^{2}}\frac{\sum_{\boldsymbol{k}\boldsymbol{k}'}\left(v_{\boldsymbol{k}x}-v_{\boldsymbol{k}'x}\right)^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{k}'}\right)}{\sum_{\boldsymbol{k}}v_{\boldsymbol{k}z}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
then we have
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}\frac{1}{v_{F}^{2}m^{2}}\frac{1}{\nu_{0}}\sum_{\boldsymbol{k}\boldsymbol{q}}q^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{k}+\boldsymbol{q}}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
converting to integrals
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}\frac{1}{v_{F}^{2}m^{2}}\frac{1}{\nu_{0}}\int\frac{q^{D-1}dqd\Omega_{q}}{\left(2\pi\right)^{D}}\frac{k^{D-1}dkd\Omega_{k}}{\left(2\pi\right)^{D}}q^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{k}+\boldsymbol{q}}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Then we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}\frac{1}{v_{F}^{2}m^{2}}\int\frac{q^{D+1}dqd\Omega_{q}}{\left(2\pi\right)^{D}}\delta\left(\epsilon_{\boldsymbol{k}+\boldsymbol{q}}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
then, expanding the delta function
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}\frac{1}{v_{F}^{2}m^{2}}\int\frac{q^{D+1}dqd\Omega_{q}}{\left(2\pi\right)^{D}}\delta\left(\frac{k_{F}^{2}+q^{2}-2qk\cos\theta-k_{F}^{2}}{2m}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
simplifying a bit
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}\frac{1}{v_{F}^{2}m^{2}}\frac{2m}{2k_{F}}\int q^{D}\frac{dqd\Omega_{q}}{\left(2\pi\right)^{D}}\delta\left(\frac{q}{2k_{F}}-\cos\theta\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Performing the angular integration in 
\begin_inset Formula $D>2$
\end_inset

, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}\frac{1}{v_{F}^{2}m^{2}}\frac{2m}{2k_{F}}\overline{S_{D-1}}\frac{1}{2\pi}\ \int q^{D}dq\ \theta\left(1-\frac{q}{2k_{F}}\right)\left(1-\left(\frac{q}{2k_{F}}\right)^{2}\right)^{\frac{D-3}{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Then changing variables we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}\frac{1}{v_{F}^{2}m^{2}}\frac{2m}{2k_{F}}\overline{S_{D-1}}\frac{\left(2k_{F}\right)^{D+1}}{2\pi}\ \int_{0}^{1}dx\ x^{D}\left(1-x^{2}\right)^{\frac{D-3}{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Simplifying a bit
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{A} & =\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}m\frac{1}{k_{F}^{3}}\overline{S_{D-1}}\frac{\left(2k_{F}\right)^{D+1}}{2\pi}\ \int_{0}^{1}dx\ x^{D}\left(1-x^{2}\right)^{\frac{D-3}{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Then we have 
\begin_inset Formula 
\[
\lambda_{A}=\frac{1}{D}2^{D}\frac{\alpha^{2}}{Mc^{2}}\overline{S_{D-1}}\frac{mk_{F}^{D-2}}{2\pi}\ \int_{0}^{1}dx\ x^{D}\left(1-x^{2}\right)^{\frac{D-3}{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Since we have 
\begin_inset Formula 
\[
\nu_{0}=\frac{mk_{F}^{D-2}}{\hbar^{D}}\bar{S}_{D}
\]

\end_inset


\end_layout

\begin_layout Standard
the dimensionless coupling 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lambda_{A}=\frac{1}{D}2^{D}\frac{\alpha^{2}}{Mc^{2}}\frac{\overline{S_{D-1}}}{\overline{S_{D}}}\frac{\nu_{0}}{2\pi}\ \int_{0}^{1}dx\ x^{D}\left(1-x^{2}\right)^{\frac{D-3}{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Performing the integral, we have 
\begin_inset Formula 
\[
\lambda_{A}=\frac{1}{D}2^{D}\frac{\alpha^{2}}{Mc^{2}}\frac{\overline{S_{D-1}}}{\overline{S_{D}}}\frac{\nu_{0}}{2\pi}\frac{\sqrt{\pi}2^{-D}\Gamma\left(\frac{D-1}{2}\right)}{\Gamma\left(\frac{D}{2}\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
which yields
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lambda_{A}=\frac{1}{D}2^{D}\frac{\alpha^{2}}{Mc^{2}}\frac{\overline{S_{D-1}}}{\overline{S_{D}}}\frac{\nu_{0}}{2\pi}\frac{\sqrt{\pi}2^{-D}\Gamma\left(\frac{D-1}{2}\right)}{\Gamma\left(\frac{D}{2}\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
using
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{1}{\left(2\pi\right)}\frac{\overline{S_{D-1}}}{\overline{S_{D}}} & =\frac{1}{\sqrt{\pi}}\frac{\Gamma\left(\frac{D}{2}\right)}{\Gamma\left(\frac{D-1}{2}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
we have 
\begin_inset Formula 
\[
\lambda_{A}=\frac{1}{D}\frac{\alpha^{2}}{Mc^{2}}\nu_{0}
\]

\end_inset


\end_layout

