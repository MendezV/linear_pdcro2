 & =\frac{1}{Dm^{2}\nu_{0}}\frac{\alpha^{2}}{Mc}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{D}}\frac{d\boldsymbol{k}}{\left(2\pi\right)^{D}}\frac{q^{3}}{2v_{F}^{2}}\delta\left(\epsilon_{\boldsymbol{k}+\boldsymbol{q}}\right)\delta\left(\frac{k^{2}-k_{F}^{2}}{2m}\right)\delta\left(\nu-cq\right)\\
 & =\frac{1}{Dm^{2}\nu_{0}}\frac{\alpha^{2}}{Mc}\int\frac{q^{D-1}dqd\Omega_{q}}{\left(2\pi\right)^{D}}\frac{k^{D-1}dkd\Omega_{k}}{\left(2\pi\right)^{D}}\frac{q^{3}}{2v_{F}^{2}}\delta\left(\epsilon_{\boldsymbol{k}+\boldsymbol{q}}\right)\delta\left(\frac{k^{2}-k_{F}^{2}}{2m}\right)\delta\left(\nu-cq\right)
