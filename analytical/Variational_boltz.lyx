\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=kT\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\epsilon_{\boldsymbol{k}}-\nu\right)\left[n_{B}\left(\epsilon_{\boldsymbol{k}}-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]
\]

\end_inset


