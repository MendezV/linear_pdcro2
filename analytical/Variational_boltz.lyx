\begin_layout Subsubsection*
Sum rule for the spin correlation function
\end_layout

\begin_layout Standard
Let's start with the value of the integral 
\begin_inset Formula 
\begin{align*}
\int S\left(\nu\right)d\nu=\int\frac{\chi''\left(\nu\right)}{\nu\beta} & =\frac{T\kappa}{TJ}\int_{-\alpha\pi J}^{\alpha\pi J}\frac{\nu d\nu}{\nu}\\
 & =\frac{\kappa}{J}2\alpha\pi J\\
 & =2\pi\alpha\kappa\\
 & =C
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Now we compare this with the sum rule In general, we have 
\begin_inset Formula 
\[
{\displaystyle C=\frac{\mu_{0}\mu_{{\rm {B}}}^{2}}{3k_{{\rm {B}}}}g^{2}J(J+1),}
\]

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula $J$
\end_inset

 being the angular momentum, 
\begin_inset Formula $g$
\end_inset

 the lande g-factor, 
\begin_inset Formula $\mu_{0}$
\end_inset

 the permeability of free space, 
\begin_inset Formula $\mu_{B}$
\end_inset

 the bohr magneton and 
\begin_inset Formula $k_{B}$
\end_inset

 the boltzmann constant.
 
\end_layout

\begin_layout Subsection*
Full resistivity calculation
\end_layout

\begin_layout Standard
Now that we have the transport time, the only missing part of the calculation
 is the mass tensor since the full expresion for the resistivity is given
 by 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho_{\text{trial}}=\frac{\tau_{\text{tr}}^{-1}}{e^{2}\left(\frac{n}{m}\right)_{zz}}
\]

\end_inset


\end_layout

\begin_layout Standard
The relevan calculation is then
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left(\frac{n}{m}\right)_{zz}=-\frac{1}{V}\sum_{\boldsymbol{q}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}v_{\boldsymbol{k}z}^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
at temperatures below the degeneracy temperature we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\left(\frac{n}{m}\right)_{zz} & =\frac{1}{a_{xy}^{2}a_{z}}\frac{1}{N}\sum_{\boldsymbol{q}}\delta\left(\epsilon_{\boldsymbol{k}}\right)v_{\boldsymbol{k}z}^{2}\\
 & =\frac{2\nu_{0}\left(\frac{2t_{\perp}a_{z}}{\hbar}\right)^{2}}{a_{xy}^{2}a_{z}}\\
 & =2\nu_{0}\left(\frac{2t_{\perp}}{\hbar}\right)^{2}\frac{a_{z}}{a_{xy}^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Putting things together 
\begin_inset Formula 
\begin{align*}
\frac{\tau_{tr}^{-1}}{e^{2}\left(\frac{n}{m}\right)_{zz}} & =\frac{\frac{2\pi\lambda_{E,tr}}{\hbar}k_{b}T}{2\nu_{0}\left(\frac{2t_{\perp}}{\hbar}\right)^{2}\frac{a_{z}}{a_{xy}^{2}}}\\
 & =\frac{\hbar}{e^{2}}\frac{a_{xy}^{2}}{a_{z}}\left[\frac{2\pi\lambda_{E,tr}k_{b}T}{2\nu_{0}\left(2t_{\perp}\right)^{2}}\right]\\
 & =\frac{\hbar}{e^{2}}\frac{a_{xy}^{2}}{a_{z}}\left[\frac{\pi\lambda_{E,tr}k_{b}T}{\nu_{0}\left(2t_{\perp}\right)^{2}}\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
For the full transport rate we would instead have
\begin_inset Formula 
\[
\rho_{\text{trial}}=\frac{\tau_{\text{tr}}^{-1}}{e^{2}\left(\frac{n}{m}\right)_{zz}}=\frac{\hbar}{e^{2}}\frac{a_{xy}^{2}}{a_{z}}\left[\frac{\pi\lambda_{tr,ME}}{\left(2t_{\perp}\right)^{2}\nu_{0}}\frac{\beta\omega_{0}^{2}}{\cosh\left(\beta\omega_{0}\right)-1}\mathcal{J}\left(\alpha\pi\beta J,\beta\omega_{0}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Section*
Kondo scattering at high temps
\end_layout

\begin_layout Standard
We start once again from 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)=\frac{2\pi}{\hbar kT}\frac{\sum_{\boldsymbol{k}\boldsymbol{k}'}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{k}'z}\right)^{2}P_{\boldsymbol{k}\boldsymbol{k}'}\delta\left(\omega-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}},
\]

\end_inset


\end_layout

\begin_layout Standard
with 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
P_{\boldsymbol{k}\boldsymbol{p}} & =-kT\frac{\partial f_{\boldsymbol{p}}}{\partial\epsilon_{\boldsymbol{p}}}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\chi''\left(\boldsymbol{p}-\boldsymbol{k},\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)\\
 & =\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\chi''\left(\boldsymbol{k}-\boldsymbol{p},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)\\
 & =kTW_{\boldsymbol{k}\boldsymbol{p}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We then have 
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)=\frac{2\pi}{\hbar}\frac{\sum_{\boldsymbol{p}\boldsymbol{k}}\left(v_{\boldsymbol{p}z}-v_{\boldsymbol{k}z}\right)^{2}\left(-\frac{\partial f_{\boldsymbol{p}}}{\partial\epsilon_{\boldsymbol{p}}}\right)\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\chi''\left(\boldsymbol{p}-\boldsymbol{k},\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)\delta\left(\omega-\epsilon_{\boldsymbol{p}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}},
\]

\end_inset


\end_layout

\begin_layout Standard
Enforcing the delta function and using the usual spectral function trick
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)=\frac{2\pi}{\hbar}\frac{\int d\epsilon\ \sum_{\boldsymbol{p}\boldsymbol{k}}\left(v_{\boldsymbol{p}z}-v_{\boldsymbol{k}z}\right)^{2}\left(-\frac{\partial f}{\partial\omega}\right)\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\chi''\left(\boldsymbol{p}-\boldsymbol{k},\omega-\epsilon\right)\left(n_{B}\left(\omega-\epsilon\right)+f\left(-\epsilon\right)\right)\delta\left(\omega-\epsilon_{\boldsymbol{p}}\right)\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
using the local approximation for the spin spectral function
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)=\frac{2\pi}{\hbar}\frac{\int d\epsilon\ \sum_{\boldsymbol{p}\boldsymbol{k}}\left(v_{\boldsymbol{p}z}-v_{\boldsymbol{k}z}\right)^{2}\left(-\frac{\partial f}{\partial\omega}\right)\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\chi''\left(\omega-\epsilon\right)\left(n_{B}\left(\omega-\epsilon\right)+f\left(-\epsilon\right)\right)\delta\left(\omega-\epsilon_{\boldsymbol{p}}\right)\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Defining 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\sum_{\boldsymbol{p}\boldsymbol{k}}\left(v_{\boldsymbol{p}z}-v_{\boldsymbol{k}z}\right)^{2}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\delta\left(\omega-\epsilon_{\boldsymbol{p}}\right)\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}2v_{\boldsymbol{k}z}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}=\alpha_{tr}^{2}F\left(\omega,\epsilon\right)
\]

\end_inset


\end_layout

\begin_layout Standard
we have 
\begin_inset Formula 
\begin{align*}
\tilde{\tau}_{tr}^{-1} & =\frac{2\pi}{\hbar}\int d\epsilon d\omega\ \alpha_{tr}^{2}F\left(\omega,\epsilon\right)\ \chi''\left(\omega-\epsilon\right)\left(n_{B}\left(\omega-\epsilon\right)+f\left(-\epsilon\right)\right)\left(-\frac{\partial f}{\partial\omega}\right)\\
 & \sim\frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\int d\epsilon d\omega\ \ \chi''\left(\omega-\epsilon\right)\left(n_{B}\left(\omega-\epsilon\right)+f\left(-\epsilon\right)\right)\left(-\frac{\partial f}{\partial\omega}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Changing variables, we have 
\begin_inset Formula 
\[
=\frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\int d\epsilon d\omega\ \chi''\left(\epsilon\right)\left(n_{B}\left(\epsilon\right)+f\left(\epsilon-\omega\right)\right)\left(-\frac{\partial f}{\partial\omega}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Integrating over 
\begin_inset Formula $\omega$
\end_inset

 first,
\begin_inset Formula 
\[
\int d\omega\ f\left(\epsilon-\omega\right)\left(-\frac{\partial f}{\partial\omega}\right)=n_{B}\left(\epsilon\right)\left(n_{B}\left(\epsilon\right)+\left(1+n_{B}\left(\epsilon\right)\right)\left(\beta\epsilon-1\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
For the second integral, we have 
\begin_inset Formula 
\begin{align*}
 & \frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\int d\epsilon\ \chi''\left(\epsilon\right)\left(n_{B}\left(\epsilon\right)+n_{B}\left(\epsilon\right)\left(n_{B}\left(\epsilon\right)+\left(1+n_{B}\left(\epsilon\right)\right)\left(\beta\epsilon-1\right)\right)\right)\\
 & =\frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\int d\epsilon\ \chi''\left(\epsilon\right)n_{B}\left(\epsilon\right)\left(1+n_{B}\left(\epsilon\right)+\left(1+n_{B}\left(\epsilon\right)\right)\left(\beta\epsilon-1\right)\right)\\
 & =\frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\frac{\kappa}{TJ}\int_{-\alpha\pi J}^{\alpha\pi J}d\epsilon\ \epsilon n_{B}\left(\epsilon\right)\left(1+n_{B}\left(\epsilon\right)+\left(1+n_{B}\left(\epsilon\right)\right)\left(\beta\epsilon-1\right)\right)\\
 & =\frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\beta\frac{\kappa}{J}\int_{-\alpha\pi J}^{\alpha\pi J}d\epsilon\ \epsilon n_{B}\left(\epsilon\right)\left(1+n_{B}\left(\epsilon\right)+\left(1+n_{B}\left(\epsilon\right)\right)\left(\beta\epsilon-1\right)\right)\\
 & =\frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\beta\frac{\kappa}{J}\int_{-\alpha\pi J}^{\alpha\pi J}d\epsilon\ \epsilon n_{B}\left(\epsilon\right)\left(1+n_{B}\left(\epsilon\right)\right)\left(1+\left(\beta\epsilon-1\right)\right)\\
 & =\frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\beta\frac{\kappa}{J}\int_{-\alpha\pi J}^{\alpha\pi J}d\epsilon\ \epsilon n_{B}\left(\epsilon\right)\left(1+n_{B}\left(\epsilon\right)\right)\left(\beta\epsilon\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Changing variables
\begin_inset Formula 
\begin{align*}
\beta\frac{\kappa}{J}\int_{-\alpha\pi J}^{\alpha\pi J}d\epsilon\ \epsilon n_{B}\left(\epsilon\right)\left(1+n_{B}\left(\epsilon\right)\right)\left(\beta\epsilon\right)\\
=\frac{\kappa}{\beta J}\int_{-\alpha\pi\beta J}^{\alpha\pi\beta J}d\epsilon\ \epsilon^{2}\tilde{n_{B}}\left(\epsilon\right)\left(1+\tilde{n_{B}}\left(\epsilon\right)\right)\\
\alpha\pi\kappa\mathcal{I}\left(\alpha\pi\beta J\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula 
\begin{align*}
\mathcal{I}\left(y\right) & =\frac{1}{y}\int_{-y}^{y}d\epsilon\ \epsilon^{2}\tilde{n_{B}}\left(\epsilon\right)\left(1+\tilde{n_{B}}\left(\epsilon\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Performing this integral, we have
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\mathcal{I}\left(y\right) & =-\frac{4\text{Li}_{2}\left(e^{-y}\right)}{y}-\frac{2y}{e^{y}-1}-4y+\frac{2\pi^{2}}{3y}+4\log\left(e^{y}-1\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Overall, we have 
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}=\frac{2\pi}{\hbar}\alpha_{tr}^{2}F\left(0,0\right)\left[\alpha\pi\kappa I\left(\alpha\pi\beta J\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
We now evaluate 
\begin_inset Formula 
\[
\frac{\sum_{\boldsymbol{p}\boldsymbol{k}}\left(v_{\boldsymbol{p}z}-v_{\boldsymbol{k}z}\right)^{2}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{p}}\right)\delta\left(\epsilon_{\boldsymbol{k}}\right)}{2\sum_{\boldsymbol{k}}v_{\boldsymbol{k}z}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}=\alpha_{tr}^{2}F\left(0,0\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Using our previous calculations we have 
\begin_inset Formula 
\[
\alpha_{tr}^{2}F\left(0,0\right)=2J_{K}^{2}\nu_{0}
\]

\end_inset


\end_layout

\begin_layout Standard
Then we have 
\begin_inset Formula 
\begin{align*}
\tilde{\tau}_{tr}^{-1} & =\frac{2\pi}{\hbar}\left[2\pi\alpha\kappa J_{K}^{2}\nu_{0}\mathcal{I}\left(\alpha\pi\beta J\right)\right]\\
 & =\frac{2\pi}{\hbar}\left[\lambda_{k}J_{K}\mathcal{I}\left(\alpha\pi\beta J\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we defined the dimensionless coupling
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lambda_{K}=2\pi\alpha\kappa J_{K}\nu_{0}
\]

\end_inset


\end_layout

\begin_layout Subsection*
Kondo resistivity 
\end_layout

\begin_layout Standard
using the formula
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho_{\text{trial}}=\frac{\tau_{\text{tr}}^{-1}}{e^{2}\left(\frac{n}{m}\right)_{zz}}
\]

\end_inset


\end_layout

\begin_layout Standard
The relevan calculation is then
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left(\frac{n}{m}\right)_{zz}=-\frac{1}{V}\sum_{\boldsymbol{q}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}v_{\boldsymbol{k}z}^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
at temperatures below the degeneracy temperature we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\left(\frac{n}{m}\right)_{zz} & =\frac{1}{a_{xy}^{2}a_{z}}\frac{1}{N}\sum_{\boldsymbol{k}}\delta\left(\epsilon_{\boldsymbol{k}}\right)v_{\boldsymbol{k}z}^{2}\\
 & =\frac{2\nu_{0}\left(\frac{t_{\perp}a_{z}}{\hbar}\right)^{2}}{a_{xy}^{2}a_{z}}\\
 & =2\nu_{0}\left(\frac{t_{\perp}}{\hbar}\right)^{2}\frac{a_{z}}{a_{xy}^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we once again used 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{1}{N}\sum_{\boldsymbol{k}}\left[2\frac{t_{\perp}a_{z}}{\hbar}\sin\left(k_{z}a_{z}\right)\right]^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)=\nu_{0}a_{z}\int_{-\pi/a_{z}}^{\pi/a_{z}}\frac{dk_{z}}{2\pi}\left[2\frac{t_{\perp}a_{z}}{\hbar}\sin\left(k_{z}a_{z}\right)\right]^{2}=2\nu_{0}\left(\frac{t_{\perp}a_{z}}{\hbar}\right)^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
if we include the sum over spins 
\begin_inset Formula 
\begin{align*}
\left(\frac{n}{m}\right)_{zz} & =4\nu_{0}\left(\frac{t_{\perp}}{\hbar}\right)^{2}\frac{a_{z}}{a_{xy}^{2}}\\
 & =2\rho_{0}\left(\frac{t_{\perp}}{\hbar}\right)^{2}\frac{a_{z}}{a_{xy}^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
so that 
\begin_inset Formula 
\begin{align*}
\rho_{\text{trial}} & =\frac{\frac{2\pi}{\hbar}\left[\lambda_{K}J_{K}\mathcal{I}\left(\alpha\pi\beta J\right)\right]}{e^{2}2\nu_{0}\left(\frac{2t_{\perp}}{\hbar}\right)^{2}\frac{a_{z}}{a_{xy}^{2}}}\\
 & =\frac{\hbar}{e^{2}}\frac{a_{xy}^{2}}{a_{z}}\left[\frac{2\pi\lambda_{K}J_{K}\mathcal{I}\left(\alpha\pi\beta J\right)}{2\nu_{0}\left(2t_{\perp}\right)^{2}}\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection*
Full resistivity
\end_layout

\begin_layout Standard
we finally have
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\rho_{\text{trial}} & =\frac{\tau_{\text{tr},ME}^{-1}+\tau_{\text{tr},K}^{-1}}{e^{2}\left(\frac{n}{m}\right)_{zz}}=\frac{\hbar}{e^{2}}\frac{a_{xy}^{2}}{a_{z}}\left[\frac{2\pi\lambda_{tr,ME}}{2\nu_{0}\left(2t_{\perp}\right)^{2}}\frac{\beta\omega_{0}^{2}}{\cosh\left(\beta\omega_{0}\right)-1}\mathcal{J}\left(\alpha\pi\beta J,\beta\omega_{0}\right)+\frac{2\pi\lambda_{K}J_{K}\mathcal{I}\left(\alpha\pi\beta J\right)}{2\nu_{0}\left(2t_{\perp}\right)^{2}}\right]\\
