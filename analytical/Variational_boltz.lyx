\begin_layout Standard
Density of states in D dimensions 
\begin_inset Formula 
\begin{align*}
\nu_{0}=\frac{1}{\hbar^{D}}\int\frac{d^{D}\boldsymbol{k}}{\left(2\pi\right)^{D}}\delta\left(\epsilon_{\boldsymbol{k}}\right) & =\frac{2m}{\hbar^{D}}\int\frac{k^{D-1}dkd\Omega_{k}}{\left(2\pi\right)^{D}}\delta\left(k^{2}-k_{F}^{2}\right)\\
 & =\frac{2m}{2\hbar^{D}k_{F}}\int\frac{k^{D-1}dkd\Omega_{k}}{\left(2\pi\right)^{D}}\delta\left(k-k_{F}\right)\\
 & =\frac{mk_{F}^{D-2}}{\hbar^{D}}\int\frac{d\Omega_{k}}{\left(2\pi\right)^{D}}
\end{align*}

