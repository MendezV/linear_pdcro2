we now plug in our expression for the transition rate.
 This can be done straight forwardly 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)=\frac{2\pi}{\hbar}\frac{\sum_{\boldsymbol{k}\boldsymbol{k}'}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\epsilon_{\boldsymbol{k}}-\nu\right)\left[n_{B}\left(\epsilon_{\boldsymbol{k}}-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Simplifying by enforcing the delta function 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)=\frac{2\pi}{\hbar}\frac{\sum_{\boldsymbol{k}\boldsymbol{p}}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left(-\frac{\partial f}{\partial\omega}\right)\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]\delta\left(\omega-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Focusing for a moment on the last portion of the numerator
\begin_inset Formula 
\begin{align*}
\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]\\
=\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\nu-\epsilon\right)\left(B^{-}\left(\boldsymbol{q},\epsilon\right)-B^{+}\left(\boldsymbol{q},\epsilon\right)\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon+\nu\right)\right]\\
=\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\nu-\epsilon\right)B^{-}\left(\boldsymbol{q},\epsilon\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon+\nu\right)\right]\\
-\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\nu-\epsilon\right)B^{+}\left(\boldsymbol{q},\epsilon\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon+\nu\right)\right]\\
\\
=\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\nu-\epsilon\right)B^{-}\left(\boldsymbol{q},\epsilon\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon+\nu\right)\right]\\
-\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\nu+\epsilon\right)B^{+}\left(\boldsymbol{q},-\epsilon\right)\left[n_{B}\left(-\epsilon\right)+n_{F}\left(-\epsilon+\nu\right)\right]\\
\\
=\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\nu-\epsilon\right)B^{-}\left(\boldsymbol{q},\epsilon\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon+\nu\right)\right]\\
+\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\nu+\epsilon\right)B^{-}\left(\boldsymbol{q},\epsilon\right)\left[n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\\
\\
\approx\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},0\right)B^{-}\left(\boldsymbol{q},\epsilon\right)\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon+\nu\right)+n_{F}\left(\epsilon-\nu\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula 
\[
B\left(\boldsymbol{q},\epsilon\right)=B^{-}\left(\boldsymbol{q},\epsilon\right)-B^{+}\left(\boldsymbol{q},\epsilon\right)
\]

\end_inset


\end_layout

\begin_layout Standard
We then have 
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)=\frac{2\pi}{\hbar}\frac{\sum_{\boldsymbol{k}\boldsymbol{p}\boldsymbol{q}}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\delta\left(\omega-\epsilon_{\boldsymbol{k}}\right)A\left(\boldsymbol{p},0\right)\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}B^{-}\left(\boldsymbol{q},\epsilon\right)\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\nu+\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\left(-\frac{\partial f}{\partial\omega}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Now we assume Einstein phonons and take the local approximation for 
\begin_inset Formula $\chi''$
\end_inset

.
 In this case, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)\approx\frac{2\pi}{\hbar}\frac{\sum_{\boldsymbol{k}\boldsymbol{p}\boldsymbol{q}}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\delta\left(\omega-\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{p}}\right)\int\frac{d\nu}{\pi}\int d\epsilon\ \chi''\left(\omega-\nu\right)B^{-}\left(\epsilon\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\nu+\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\left(-\frac{\partial f}{\partial\omega}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Now we approximate 
\begin_inset Formula $\delta\left(\omega-\epsilon_{\boldsymbol{k}}\right)\sim\delta\left(\epsilon_{\boldsymbol{k}}\right)$
\end_inset

 and define 
\begin_inset Formula 
\begin{align*}
\frac{\sum_{\boldsymbol{k}\boldsymbol{p}}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{p}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}}\\
\approx\frac{\sum_{\boldsymbol{k}\boldsymbol{p}}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{p}}\right)}{2\sum_{\boldsymbol{k}}\delta\left(\epsilon_{\boldsymbol{k}}\right)v_{\boldsymbol{k}z}^{2}}\\
=\Lambda_{tr}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
we will omit the factor of 
\begin_inset Formula 
\[
\frac{2\pi}{\hbar}
\]

\end_inset

 briefly to simplify notation
\end_layout

\begin_layout Standard
With this, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\omega\right)\approx\Lambda_{tr}\int\frac{d\nu}{\pi}\int d\epsilon\ \chi''\left(\omega-\nu\right)B^{-}\left(\epsilon\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\nu+\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\left(-\frac{\partial f}{\partial\omega}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
So that the transport time will be given by 
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\Lambda_{tr}\int\frac{d\nu}{\pi}\int d\epsilon\int d\omega\ \chi''\left(\omega-\nu\right)B^{-}\left(\epsilon\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon+\nu\right)+n_{F}\left(\epsilon-\nu\right)\right]\left(-\frac{\partial f}{\partial\omega}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
To simplify a bit the calculation we make the change of variables 
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\Lambda_{tr}\int\frac{d\nu}{\pi}\int d\epsilon\int d\omega\ \chi''\left(\nu\right)B^{-}\left(\epsilon\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\omega-\nu+\epsilon\right)+n_{F}\left(\epsilon+\nu-\omega\right)\right]\left(-\frac{\partial f}{\partial\omega}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
We will use in what follows
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
B\left(\nu\right) & =\frac{\pi\hbar}{2M\omega_{0}}\left(\delta\left(\nu-\omega_{0}\right)-\delta\left(\nu+\omega_{0}\right)\right)\\
 & =B^{-}\left(\nu\right)-B^{+}\left(\nu\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Subsubsection*
Simplified transport time 
\end_layout

\begin_layout Standard
In case we are at suffieciently low temperatures we have
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tau_{tr}^{-1} & =\Lambda_{tr}\int\frac{d\nu}{\pi}\int d\epsilon\int d\omega\ \chi''\left(\nu\right)B^{-}\left(\epsilon\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu\right)\right]\left[2n_{B}\left(\epsilon\right)+n_{F}\left(-\nu+\epsilon\right)+n_{F}\left(\epsilon+\nu\right)\right]\\
 & =\Lambda_{tr}\int\frac{d\nu}{\pi}\int d\epsilon\ \chi''\left(\nu\right)B^{-}\left(\epsilon\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu\right)\right]\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\nu+\epsilon\right)+n_{F}\left(\epsilon-\nu\right)\right]\\
 & =\frac{\hbar}{2M\omega_{0}}\Lambda_{tr}\int d\nu\ \chi''\left(\nu\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu\right)\right]\left[2n_{B}\left(\omega_{0}\right)+n_{F}\left(\nu+\omega_{0}\right)+n_{F}\left(\omega_{0}-\nu\right)\right]\\
 & =\frac{\hbar}{2M\omega_{0}}\Lambda_{tr}\int d\nu\ \chi''\left(\nu\right)\text{csch}\left(\beta\nu\right)\left[2n_{B}\left(\omega_{0}\right)+n_{F}\left(\nu+\omega_{0}\right)+n_{F}\left(\omega_{0}-\nu\right)\right]\\
 & =\frac{\hbar}{2M\omega_{0}}\Lambda_{tr}\int d\nu\ \chi''\left(\nu\right)\text{csch}\left(\beta\nu\right)\left[2n_{B}\left(\omega_{0}\right)+1+n_{F}\left(\omega_{0}-\nu\right)-n_{F}\left(-\nu-\omega_{0}\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The integral in the end can be done analytically 
\begin_inset Formula 
\[
\int\frac{d\nu}{\pi}\ \chi''\left(\nu\right)\text{csch}\left(\beta\nu\right)\left[2n_{B}\left(\omega_{0}\right)+n_{F}\left(\nu+\omega_{0}\right)+n_{F}\left(\nu-\omega_{0}\right)\right]=\kappa\alpha\pi\frac{1}{\pi\alpha\beta J}\int_{-\alpha\pi\beta J}^{\alpha\pi\beta J}d\nu\ \nu\text{csch}\left(\nu\right)\left[2n_{B}\left(\omega_{0}\right)+1+\frac{1}{e^{\beta\omega_{0}-\nu}+1}-\frac{1}{e^{-\beta\omega_{0}-\nu}+1}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
For the first integral above, we have 
\begin_inset Formula 
\begin{align*}
\frac{1}{y}\int_{-y}^{y}d\nu\ \nu\,\text{csch}\left(\nu\right) & =Z_{1}\left(y\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Z_{1}\left(y\right)=-\frac{y}{2}-\log\left[\left(e^{-y}+1\right)\left(e^{y}+1\right)\right]+\frac{\text{Li}_{2}\left(-e^{-y}\right)-\text{Li}_{2}\left(-e^{y}\right)-2\text{Li}_{2}\left(1-e^{y}\right)}{y}
\]

\end_inset


\end_layout

\begin_layout Standard
For the second and third integrals, we have 
\begin_inset Formula 
\begin{align*}
\pm\frac{1}{y}\int_{-y}^{y}d\nu\ \nu\text{csch}\left(\nu\right)\frac{1}{e^{\pm\beta\omega_{0}-\nu}+1} & =\pm\left[n_{F}\left(\pm\omega_{0}\right)Z_{2}\left(\alpha\pi\beta J,\pm\beta\omega_{0}\right)+n_{B}\left(\pm\omega_{0}\right)Z_{3}\left(\alpha\pi\beta J,\pm\beta\omega_{0}\right)\right]\\
 & =\pm\left[n_{F}\left(\pm\omega_{0}\right)Z_{2}\left(\alpha\pi\beta J,\beta\omega_{0}\right)+n_{B}\left(\pm\omega_{0}\right)Z_{3}\left(\alpha\pi\beta J,\beta\omega_{0}\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Z_{1}\left(y,z\right)=-\left[y+\frac{z^{2}}{2y}-\frac{\pi^{2}}{6y}+\log\left(\frac{\cosh\left(y\right)+\cosh\left(z\right)}{\cosh\left(y\right)-1}\right)+\frac{\text{Li}_{2}\left(-e^{y-z}\right)+\text{Li}_{2}\left(-e^{y+z}\right)+2\text{Li}_{2}\left(e^{-y}\right)}{y}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Z_{2}\left(y,z\right)=-\left[\frac{z^{2}}{2y}+\log\left(\frac{\cosh\left(y\right)+\cosh\left(z\right)}{\cosh\left(y\right)+1}\right)+\frac{\text{Li}_{2}\left(-e^{y-z}\right)+\text{Li}_{2}\left(-e^{y+z}\right)-2\text{Li}_{2}\left(-e^{y}\right)}{y}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Overall we have 
\begin_inset Formula 
\begin{align*}
\frac{\hbar\kappa\alpha\pi}{2M\omega_{0}}\Lambda_{tr}\left[\left(2n_{B}\left(\omega_{0}\right)+1\right)Z_{1}\left(\alpha\pi\beta J\right)+\left[n_{F}\left(\omega_{0}\right)-n_{F}\left(-\omega_{0}\right)\right]Z_{2}\left(\alpha\pi\beta J,\beta\omega_{0}\right)+\left[n_{B}\left(\omega_{0}\right)-n_{B}\left(-\omega_{0}\right)\right]Z_{3}\left(\alpha\pi\beta J,\beta\omega_{0}\right)\right]\\
\frac{\hbar\kappa\alpha\pi}{2M\omega_{0}}\Lambda_{tr}\left[\left(2n_{B}\left(\omega_{0}\right)+1\right)Z_{1}\left(\alpha\pi\beta J\right)+\left[2n_{F}\left(\omega_{0}\right)-1\right]Z_{2}\left(\alpha\pi\beta J,\beta\omega_{0}\right)+\left[2n_{B}\left(\omega_{0}\right)+1\right]Z_{3}\left(\alpha\pi\beta J,\beta\omega_{0}\right)\right]\\
\frac{\hbar\kappa\alpha\pi}{2M\omega_{0}}\Lambda_{tr}\left[\left(2n_{B}\left(\omega_{0}\right)+1\right)\left(Z_{1}\left(\alpha\pi\beta J\right)+Z_{3}\left(\alpha\pi\beta J,\beta\omega_{0}\right)\right)+\left[2n_{F}\left(\omega_{0}\right)-1\right]Z_{2}\left(\alpha\pi\beta J,\beta\omega_{0}\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We then conclude that 
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\frac{\hbar\kappa\alpha\pi}{2M\omega_{0}}\Lambda_{tr}\left[\left(2n_{B}\left(\omega_{0}\right)+1\right)\left(Z_{1}\left(\alpha\pi\beta J\right)+Z_{3}\left(\alpha\pi\beta J,\beta\omega_{0}\right)\right)+\left[2n_{F}\left(\omega_{0}\right)-1\right]Z_{2}\left(\alpha\pi\beta J,\beta\omega_{0}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Subsubsection*
More physical average 
\end_layout

\begin_layout Standard
taking the transport time from before we now calculate the integral over
 
\begin_inset Formula $\omega$
\end_inset

 first
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\Lambda_{tr}\int\frac{d\nu}{\pi}\int d\epsilon\int d\omega\ \chi''\left(\nu\right)B^{-}\left(\epsilon\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\omega-\nu+\epsilon\right)+n_{F}\left(\epsilon+\nu-\omega\right)\right]\left(-\frac{\partial f}{\partial\omega}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
However, it is still possible for an optical mode to calculate the integral
 over 
\begin_inset Formula $\epsilon$
\end_inset

 , this again yields
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\frac{\hbar}{2M\omega_{0}}\Lambda_{tr}\int d\nu\int d\omega\ \chi''\left(\nu\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\left[2n_{B}\left(\omega_{0}\right)+n_{F}\left(\omega+\omega_{0}-\nu\right)+n_{F}\left(\omega_{0}+\nu-\omega\right)\right]\left(-\frac{\partial f}{\partial\omega}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
The integral over 
\begin_inset Formula $\omega$
\end_inset

 can be performed since it only involves the occupation functions
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
 & \int d\omega\ \left[n_{B}\left(\nu\right)+n_{F}\left(\nu-\omega\right)\right]\left[2n_{B}\left(\omega_{0}\right)+n_{F}\left(\omega+\omega_{0}-\nu\right)+n_{F}\left(\omega_{0}+\nu-\omega\right)\right]\left(-\frac{\partial f}{\partial\omega}\right)\\
 & =\frac{1}{4}\text{csch}\left(\frac{\beta\nu}{2}\right)\text{csch}\left(\frac{\beta\omega_{0}}{2}\right)\left(\frac{\beta\nu-\beta\omega_{0}}{2}\text{csch}\left(\frac{\beta\nu-\beta\omega_{0}}{2}\right)+\frac{\beta\nu+\beta\omega_{0}}{2}\text{csch}\left(\frac{\beta\nu+\beta\omega_{0}}{2}\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The integral that we have to calculate is 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\frac{\hbar}{2M\omega_{0}}\Lambda_{tr}\int d\nu\ \chi''\left(\nu\right)\left[\frac{1}{4}\text{csch}\left(\frac{\beta\nu}{2}\right)\text{csch}\left(\frac{\beta\omega_{0}}{2}\right)\left(\frac{\beta\nu-\beta\omega_{0}}{2}\text{csch}\left(\frac{\beta\nu-\beta\omega_{0}}{2}\right)+\frac{\beta\nu+\beta\omega_{0}}{2}\text{csch}\left(\frac{\beta\nu+\beta\omega_{0}}{2}\right)\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
which can be expressed as 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tau_{tr}^{-1} & =\frac{\hbar\kappa\alpha\pi}{2M\omega_{0}}\Lambda_{tr}\frac{1}{\pi\alpha\beta J}\int_{-\alpha\pi\beta J}^{\alpha\pi\beta J}d\nu\ \nu\left[\frac{1}{4}\text{csch}\left(\frac{\nu}{2}\right)\text{csch}\left(\frac{\beta\omega_{0}}{2}\right)\left(\frac{\nu-\beta\omega_{0}}{2}\text{csch}\left(\frac{\nu-\beta\omega_{0}}{2}\right)+\frac{\nu+\beta\omega_{0}}{2}\text{csch}\left(\frac{\nu+\beta\omega_{0}}{2}\right)\right)\right]\\
 & =\frac{\hbar\kappa\alpha\pi}{2M\omega_{0}}\Lambda_{tr}I\left(\alpha\pi\beta J,\beta\omega_{0}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
So the relevant integral is 
\begin_inset Formula 
\[
I\left(y,z\right)=\frac{1}{y}\int_{-y}^{y}dx\ x\left[\frac{1}{4}\text{csch}\left(\frac{x}{2}\right)\text{csch}\left(\frac{z}{2}\right)\left(\frac{x-z}{2}\text{csch}\left(\frac{x-z}{2}\right)+\frac{\nu+z}{2}\text{csch}\left(\frac{x+z}{2}\right)\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
This integral gives the result
\begin_inset Formula 
\[
I\left(y,z\right)=\frac{z}{\cosh\left(z\right)-1}\mathcal{J}\left(y,z\right)
\]

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula 
\begin{align*}
\mathcal{J}\left(y,z\right) & =\frac{-2z\text{Li}_{2}\left(e^{-y}\right)+\left(2y+z\right)\text{Li}_{2}\left(e^{-y-z}\right)+\left(z-2y\right)\text{Li}_{2}\left(e^{z-y}\right)+2\text{Li}_{3}\left(e^{-y-z}\right)-2\text{Li}_{3}\left(e^{z-y}\right)}{2yz}\\
 & +\frac{z^{2}}{12y}-\frac{1}{2}\log\left(\left(e^{y}-e^{z}\right)\left(e^{y+z}-1\right)\right)+\frac{y\log\left(\sinh\left(\frac{y-z}{2}\right)\text{csch}\left(\frac{y+z}{2}\right)\right)}{2z}+\frac{y}{2}+\frac{\pi^{2}}{3y}+\log\left(e^{y}-1\right)+\frac{z}{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\frac{\hbar\kappa\alpha\pi}{M\omega_{0}^{2}}\Lambda_{tr}\frac{\beta\omega_{0}^{2}}{\cosh\left(\beta\omega_{0}\right)-1}\mathcal{J}\left(\alpha\pi\beta J,\beta\omega_{0}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
where we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathcal{J}\left(y\rightarrow0^{+},z\right)=1
\]

\end_inset


\end_layout

\begin_layout Standard
Which then has 
\begin_inset Formula 
\[
\frac{\hbar\kappa\alpha\pi}{M\omega_{0}^{2}}\Lambda_{tr}=\lambda_{tr,ME}
\]

\end_inset


\end_layout

\begin_layout Standard
then
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\frac{2\pi}{\hbar}\lambda_{tr,ME}\frac{\beta\omega_{0}^{2}}{\cosh\left(\beta\omega_{0}\right)-1}\mathcal{J}\left(\alpha\pi\beta J,\beta\omega_{0}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
where we reinstated the factor of 
\begin_inset Formula 
\[
\frac{2\pi}{\hbar}
\]

\end_inset


\end_layout

\begin_layout Subsubsection*
Calculating the magnetoelastic coupling
\end_layout

\begin_layout Standard
In the definition of the magnetoelastic coupling, we have several parts
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Lambda_{tr}=\frac{\sum_{\boldsymbol{k}\boldsymbol{p}}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{p}}\right)}{2\sum_{\boldsymbol{k}}\delta\left(\epsilon_{\boldsymbol{k}}\right)v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
where we had 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Lambda_{tr}=2\lambda^{2}\frac{\sum_{\boldsymbol{k}\boldsymbol{p}}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left|g\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{p}}\right)}{2\sum_{\boldsymbol{k}}\delta\left(\epsilon_{\boldsymbol{k}}\right)v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
with 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
g\left(\boldsymbol{k},\boldsymbol{k}'\right) & =J_{K}\left[2\cos\left(k_{z}a_{z}\right)\right]\left[2\cos\left(k_{z}'a_{z}\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula 
\[
J_{K}=\frac{4g^{2}}{U}
\]

\end_inset


\end_layout

\begin_layout Standard
so that we have 
\begin_inset Formula 
\[
\Lambda_{tr}=2\lambda^{2}J_{K}^{2}\frac{\sum_{\boldsymbol{k}\boldsymbol{p}}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{p}z}\right)^{2}\left[2\cos\left(k_{z}a_{z}\right)\right]^{2}\left[2\cos\left(p_{z}a_{z}\right)\right]^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{p}}\right)}{2\sum_{\boldsymbol{k}}\delta\left(\epsilon_{\boldsymbol{k}}\right)v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Now we model the dispersion 
\begin_inset Formula 
\[
\epsilon_{\boldsymbol{k}}=\epsilon_{\parallel\boldsymbol{k}}-2t_{\perp}\cos k_{z}a_{z}
\]

\end_inset


\end_layout

\begin_layout Standard
Such that the velocity is given by 
\begin_inset Formula 
\[
v_{\boldsymbol{k}z}=2t_{\perp}a_{z}\sin k_{z}a_{z}
\]

\end_inset


\end_layout

\begin_layout Standard
Since this is odd in momentum, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Lambda_{tr}=2\lambda^{2}J_{K}^{2}\frac{\sum_{\boldsymbol{k}\boldsymbol{p}}v_{\boldsymbol{k}z}^{2}\left[2\cos\left(k_{z}a_{z}\right)\right]^{2}\left[2\cos\left(p_{z}a_{z}\right)\right]^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{p}}\right)}{\sum_{\boldsymbol{k}}\delta\left(\epsilon_{\boldsymbol{k}}\right)v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Replacing our expression for the velocity, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Lambda_{tr}=2\lambda^{2}J_{K}^{2}\frac{\sum_{\boldsymbol{k}}\left[2\sin\left(k_{z}a_{z}\right)\right]^{2}\left[2\cos\left(k_{z}a_{z}\right)\right]^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\sum_{\boldsymbol{p}}\left[2\cos\left(p_{z}a_{z}\right)\right]^{2}\delta\left(\epsilon_{\boldsymbol{p}}\right)}{\sum_{\boldsymbol{k}}\delta\left(\epsilon_{\boldsymbol{k}}\right)\left[2\sin\left(k_{z}a_{z}\right)\right]^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
we see that the factor of the bandwidth cancels out explicitly, we have
 then to calculate three integrals
\begin_inset Formula 
\[
\frac{1}{N}\sum_{\boldsymbol{k}}\left[2\sin\left(k_{z}a_{z}\right)\right]^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)
\]

\end_inset


\begin_inset Formula 
\[
\frac{1}{N}\sum_{\boldsymbol{k}}\left[2\sin\left(k_{z}a_{z}\right)\right]^{2}\left[2\cos\left(k_{z}a_{z}\right)\right]^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{1}{N}\sum_{\boldsymbol{p}}\left[2\cos\left(p_{z}a_{z}\right)\right]^{2}\delta\left(\epsilon_{\boldsymbol{p}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
the sum over planes gives factors of the 2d density of states, while the
 remaining parts are only integrals over the 
\begin_inset Formula $k_{z}$
\end_inset

 direction
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Lambda_{tr}=2\lambda^{2}J_{K}^{2}\nu_{0}\frac{a_{z}\int\frac{dk_{z}}{2\pi}\left[2\sin\left(k_{z}a_{z}\right)\right]^{2}\left[2\cos\left(k_{z}a_{z}\right)\right]^{2}a_{z}\int\frac{dp_{z}}{2\pi}\left[2\cos\left(p_{z}a_{z}\right)\right]^{2}}{a_{z}\int\frac{dk_{z}}{2\pi}\left[2\sin\left(k_{z}a_{z}\right)\right]^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
the last part only gives a numerical factor that can be evaluated right
 away
\begin_inset Formula 
\[
a_{z}\int\frac{dk_{z}}{2\pi}\left[2\sin\left(k_{z}a_{z}\right)\right]^{2}\left[2\cos\left(k_{z}a_{z}\right)\right]^{2}=a_{z}\int\frac{dk_{z}}{2\pi}\left[2\sin\left(k_{z}a_{z}\right)\right]^{2}=a_{z}\int\frac{dp_{z}}{2\pi}\left[2\cos\left(p_{z}a_{z}\right)\right]^{2}=2
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Lambda_{tr}=4\lambda^{2}J_{K}^{2}\nu_{0}
\]

\end_inset


\end_layout

\begin_layout Standard
With this, we find that 
\begin_inset Formula 
\begin{align*}
\lambda_{tr,ME} & =2\pi\kappa\alpha\frac{J_{K}^{2}\nu_{0}}{\hbar\omega_{0}}\frac{2\hbar\lambda^{2}}{M\omega_{0}}\\
 & =4\pi\kappa\alpha\frac{J_{K}^{2}\nu_{0}}{\hbar\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Or in terms of the notation in the paper
\begin_inset Formula 
\[
\lambda_{tr,ME}=8\pi S\left(S+1\right)\frac{\tilde{\alpha}\nu_{0}}{\hbar\omega_{0}}\frac{\hbar}{M\omega_{0}}
\]

\end_inset


\end_layout

\begin_layout Standard
If I use the transport time derived for the Kondo scattering I get 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lambda_{tr,ME}=2\pi\lambda_{K,tr}\frac{J_{K}}{\hbar\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}
\]

\end_inset


\end_layout

