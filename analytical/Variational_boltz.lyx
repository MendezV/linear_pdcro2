\begin_inset Formula 
\[
\alpha_{tr}^{2}F\left(\nu\right)=2\lambda_{A}\left(\frac{\nu}{2ck_{F}}\right)^{4}\theta\left(2ck_{F}-\left|\nu\right|\right).
\]

\end_inset


\end_layout

\begin_layout Subsection*
Revised transport rate in 2D
\end_layout

\begin_layout Standard
With the new extra factor of 
\begin_inset Formula $1/\pi$
\end_inset

 the transport rate will be given by 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{2}{\beta\omega_{D}}\right)^{3}\frac{1}{\pi}\int_{0}^{\frac{\beta\omega_{D}}{2}}dx\ \frac{x^{4}}{\sqrt{1-\left(\frac{2}{\beta\omega_{D}}\right)^{2}x^{2}}}\left[\text{csch}\left(x\right)\right]^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
In the high temperature limit we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tau_{tr}^{-1} & =\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{2}{\beta\omega_{D}}\right)^{-2}\frac{1}{\pi}\int_{0}^{1}dx\ \frac{x^{4}}{\sqrt{1-x^{2}}}\left[\text{csch}\left(\frac{\beta\omega_{D}}{2}x\right)\right]^{2}\\
 & \sim\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{2}{\beta\omega_{D}}\right)^{-2}\frac{1}{\pi}\int_{0}^{1}dx\ \frac{x^{4}}{\sqrt{1-x^{2}}}\left[\left(\frac{\beta\omega_{D}}{2}x\right)\right]^{-2}\\
 & =\frac{8\pi\lambda_{A}}{\hbar\beta}\frac{1}{\pi}\int_{0}^{1}dx\ \frac{x^{2}}{\sqrt{1-x^{2}}}\\
 & =\frac{8\pi\lambda_{A}}{\hbar\beta}\frac{1}{\pi}\frac{\pi}{4}\\
 & =\frac{2\pi\lambda_{A}}{\hbar\beta}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
similar to the 
\begin_inset Formula $3D$
\end_inset

 case.
 In the low temperature limit, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tau_{tr}^{-1} & =\frac{8\pi\lambda_{A}}{\hbar\beta}\left(\frac{2}{\beta\omega_{D}}\right)^{3}\frac{1}{\pi}\int_{0}^{\infty}dx\ x^{4}\left[\text{csch}\left(x\right)\right]^{2}\\
 & \sim T^{4}
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection*
Making the integral better behaved
\end_layout

\begin_layout Standard
We start with 
\begin_inset Newline linebreak
\end_inset


\begin_inset Formula 
\[
\frac{1}{\pi}\int_{0}^{1}dx\ \frac{x^{4}}{\sqrt{1-x^{2}}}\left[\text{csch}\left(\frac{\beta\omega_{D}}{2}x\right)\right]^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
with the change of variables 
\begin_inset Formula 
\[
x=\sin\theta
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
dx=\cos\theta d\theta
\]

\end_inset


\end_layout

\begin_layout Standard
we get
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{1}{\pi}\int_{0}^{\pi/2}\cos\theta d\theta\ \frac{\sin^{4}\theta}{\cos\theta}\left[\text{csch}\left(\frac{\beta\omega_{D}}{2}\sin\theta\right)\right]^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
cancelling stuff
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{1}{\pi}\int_{0}^{\pi/2}d\theta\ \sin^{4}\theta\left[\text{csch}\left(\frac{\beta\omega_{D}}{2}\sin\theta\right)\right]^{2}
\]

\end_inset


\end_layout

