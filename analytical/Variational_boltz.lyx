 & =\frac{1}{Dm^{2}}\frac{\alpha^{2}}{Mc}\int\frac{q^{D-1}dqd\Omega_{q}}{\left(2\pi\right)^{D}}\frac{q^{3}}{2v_{F}^{2}}\delta\left(\frac{k_{F}^{2}+q^{2}-2qk_{F}\cos\theta-k_{F}^{2}}{2m}\right)\delta\left(\nu-cq\right)
