\begin_layout Section*
Magnetoelastic times
\end_layout

\begin_layout Standard
The derivation of the magnetoelastic transport time and resistivity in the
 relaxation time approximation is very similar to what has been done so
 far for the electron-phonon problem.
 We can first define
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\epsilon\right)=\frac{2\pi}{\hbar kT}\frac{\sum_{\boldsymbol{k}\boldsymbol{k}'}\left(v_{\boldsymbol{k}z}-v_{\boldsymbol{k}'z}\right)^{2}P_{\boldsymbol{k}\boldsymbol{k}'}\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}z}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
and then we can integrate to get the transport rate 
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\int_{-\infty}^{\infty}d\epsilon\ \tau_{tr}^{-1}\left(\epsilon\right).
\]

\end_inset


\end_layout

\begin_layout Standard
The only missing piece is the probability 
\begin_inset Formula $P_{\boldsymbol{k}\boldsymbol{k}'}$
\end_inset

 this can be extracted from the self energy
\begin_inset Formula 
\[
\Sigma_{ME}''\left(\boldsymbol{k},\omega\right)=-\frac{2\lambda^{2}}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\left[A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu+\epsilon\right)+A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\nu-\epsilon\right)\right]\left(B^{-}\left(\boldsymbol{q},\epsilon\right)\right)\left[2n_{B}\left(\epsilon\right)+n_{F}\left(\epsilon-\nu\right)+n_{F}\left(\epsilon+\nu\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
by comparing with the quasiparticle time 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{\boldsymbol{k}}^{-1}=\frac{1}{f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}}\right)}\sum_{\boldsymbol{k}'}P_{\boldsymbol{k}\boldsymbol{k}'}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Sigma_{ME}''\left(\boldsymbol{k},\omega\right)=-\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\ell}\left|\lambda_{\ell}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon\right)B_{\ell}\left(\boldsymbol{q},\epsilon-\omega-\nu\right)\chi''\left(\boldsymbol{p},\nu\right)\left[n_{B}\left(\epsilon-\omega-\nu\right)+n_{F}\left(\epsilon\right)\right]\left[n_{B}\left(\nu\right)+n_{F}\left(\omega+\nu\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Changing variables 
\begin_inset Formula $\omega+\nu=u$
\end_inset

, 
\begin_inset Formula $d\nu=u$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Sigma_{ME}''\left(\boldsymbol{k},\omega\right)=-\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\ell}\left|\lambda_{\ell}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon\right)B_{\ell}\left(\boldsymbol{q},\epsilon-\nu\right)\chi''\left(\boldsymbol{p},\nu-\omega\right)\left[n_{B}\left(\epsilon-\nu\right)+n_{F}\left(\epsilon\right)\right]\left[n_{B}\left(\nu-\omega\right)+n_{F}\left(\nu\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
reorganizing using the symmetry properties of the occupation functions and
 the spectral functions
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Sigma_{ME}''\left(\boldsymbol{k},\omega\right)=-\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\ell}\left|\lambda_{\ell}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon\right)B_{\ell}\left(\boldsymbol{q},\nu-\epsilon\right)\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
using the same phonon dispersion for all branches
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\Sigma_{ME}''\left(\boldsymbol{k},\omega\right) & =-\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\left|\tilde{\lambda}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\\
 & =-\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\left|\tilde{\lambda}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Performing 
\begin_inset Formula $\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p}\rightarrow\boldsymbol{p}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Sigma_{ME}''\left(\boldsymbol{k},\omega\right)=-\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\omega-\nu\right)\left[n_{B}\left(\omega-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]
\]

\end_inset


\end_layout

\begin_layout Subsection*
Asumptions start 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau^{-1}\left(\boldsymbol{k}\right)=\sum_{\boldsymbol{q}\boldsymbol{p}}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\epsilon_{\boldsymbol{k}}-\nu\right)\left[n_{B}\left(\epsilon_{\boldsymbol{k}}-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}=\sum_{\ell}\left|\lambda_{\ell}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}$
\end_inset

 and for the time itself we absorbed an extra factor of 2 from the relation
 between the rate and the self energy.
 We also obviate the factors of 
\begin_inset Formula $N$
\end_inset

 which are required to transform sums to integrals.
\end_layout

\begin_layout Standard
Now, since 
\begin_inset Formula 
\[
kT\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)\tau^{-1}\left(\boldsymbol{k}\right)=\sum_{\boldsymbol{p}}P_{\boldsymbol{k}\boldsymbol{p}}
\]

\end_inset


\end_layout

\begin_layout Standard
Assuming that 
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=kT\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\epsilon_{\boldsymbol{k}}-\nu\right)\left[n_{B}\left(\epsilon_{\boldsymbol{k}}-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Now taking the integral over the electron spectral function
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\epsilon_{\boldsymbol{k}}-\nu\right)\left[n_{B}\left(\epsilon_{\boldsymbol{k}}-\nu\right)+n_{F}\left(-\nu\right)\right]B\left(\boldsymbol{q},\nu-\epsilon_{\boldsymbol{p}}\right)\left[n_{B}\left(\nu-\epsilon_{\boldsymbol{p}}\right)+n_{F}\left(-\epsilon_{\boldsymbol{p}}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
we want to check whether this is symmetric with respect to the interchange
 of 
\begin_inset Formula $\boldsymbol{p}$
\end_inset

 and 
\begin_inset Formula $\boldsymbol{k}$
\end_inset

.
 From our previous calculations, we have 
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\nu-\epsilon_{\boldsymbol{k}}\right)B\left(\boldsymbol{q},\nu-\epsilon_{\boldsymbol{p}}\right)n_{B}\left(\nu-\epsilon_{\boldsymbol{k}}\right)n_{F}\left(\epsilon_{\boldsymbol{k}}\right)\left(1-n_{F}\left(\nu\right)\right)\left[n_{B}\left(\nu-\epsilon_{\boldsymbol{p}}\right)+n_{F}\left(-\epsilon_{\boldsymbol{p}}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
This form is vaguely intuitive as it is the convolution of the transition
 rate for scattering off of spins convolved with the one for phonons.
 Now we change variables so that the dispersion only appears in a single
 spectral function
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)B\left(\boldsymbol{q},\nu\right)n_{B}\left(\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)n_{F}\left(\epsilon_{\boldsymbol{k}}\right)\left(1-n_{F}\left(\nu+\epsilon_{\boldsymbol{p}}\right)\right)\left[n_{B}\left(\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{p}}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Now we interchange the momenta 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\left|\tilde{\lambda}\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{k}-\boldsymbol{p}-\boldsymbol{q},\nu+\epsilon_{\boldsymbol{k}}-\epsilon_{\boldsymbol{p}}\right)B\left(\boldsymbol{q},\nu\right)n_{B}\left(\nu+\epsilon_{\boldsymbol{k}}-\epsilon_{\boldsymbol{p}}\right)n_{F}\left(\epsilon_{\boldsymbol{p}}\right)\left(1-n_{F}\left(\nu+\epsilon_{\boldsymbol{k}}\right)\right)\left[n_{B}\left(\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{k}}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
using the symmetry of 
\begin_inset Formula $\chi''$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

 in the momentum argument, the symmetry of the bare vertex, and changing
 the sum over 
\begin_inset Formula $\boldsymbol{q}$
\end_inset

 we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\nu+\epsilon_{\boldsymbol{k}}-\epsilon_{\boldsymbol{p}}\right)B\left(\boldsymbol{q},\nu\right)n_{B}\left(\nu+\epsilon_{\boldsymbol{k}}-\epsilon_{\boldsymbol{p}}\right)n_{F}\left(\epsilon_{\boldsymbol{p}}\right)\left(1-n_{F}\left(\nu+\epsilon_{\boldsymbol{k}}\right)\right)\left[n_{B}\left(\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{k}}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
using the antisymmetry of 
\begin_inset Formula $\chi''$
\end_inset

 and 
\begin_inset Formula $B$
\end_inset

 we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},-\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)B\left(\boldsymbol{q},-\nu\right)n_{B}\left(\nu+\epsilon_{\boldsymbol{k}}-\epsilon_{\boldsymbol{p}}\right)n_{F}\left(\epsilon_{\boldsymbol{p}}\right)\left(1-n_{F}\left(\nu+\epsilon_{\boldsymbol{k}}\right)\right)\left[n_{B}\left(\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{k}}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Changing variables, we then have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)B\left(\boldsymbol{q},\nu\right)n_{B}\left(-\nu+\epsilon_{\boldsymbol{k}}-\epsilon_{\boldsymbol{p}}\right)n_{F}\left(\epsilon_{\boldsymbol{p}}\right)\left(1-n_{F}\left(-\nu+\epsilon_{\boldsymbol{k}}\right)\right)\left[n_{B}\left(-\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{k}}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Therefore, we only need to verify that 
\begin_inset Formula 
\begin{align*}
n_{B}\left(-\nu+\epsilon_{\boldsymbol{k}}-\epsilon_{\boldsymbol{p}}\right)n_{F}\left(\epsilon_{\boldsymbol{p}}\right)\left(1-n_{F}\left(-\nu+\epsilon_{\boldsymbol{k}}\right)\right)\left[n_{B}\left(-\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{k}}\right)\right] & =\\
n_{B}\left(\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)n_{F}\left(\epsilon_{\boldsymbol{k}}\right)\left(1-n_{F}\left(\nu+\epsilon_{\boldsymbol{p}}\right)\right)\left[n_{B}\left(\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{p}}\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
and the proof of the symmetry of 
\begin_inset Formula $P_{\boldsymbol{k}\boldsymbol{p}}$
\end_inset

 would be complete.
 Since mathematica says this is true, we gain confidence that 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)B\left(\boldsymbol{q},\nu\right)n_{B}\left(\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)n_{F}\left(\epsilon_{\boldsymbol{k}}\right)\left(1-n_{F}\left(\nu+\epsilon_{\boldsymbol{p}}\right)\right)\left[n_{B}\left(\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{p}}\right)\right]
\]

\end_inset


\end_layout

