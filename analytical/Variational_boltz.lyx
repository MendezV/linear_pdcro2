\begin_layout Standard
First, we have 
\begin_inset Formula 
\[
\tau^{-1}\left(\boldsymbol{k}\right)=\frac{1}{kT}\frac{1}{-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}}\sum_{\boldsymbol{p}}P_{\boldsymbol{k}\boldsymbol{p}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tau^{-1}\left(\boldsymbol{k}\right) & =\frac{kT\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}{kT\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}\sum_{\boldsymbol{p}}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\epsilon_{\boldsymbol{k}}-\nu\right)\left[n_{B}\left(\epsilon_{\boldsymbol{k}}-\nu\right)+n_{F}\left(-\nu\right)\right]\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{p},\epsilon\right)B\left(\boldsymbol{q},\nu-\epsilon\right)\left[n_{B}\left(\nu-\epsilon\right)+n_{F}\left(-\epsilon\right)\right]\\
 & =-2\Sigma''\left(\boldsymbol{k},\omega=\epsilon_{\boldsymbol{k}}\right)
