\frac{1}{\left(2\pi\right)^{D}}\int_{0}^{2\pi}\left[\int_{0}^{\pi}\delta\left(\frac{\nu}{2ck_{F}}-\cos\varphi_{1}\right)\sin^{D-2}(\varphi_{1})\sin^{D-3}(\varphi_{2})\cdots\sin(\varphi_{D-2})\,d\varphi_{1}\,d\varphi_{2}\cdots d\varphi_{D-2}\right]d\varphi_{D-1}\\
=\overline{S_{D-2}}\frac{1}{2\pi}\int d\varphi_{1}\delta\left(\frac{\nu}{2ck_{F}}-\cos\varphi_{1}\right)\sin^{D-2}\left(\varphi_{1}\right)\\
=\overline{S_{D-2}}\frac{1}{2\pi}\int\sin\left(\varphi_{1}\right)d\varphi_{1}\delta\left(\frac{\nu}{2ck_{F}}-\cos\varphi_{1}\right)\sin^{D-3}\left(\varphi_{1}\right)\\
=\overline{S_{D-2}}\frac{1}{2\pi}\int_{-1}^{1}du\ \delta\left(\frac{\nu}{2ck_{F}}-u\right)\left(1-u^{2}\right)^{\frac{D-3}{2}}\\
\overline{S_{D-1}}\frac{1}{2\pi}\ \theta\left(1-\left|\frac{\nu}{2ck_{F}}\right|\right)\left(1-\left(\frac{\nu}{2ck_{F}}\right)^{2}\right)^{\frac{D-3}{2}}\\
\overline{S_{D-1}}\frac{1}{2\pi}\ \theta\left(2ck_{F}-\left|\nu\right|\right)\left(1-\left(\frac{\nu}{2ck_{F}}\right)^{2}\right)^{\frac{D-3}{2}}
\end{align*}

