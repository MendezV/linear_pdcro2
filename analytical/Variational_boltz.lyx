\begin_layout Subsection*
Phonon kernel
\end_layout

\begin_layout Standard
starting from the collision integral, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
C_{\boldsymbol{k}}=\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
For the kernel we have 
\begin_inset Formula 
\begin{align*}
\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{p}}} & =\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(\delta_{\boldsymbol{p}\boldsymbol{k}'}-\delta_{\boldsymbol{p}\boldsymbol{k}}\right)-\delta_{\boldsymbol{p}\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)+f_{\boldsymbol{k}}\delta_{\boldsymbol{p}\boldsymbol{k}'}\right)\\
\\
 & =\frac{2}{\hbar}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{p},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)+f_{\boldsymbol{k}}\right)\\
 & -\delta_{\boldsymbol{p}\boldsymbol{k}}\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+1-f_{\boldsymbol{k}'}\right)\\
\\
 & =\frac{2}{\hbar}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{p},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)+f\left(\epsilon_{\boldsymbol{k}}\right)\right)\\
 & -\delta_{\boldsymbol{p}\boldsymbol{k}}\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Continuing 
\begin_inset Formula 
\begin{align*}
\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{p}}} & =\frac{2}{\hbar}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{p},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)\left(-1-n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(\epsilon_{\boldsymbol{k}}\right)\right)\\
 & -\frac{2}{\hbar}\delta_{\boldsymbol{p}\boldsymbol{k}}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)\\
\\
 & =-\frac{2}{\hbar}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{p},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)\\
 & -\delta_{\boldsymbol{p}\boldsymbol{k}}\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)\\
\\
 & =\frac{2}{\hbar}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{p}-\boldsymbol{k},\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)\\
 & -\delta_{\boldsymbol{p}\boldsymbol{k}}\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Now we multiply by the factor
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\partial f_{\boldsymbol{p}}}{\partial\epsilon_{\boldsymbol{p}}}
\]

\end_inset


\end_layout

\begin_layout Standard
which is supposed to make this expression for the functional derivative
 of the collision integral symmetric 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
Q_{\boldsymbol{k}\boldsymbol{p}} & =\left(\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{p}}}\right)\frac{\partial f_{\boldsymbol{p}}}{\partial\epsilon_{\boldsymbol{p}}}\\
 & =\frac{\partial f_{\boldsymbol{p}}}{\partial\epsilon_{\boldsymbol{p}}}\frac{2}{\hbar}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{p}-\boldsymbol{k},\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)\\
 & -\delta_{\boldsymbol{p}\boldsymbol{k}}\frac{2}{\hbar}\frac{\partial f_{\boldsymbol{p}}}{\partial\epsilon_{\boldsymbol{p}}}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{p},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{p}-\boldsymbol{k}',\epsilon_{\boldsymbol{p}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{p}}-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We now define 
\begin_inset Formula 
\[
P_{\boldsymbol{p}\boldsymbol{k}}=-kT\frac{2}{\hbar}\frac{\partial f_{\boldsymbol{p}}}{\partial\epsilon_{\boldsymbol{p}}}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{p}-\boldsymbol{k},\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
leaving the diagonal untouched since it is always symmetric under the exchange
 of 
\begin_inset Formula $\boldsymbol{k}$
\end_inset

 and 
\begin_inset Formula $\boldsymbol{p}$
\end_inset

 we want to verify two things: (i) that the off diagonal is symmetric (ii)
 that the off diagonal is related to the sum appearing in the diagonal.
 WIth this two facts proven, we then would have made contact with the sum
 rules that appear in the transport notes.
 
\end_layout

\begin_layout Standard
Let's start by proving the first statement.
 To establish this we first assume inversion symmetry such that 
\begin_inset Formula 
\[
\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{p},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)=\mathcal{B}\left(\boldsymbol{p}-\boldsymbol{k},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
also from the analytic properties of the spectral function 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{p},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)=-\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{p},\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
in the end, we only need to prove that 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\partial f}{\partial\epsilon_{\boldsymbol{p}}}\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
is antisymmetric under the exchange of 
\begin_inset Formula $\boldsymbol{p}$
\end_inset

 and 
\begin_inset Formula $\boldsymbol{k}$
\end_inset

.
 First, we can simplify the above in the following way 
\begin_inset Formula 
\begin{align*}
\frac{\partial f}{\partial\epsilon_{\boldsymbol{p}}}\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right) & =-\frac{1}{kT}f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\varepsilon_{\boldsymbol{p}}\right)\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)\\
 & =-\frac{1}{kT}f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\varepsilon_{\boldsymbol{p}}\right)\right)\left(-1-n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)\\
 & =\frac{1}{kT}n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\varepsilon_{\boldsymbol{p}}\right)\right)\left(\frac{1-f\left(-\epsilon_{\boldsymbol{k}}\right)}{n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)}+1\right)\\
 & =\frac{1}{kT}n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\varepsilon_{\boldsymbol{p}}\right)\right)\left(\frac{f\left(\epsilon_{\boldsymbol{k}}\right)}{n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)}+1\right)\\
 & \text{multiplying and dividing by }1-f\left(\epsilon_{\boldsymbol{k}}\right)\\
 & =\frac{1}{kT}n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)\left(1-f\left(\varepsilon_{\boldsymbol{p}}\right)\right)\frac{\left(\frac{f\left(\epsilon_{\boldsymbol{k}}\right)}{n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)}+1\right)}{\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)}\\
\\
\end{align*}

\end_inset

 
\end_layout

\begin_layout Standard
Now focusing on the last part, we have 
\begin_inset Formula 
\begin{align*}
\frac{f\left(\epsilon_{\boldsymbol{k}}\right)}{n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)}+1 & =\frac{e^{y-z}-1}{1+e^{y}}+1\\
 & =\frac{e^{y-z}-1+1+e^{y}}{1+e^{y}}\\
 & =\frac{\left(1+e^{-z}\right)e^{y}}{1+e^{y}}\\
 & =\frac{\left(1+e^{-z}\right)}{1+e^{-y}}\\
 & =\frac{1-f\left(\varepsilon_{\boldsymbol{k}}\right)}{1-f\left(\varepsilon_{\boldsymbol{p}}\right)}\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
So that 
\begin_inset Formula 
\[
\frac{\partial f}{\partial\epsilon_{\boldsymbol{p}}}\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)=\frac{1}{kT}n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Which is a way more intuitive expression, 
\begin_inset Formula $\boldsymbol{p}$
\end_inset

 is occupied, absorbs a boson and transitions to 
\begin_inset Formula $\boldsymbol{k}$
\end_inset

, which is unocupied, the energy of the boson has to match the difference
 in energies and all is well.
 Furthermore we can prove now that 
\begin_inset Formula 
\[
n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)=-n_{B}\left(\epsilon_{\boldsymbol{p}}-\varepsilon_{\boldsymbol{k}}\right)f\left(\varepsilon_{\boldsymbol{k}}\right)\left(1-f\left(\epsilon_{\boldsymbol{p}}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Starting from 
\begin_inset Formula 
\begin{align*}
n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right) & =-\left(1+n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)\\
 & =-\left(\frac{1}{n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)}+1\right)n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Now focusing on the first term 
\begin_inset Formula 
\begin{align*}
\left(\frac{1}{n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)}+1\right) & =e^{y-z}-1+1\\
 & =e^{\beta\varepsilon_{\boldsymbol{p}}-\beta\epsilon_{\boldsymbol{k}}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
This immediately gives 
\begin_inset Formula 
\[
e^{\beta\varepsilon_{\boldsymbol{p}}-\beta\epsilon_{\boldsymbol{k}}}f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)=f\left(\varepsilon_{\boldsymbol{k}}\right)\left(1-f\left(\epsilon_{\boldsymbol{p}}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
proving that 
\begin_inset Formula 
\[
n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)=-n_{B}\left(\epsilon_{\boldsymbol{p}}-\varepsilon_{\boldsymbol{k}}\right)f\left(\varepsilon_{\boldsymbol{k}}\right)\left(1-f\left(\epsilon_{\boldsymbol{p}}\right)\right).
\]

\end_inset


\end_layout

\begin_layout Standard
With this, we conclude that 
\begin_inset Formula 
\begin{align*}
P_{\boldsymbol{k}\boldsymbol{p}} & =-kT\frac{2}{\hbar}\frac{\partial f_{\boldsymbol{p}}}{\partial\epsilon_{\boldsymbol{p}}}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{p}-\boldsymbol{k},\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)+f\left(-\epsilon_{\boldsymbol{k}}\right)\right)\\
 & =\frac{2}{\hbar}\left|g\left(\boldsymbol{k},\boldsymbol{p}\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{p},\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{p}}\right)f\left(\varepsilon_{\boldsymbol{p}}\right)\left(1-f\left(\epsilon_{\boldsymbol{k}}\right)\right)\\
 & =kTW_{\boldsymbol{k}\boldsymbol{p}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Is symmetric with respect to the momentum interchange.
 This is a general feature given the general properties given above from
 the functional derivatives of the heat kernel.
 This transition probability is the fundamental object in the Boltzmann
 theory as we will see briefly.
 Probably a better convention would have been to switch 
\begin_inset Formula $W$
\end_inset

 and 
\begin_inset Formula $P$
\end_inset

 since 
\begin_inset Formula $P$
\end_inset

 is actually a rate with our definitions and 
\begin_inset Formula $W$
\end_inset

 is actually a probability.
 Where we would usually expect a factor of 
\begin_inset Formula $\frac{2\pi}{\hbar}$
\end_inset

 we get a 
\begin_inset Formula $\frac{2}{\hbar}$
\end_inset

 but we packaged the factor of 
\begin_inset Formula $\pi$
\end_inset

 in the spectral function wich has the normalization with 
\begin_inset Formula 
\[
\int\frac{d\omega}{\pi}
\]

\end_inset


\end_layout

\begin_layout Standard
used consistently throughout to relate the spectral with the retarded funcition.
 Which means that 
\end_layout

\begin_layout Subsection*
Transtion rate
\end_layout

\begin_layout Standard
We then have the definition 
\begin_inset Formula 
\[
Q_{\boldsymbol{k}\boldsymbol{p}}=\left(\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{p}}}\right)\frac{\partial f}{\partial\epsilon_{\boldsymbol{p}}}
\]

\end_inset


\end_layout

\begin_layout Standard
which is symmetric under the exchange of 
\begin_inset Formula $\boldsymbol{k}$
\end_inset

 and 
\begin_inset Formula $\boldsymbol{p}.$
\end_inset

 For the off diagonal elements of this kernel we have the definition
\begin_inset Formula 
\[
Q_{\boldsymbol{k}\boldsymbol{p}}=-\frac{1}{kT}P_{\boldsymbol{k}\boldsymbol{p}}
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $P$
\end_inset

 is supposed to be symmetric, owing to the symmetry of 
\begin_inset Formula $Q.$
\end_inset

 Similarly, we have 
\begin_inset Formula 
\[
Q_{\boldsymbol{k}\boldsymbol{k}}=-\tau_{\boldsymbol{k}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}
\]

\end_inset


\end_layout

\begin_layout Standard
With recalling the definition of 
\begin_inset Formula $\tau$
\end_inset

:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{\boldsymbol{k}}^{-1}=-\left(\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{k}}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Where everything is evaluated at equilibrium since we are working with the
 linearized equation and all the kernels will be used 
\end_layout

\begin_layout Standard
As such we have overall 
\begin_inset Formula 
\[
Q_{\boldsymbol{k}\boldsymbol{p}}=\frac{1}{kT}\left(f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}}\right)\tau_{\boldsymbol{k}}^{-1}\delta_{\boldsymbol{k}\boldsymbol{p}}-P_{\boldsymbol{k}\boldsymbol{p}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
If we have 
\begin_inset Formula 
\[
\tau_{\boldsymbol{k}}^{-1}f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}}\right)=\sum_{\boldsymbol{k}'}P_{\boldsymbol{k}\boldsymbol{k}'}
\]

\end_inset


\end_layout

\begin_layout Standard
Or in other words
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{\boldsymbol{k}}^{-1}=\frac{1}{f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}}\right)}\sum_{\boldsymbol{k}'}P_{\boldsymbol{k}\boldsymbol{k}'}
\]

\end_inset


\end_layout

\begin_layout Standard
then we can write
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Q_{\boldsymbol{k}\boldsymbol{p}}=\frac{1}{kT}\left(\delta_{\boldsymbol{k}\boldsymbol{p}}\sum_{\boldsymbol{k}'}P_{\boldsymbol{k}\boldsymbol{k}'}-P_{\boldsymbol{k}\boldsymbol{p}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
We also have to assume for this that 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{k}}=0
\]

\end_inset


\end_layout

\begin_layout Standard
The definition of 
\begin_inset Formula $Q$
\end_inset

 is useful by choosing a specific parametrization of the distribution function
\begin_inset Formula 
\begin{align*}
F_{\boldsymbol{k}} & =f_{\boldsymbol{k}}+\delta F_{\boldsymbol{k}}\\
 & =f_{\boldsymbol{k}}-\frac{\partial f_{\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Going back to the linearized Boltzmann equation
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
-e\boldsymbol{E}\cdot\boldsymbol{v}_{\boldsymbol{k}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}} & =C_{\boldsymbol{k}}^{0}\\
 & =\sum_{\boldsymbol{q}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{q}}}\delta F_{\boldsymbol{q}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
we see that this entails 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
e\boldsymbol{E}\cdot\boldsymbol{v}_{\boldsymbol{k}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}=\sum_{\boldsymbol{q}}Q_{\boldsymbol{k}\boldsymbol{q}}\phi_{\boldsymbol{q}}
\]

\end_inset


\end_layout

\begin_layout Standard
Where the linearized collision integral can be expanded as 
\begin_inset Formula 
\begin{align*}
C_{\boldsymbol{k}}^{0} & =\sum_{\boldsymbol{q}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{q}}}\delta F_{\boldsymbol{q}}\\
 & =-\sum_{\boldsymbol{q}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{q}}}\frac{\partial f_{\boldsymbol{q}}}{\partial\epsilon_{\boldsymbol{q}}}\phi_{\boldsymbol{q}}\\
 & =-\sum_{\boldsymbol{q}}Q_{\boldsymbol{k}\boldsymbol{q}}\phi_{\boldsymbol{q}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
here we see why the parametrization of 
\begin_inset Formula $\delta F_{\boldsymbol{k}}$
\end_inset

 is more convenient, it leads to the symmetric kernel 
\begin_inset Formula $Q_{\boldsymbol{k}\boldsymbol{q}}$
\end_inset

.Now we use the relation between the kernel 
\begin_inset Formula $Q$
\end_inset

 and the transition probability to simplify the linearized collision integral:
\begin_inset Formula 
\begin{align*}
C_{\boldsymbol{k}}^{0}= & -\sum_{\boldsymbol{q}}Q_{\boldsymbol{k}\boldsymbol{q}}\phi_{\boldsymbol{q}}\\
 & =-\sum_{\boldsymbol{q}}\frac{1}{kT}\left(\delta_{\boldsymbol{k}\boldsymbol{q}}\sum_{\boldsymbol{k}'}P_{\boldsymbol{k}\boldsymbol{k}'}-P_{\boldsymbol{k}\boldsymbol{q}}\right)\phi_{\boldsymbol{q}}\\
 & =-\frac{1}{kT}\left(\sum_{\boldsymbol{k}'}P_{\boldsymbol{k}\boldsymbol{k}'}\phi_{\boldsymbol{k}}-\sum_{\boldsymbol{q}}P_{\boldsymbol{k}\boldsymbol{q}}\phi_{\boldsymbol{q}}\right)\\
 & =-\frac{1}{kT}\sum_{\boldsymbol{q}}P_{\boldsymbol{k}\boldsymbol{q}}\left(\phi_{\boldsymbol{k}}-\phi_{\boldsymbol{q}}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Therefore, we have the equation
\begin_inset Formula 
\[
e\boldsymbol{E}\cdot\boldsymbol{v}_{\boldsymbol{k}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}=\frac{1}{kT}\sum_{\boldsymbol{q}}P_{\boldsymbol{k}\boldsymbol{q}}\left(\phi_{\boldsymbol{k}}-\phi_{\boldsymbol{q}}\right)
\]

\end_inset


\end_layout

\begin_layout Section*
Variational principle
\end_layout

\begin_layout Standard
The integral equation above can be solved numerically on a grid, however
 we also have an analytical tool at hand.
 We can use the fact that the functional 
\begin_inset Formula $W\left[F\right]$
\end_inset

 is extremal.
 We will continue to work with the linearized equation in what follows.
 We can do the following, starting with the definition 
\begin_inset Formula 
\[
X_{\boldsymbol{k}}=e\boldsymbol{E}\cdot\boldsymbol{v}_{\boldsymbol{k}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}
\]

\end_inset


\end_layout

\begin_layout Standard
and the 
\begin_inset Formula $L_{2}$
\end_inset

 inner product in momentum space, we have that the rate of entropy production,
 will be given by 
\begin_inset Formula 
\begin{align*}
\boldsymbol{J}\cdot\boldsymbol{E} & =\frac{-e}{V}\left(\sum_{\boldsymbol{q}}\delta F_{\boldsymbol{q}}^{*}\boldsymbol{v}\left(\boldsymbol{q}\right)\right)\cdot\boldsymbol{E}\\
 & =\frac{e}{V}\left(\sum_{\boldsymbol{q}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}\phi_{\boldsymbol{q}}\boldsymbol{v}\left(\boldsymbol{q}\right)\right)\cdot\boldsymbol{E}\\
 & =\frac{1}{V}\sum_{\boldsymbol{q}}\phi_{\boldsymbol{q}}X_{\boldsymbol{q}}\\
 & =\frac{1}{V}\left(\phi|X\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Where we defined the inner product in momentum space similar to with Dirac
 notation.
 When 
\begin_inset Formula $\phi$
\end_inset

 is a solution to the Boltzmann equation we also have 
\begin_inset Formula 
\[
X_{\boldsymbol{k}}=\sum_{\boldsymbol{p}}Q_{\boldsymbol{k}\boldsymbol{p}}\phi_{\boldsymbol{p}}
\]

\end_inset


\end_layout

\begin_layout Standard
so we have the natural bilinear 
\begin_inset Formula 
\begin{align*}
\boldsymbol{J}\cdot\boldsymbol{E} & =\frac{1}{V}\sum_{\boldsymbol{q}\boldsymbol{p}}\phi_{\boldsymbol{q}}Q_{\boldsymbol{q}\boldsymbol{p}}\phi_{\boldsymbol{p}}\\
 & =\frac{(\phi|Q|\phi)}{V}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Because of the special symmetric structure of 
\begin_inset Formula $Q$
\end_inset

 and its relation to the transition probability, we also have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\boldsymbol{J}\cdot\boldsymbol{E} & =\frac{1}{VkT}\sum_{\boldsymbol{q}\boldsymbol{p}}\phi_{\boldsymbol{q}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\phi_{\boldsymbol{q}}-\phi_{\boldsymbol{p}}\right)\\
 & =\frac{1}{2VkT}\left(\sum_{\boldsymbol{q}\boldsymbol{p}}\phi_{\boldsymbol{q}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\phi_{\boldsymbol{q}}-\phi_{\boldsymbol{p}}\right)+\sum_{\boldsymbol{p}\boldsymbol{q}}P_{\boldsymbol{q}\boldsymbol{p}}\left(\phi_{\boldsymbol{p}}-\phi_{\boldsymbol{q}}\right)\phi_{\boldsymbol{p}}\right)\\
 & =\frac{1}{2VkT}\sum_{\boldsymbol{q}\boldsymbol{p}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\phi_{\boldsymbol{q}}-\phi_{\boldsymbol{p}}\right)^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where whe just relabeled the momentum indices and used the symmetry of 
\begin_inset Formula $P$
\end_inset

 in the second line.
 Sometimes in the literature things are written such that
\begin_inset Formula 
\[
\frac{1}{2VkT}\sum_{\boldsymbol{q}\boldsymbol{p}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\phi_{\boldsymbol{q}}-\phi_{\boldsymbol{p}}\right)^{2}=\frac{(\phi|P|\phi)}{V}
\]

\end_inset


\end_layout

\begin_layout Standard
to avoid explaining what 
\begin_inset Formula $Q$
\end_inset

 is and save space.
 Now we use that the rate of entropy production at fixed field is maximal
 for solutions to the Boltzmann equation, this generates a variational principle
 for the conductivity since:
\begin_inset Formula 
\begin{align*}
\boldsymbol{J}\cdot\boldsymbol{E} & =\sigma E^{2}\\
 & =\frac{(\phi|Q|\phi)}{V}\\
 & \geq\frac{\left|(\psi|Q|\phi)\right|^{2}}{V\left|(\psi|Q|\psi)\right|}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
This last inequality is just the Cauchy-Schwartz inequality reexpressed
 where we define
\begin_inset Formula 
\[
\sqrt{Q}|\phi)=|v)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sqrt{Q}|\psi)=|u)
\]

\end_inset


\end_layout

\begin_layout Standard
then
\begin_inset Formula 
\[
\left|(u|v)\right|^{2}\leq(v|v)(u|u)
\]

\end_inset


\end_layout

\begin_layout Standard
for an arbitrary function of momentum 
\begin_inset Formula $\psi_{\boldsymbol{k}}$
\end_inset

.
 Using the fact that 
\begin_inset Formula $\phi$
\end_inset

 is a solution to the Boltzmann equation, we have 
\begin_inset Formula 
\[
\frac{(\phi|Q|\phi)}{V}\geq\frac{\left|(\psi|X)\right|^{2}}{V\left|(\psi|Q|\psi)\right|}.
\]

\end_inset


\end_layout

\begin_layout Standard
Using Ohm's law we have the variational principle
\begin_inset Formula 
\[
\sigma\geq\frac{\left|(\psi|X)\right|^{2}}{E^{2}V\left|(\psi|Q|\psi)\right|}
\]

\end_inset


\end_layout

\begin_layout Standard
In terms of the resistivity, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho\leq\frac{E^{2}V\left|(\psi|Q|\psi)\right|}{\left|(\psi|X)\right|^{2}}.
\]

\end_inset


\end_layout

\begin_layout Standard
So the resistivity minimizes the rate of entropy production at fixed current.
 Plugging everything explicitly, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\rho & \leq\frac{\frac{1}{2kT}\sum_{\boldsymbol{q}\boldsymbol{p}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\psi_{\boldsymbol{q}}-\psi_{\boldsymbol{p}}\right)^{2}}{\frac{1}{E^{2}V}\left|\sum_{\boldsymbol{q}}e\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}\psi_{\boldsymbol{q}}\boldsymbol{v}\left(\boldsymbol{q}\right)\cdot\boldsymbol{E}\right|^{2}}\\
 & =\frac{\frac{V}{2kT}\sum_{\boldsymbol{q}\boldsymbol{p}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\psi_{\boldsymbol{q}}-\psi_{\boldsymbol{p}}\right)^{2}}{\left|\sum_{\boldsymbol{q}}e\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}\psi_{\boldsymbol{q}}\boldsymbol{v}\left(\boldsymbol{q}\right)\cdot\boldsymbol{n}\right|^{2}}=\rho_{\text{trial}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $\boldsymbol{n}$
\end_inset

 is the unit vector which determines the direction of the electric field.
 
\end_layout

\begin_layout Subsection*
relaxation time approximation
\end_layout

\begin_layout Standard
for the relaxation time approximation we chose the ansatz 
\begin_inset Formula $\psi_{\boldsymbol{q}}=-e\boldsymbol{v}_{\boldsymbol{q}}\cdot\boldsymbol{E}\tau_{\text{tr}}$
\end_inset

.
 The physical interpretation of this is that the distribution equillibrates
 to a shifted distribution in momentum by a constant given by 
\begin_inset Formula 
\[
\delta\boldsymbol{k}=\dot{\boldsymbol{k}}\tau
\]

\end_inset

such that 
\begin_inset Formula $\tau$
\end_inset

 is a momentum relaxation rate.
 Then, if we assume that the shifted distribution in the presence of the
 field is given by the original distribution displaced in momentum space,
 we have
\begin_inset Formula 
\[
f\left(\boldsymbol{k}-\dot{\boldsymbol{k}}\tau_{tr}\right)\sim f\left(\boldsymbol{k}\right)-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\boldsymbol{v}_{\boldsymbol{k}}\cdot\dot{\boldsymbol{k}}\tau
\]

\end_inset


\end_layout

\begin_layout Standard
with the acceleration determined by the field
\begin_inset Formula 
\[
\dot{\boldsymbol{k}}=-e\boldsymbol{E}
\]

\end_inset


\end_layout

\begin_layout Standard
so we have 
\begin_inset Formula 
\begin{align*}
f\left(\boldsymbol{k}-\dot{\boldsymbol{k}}\tau_{tr}\right) & \sim f\left(\boldsymbol{k}\right)-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\left(-e\boldsymbol{v}_{\boldsymbol{k}}\cdot\boldsymbol{E}\tau\right)\\
 & =f\left(\boldsymbol{k}\right)-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\psi_{\boldsymbol{k}}.
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
With this ansatz, we find
\begin_inset Formula 
\[
\rho_{\text{trial}}=\frac{\frac{V}{2kT}\sum_{\boldsymbol{q}\boldsymbol{p}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\boldsymbol{v}_{\boldsymbol{q}}\cdot\boldsymbol{n}-\boldsymbol{v}_{\boldsymbol{p}}\cdot\boldsymbol{n}\right)^{2}}{e^{2}\left|\sum_{\boldsymbol{q}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}\left(\boldsymbol{v}\left(\boldsymbol{q}\right)\cdot\boldsymbol{n}\right)^{2}\right|^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
If we define the ratio
\begin_inset Formula 
\[
\left(\frac{n}{m}\right)_{nn}=-\frac{1}{V}\sum_{\boldsymbol{q}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}\left(\boldsymbol{v}\left(\boldsymbol{q}\right)\cdot\boldsymbol{n}\right)^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
the ratio of the density to the band mass in the direction of the unit vector
 
\begin_inset Formula $n$
\end_inset

, then we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho_{\text{trial}}=\frac{\frac{1}{kT}\sum_{\boldsymbol{q}\boldsymbol{p}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\boldsymbol{v}_{\boldsymbol{q}}\cdot\boldsymbol{n}-\boldsymbol{v}_{\boldsymbol{p}}\cdot\boldsymbol{n}\right)^{2}}{e^{2}\left(\frac{n}{m}\right)_{nn}\sum_{\boldsymbol{q}}2\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}\right)\left(\boldsymbol{v}\left(\boldsymbol{q}\right)\cdot\boldsymbol{n}\right)^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
comparing ti the drude formula, we have 
\begin_inset Formula 
\[
\tau_{\text{tr}}^{-1}=\frac{\frac{1}{kT}\sum_{\boldsymbol{q}\boldsymbol{p}}P_{\boldsymbol{p}\boldsymbol{q}}\left(\boldsymbol{v}_{\boldsymbol{q}}\cdot\boldsymbol{n}-\boldsymbol{v}_{\boldsymbol{p}}\cdot\boldsymbol{n}\right)^{2}}{\sum_{\boldsymbol{q}}2\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}\right)\left(\boldsymbol{v}\left(\boldsymbol{q}\right)\cdot\boldsymbol{n}\right)^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
in the special case of cubic symmetry and a field applied along the 
\begin_inset Formula $x$
\end_inset

 direction we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{\text{tr}}^{-1}=\frac{\frac{1}{kT}\sum_{\boldsymbol{q}\boldsymbol{p}}P_{\boldsymbol{p}\boldsymbol{q}}\left(v_{\boldsymbol{q}x}-v_{\boldsymbol{p}x}\right)^{2}}{\sum_{\boldsymbol{q}}2\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{q}}}\right)v_{\boldsymbol{q}x}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
and 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho_{\text{trial}}=\frac{\tau_{\text{tr}}^{-1}}{e^{2}\left(\frac{n}{m}\right)_{xx}}
\]

\end_inset


\end_layout

\begin_layout Subsection*
Averaged single particle time
\end_layout

\begin_layout Standard
We previously had the result
\begin_inset Formula 
\[
\tau_{\boldsymbol{k}}^{-1}=\frac{1}{f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}}\right)}\sum_{\boldsymbol{k}'}P_{\boldsymbol{k}\boldsymbol{k}'}
\]

\end_inset


\end_layout

\begin_layout Standard
when discussing the transition rate.
 This, again, is the time scale on which the deviation of the distribution
 on a single momentum state relaxes back to equillibrium instead of the
 transport time discussed above which is the time scale on which momentum
 itself relaxes back to equillibrium.
 It is common to then average this time by a thermal distribution as follows
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tau_{qp}^{-1} & =\frac{\sum_{\boldsymbol{k}}\tau_{\boldsymbol{k}}^{-1}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}\\
 & =\frac{\frac{1}{kT}\sum_{\boldsymbol{k}'\boldsymbol{k}}P_{\boldsymbol{k}\boldsymbol{k}'}}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
note here the similarities and differences with the transport time defined
 above.
 This can also be related to the single particle rate averaged over the
 density of states
\begin_inset Formula 
\[
\tau_{qp}^{-1}\left(\epsilon\right)=\frac{\sum_{\boldsymbol{k}}\tau_{\boldsymbol{k}}^{-1}\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
We can relate the wto definitions by 
\begin_inset Formula 
\[
\tau_{qp}^{-1}=\int_{-\infty}^{\infty}d\epsilon\ \tau_{qp}^{-1}\left(\epsilon\right)\left(-\frac{\partial f}{\partial\epsilon}\right).
\]

\end_inset


\end_layout

\begin_layout Standard
Near zero temperature 
\begin_inset Formula 
\[
\tau_{qp}^{-1}\left(0\right)\sim\tau_{qp}^{-1}.
\]

\end_inset


\end_layout

\begin_layout Section*
Phonon times
\end_layout

\begin_layout Subsection*
quasiparticle time
\end_layout

\begin_layout Standard
We will now calculate the phonon times from the definitions above.
 This will be done using our previous calculation of 
\begin_inset Formula $P_{\boldsymbol{k}\boldsymbol{k}'}$
\end_inset

 so that 
\begin_inset Formula 
\begin{align*}
\tau_{qp}^{-1}\left(\epsilon\right) & =\frac{\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}\\
 & =\frac{\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}\\
 & =\frac{\frac{2\pi}{\hbar}\int_{-\infty}^{\infty}d\nu\ \sum_{\boldsymbol{k}\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)\delta\left(\nu-\epsilon_{\boldsymbol{k}'}\right)\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon-\nu\right)\left(n_{B}\left(\epsilon-\nu\right)+f\left(-\nu\right)\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Using some of the usual tricks with 
\begin_inset Formula 
\[
\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon-\nu\right)=\mathcal{B}^{-}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon-\nu\right)-\mathcal{B}^{+}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon-\nu\right)
\]

\end_inset


\end_layout

\begin_layout Standard
we find
\begin_inset Formula 
\[
\tau_{qp}^{-1}\left(\epsilon\right)=\frac{\frac{2\pi}{\hbar}\int_{-\infty}^{\infty}d\nu\ \sum_{\boldsymbol{k}\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon-\nu-\epsilon_{\boldsymbol{k}'}\right)\mathcal{B}^{-}\left(\boldsymbol{k}-\boldsymbol{k}',\nu\right)\left(2n_{B}\left(\nu\right)+f\left(\nu-\epsilon\right)+f\left(\nu+\epsilon\right)\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
Defining 
\begin_inset Formula 
\[
\frac{\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon-\nu-\epsilon_{\boldsymbol{k}'}\right)\mathcal{B}^{-}\left(\boldsymbol{k}-\boldsymbol{k}',\nu\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}=\alpha_{\boldsymbol{k}}F\left(\epsilon,\nu\right)
\]

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula 
\[
\sum_{\boldsymbol{k}}\alpha_{\boldsymbol{k}}F\left(\epsilon,\nu\right)=\alpha F\left(\epsilon,\nu\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{qp}^{-1}\left(\epsilon\right)=\frac{2\pi}{\hbar}\int_{0}^{\infty}d\nu\ \alpha F\left(\epsilon,\nu\right)\left(2n_{B}\left(\nu\right)+f\left(\nu-\epsilon\right)+f\left(\nu+\epsilon\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
neglecting the 
\begin_inset Formula $\epsilon$
\end_inset

 dependence in 
\begin_inset Formula $\alpha F\left(\epsilon,\nu\right)$
\end_inset

, by setting 
\begin_inset Formula $\alpha F\left(\nu\right)=\alpha F\left(0,\nu\right)$
\end_inset

we finally get 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{qp}^{-1}\left(\epsilon\right)=\frac{2\pi}{\hbar}\int_{0}^{\infty}d\nu\ \alpha F\left(\nu\right)\left(2n_{B}\left(\nu\right)+f\left(\nu-\epsilon\right)+f\left(\nu+\epsilon\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
To get the averaged quasiparticle relaxation rate, we then perform
\begin_inset Formula 
\[
\tau_{qp}^{-1}=\int_{-\infty}^{\infty}d\epsilon\ \tau_{qp}^{-1}\left(\epsilon\right)\left(-\frac{\partial f}{\partial\epsilon}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
In the end, because the dependence is only in the occupation functions we
 only worry about the integral
\begin_inset Formula 
\[
\int_{-\infty}^{\infty}d\epsilon\ \left(-\frac{\partial f}{\partial\epsilon}\right)\left(2n_{B}\left(\nu\right)+f\left(\nu-\epsilon\right)+f\left(\nu+\epsilon\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
There are two types of integrals here 
\begin_inset Formula 
\[
\int_{-\infty}^{\infty}d\epsilon\ \left(-\frac{\partial f}{\partial\epsilon}\right)=1
\]

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula 
\[
\int_{-\infty}^{\infty}d\epsilon\ \left(-\frac{\partial f}{\partial\epsilon}\right)f\left(\nu\pm\epsilon\right)=n_{B}\left(\nu\right)^{2}+n_{B}\left(\nu\right)\left(n_{B}\left(\nu\right)+1\right)\left(\nu-1\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Such that we have
\begin_inset Formula 
\begin{align*}
\int_{-\infty}^{\infty}d\epsilon\ \left(-\frac{\partial f}{\partial\epsilon}\right)\left(2n_{B}\left(\nu\right)+f\left(\nu-\epsilon\right)+f\left(\nu+\epsilon\right)\right) & =2\left(n_{B}\left(\nu\right)+n_{B}\left(\nu\right)^{2}+n_{B}\left(\nu\right)\left(n_{B}\left(\nu\right)+1\right)\left(\nu-1\right)\right)\\
 & =2\frac{\beta\nu}{4}\text{csch}\left(\frac{\beta\nu}{2}\right)^{2}\\
 & =\frac{2}{\beta\nu}\left[\frac{\beta\nu}{2}\text{csch}\left(\frac{\beta\nu}{2}\right)\right]^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
in the end, we have 
\begin_inset Formula 
\begin{align*}
\tau_{qp}^{-1} & =\int_{-\infty}^{\infty}d\epsilon\ \tau_{qp}^{-1}\left(\epsilon\right)\left(-\frac{\partial f}{\partial\epsilon}\right)\\
 & =\frac{4\pi}{\hbar\beta}\int_{0}^{\infty}d\nu\ \frac{\alpha F\left(\nu\right)}{\nu}\left[\frac{\beta\nu}{2}\text{csch}\left(\frac{\beta\nu}{2}\right)\right]^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection*
Transport time
\end_layout

\begin_layout Standard
we can use again the formulas derived above with very small modifications
 due to the similar structure of the quasiparticle time and the transport
 time in the relaxation time approximation
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tilde{\tau}_{tr}^{-1}\left(\epsilon\right) & =\frac{\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}\boldsymbol{k}'}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(v_{\boldsymbol{k}x}-v_{\boldsymbol{k}'x}\right)^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}x}^{2}}\\
 & =\frac{\frac{2\pi}{\hbar}\int_{-\infty}^{\infty}d\nu\ \sum_{\boldsymbol{k}\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(v_{\boldsymbol{k}x}-v_{\boldsymbol{k}'x}\right)^{2}\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)\delta\left(\nu-\epsilon_{\boldsymbol{k}'}\right)\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon-\nu\right)\left(-\frac{\partial f}{\partial\epsilon}\right)\left(n_{B}\left(\epsilon-\nu\right)+f\left(-\nu\right)\right)}{\sum_{\boldsymbol{k}}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)2v_{\boldsymbol{k}x}^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
using then the tricks above we get 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\epsilon\right)=\frac{\frac{2\pi}{\hbar}\int_{-\infty}^{\infty}d\nu\ \sum_{\boldsymbol{k}\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(v_{\boldsymbol{k}x}-v_{\boldsymbol{k}'x}\right)^{2}\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon-\nu-\epsilon_{\boldsymbol{k}'}\right)\mathcal{B}^{-}\left(\boldsymbol{k}-\boldsymbol{k}',\nu\right)\left(-\frac{\partial f}{\partial\epsilon}\right)\left(2n_{B}\left(\nu\right)+f\left(\nu-\epsilon\right)+f\left(\nu+\epsilon\right)\right)}{\sum_{\boldsymbol{k}}2v_{\boldsymbol{k}x}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
Defining 
\begin_inset Formula 
\[
\frac{\sum_{\boldsymbol{k}}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(v_{\boldsymbol{k}x}-v_{\boldsymbol{k}'x}\right)^{2}\delta\left(\epsilon-\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon-\nu-\epsilon_{\boldsymbol{k}'}\right)\mathcal{B}^{-}\left(\boldsymbol{k}-\boldsymbol{k}',\nu\right)}{\sum_{\boldsymbol{k}}2v_{\boldsymbol{k}z}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}=\alpha_{tr\boldsymbol{k}}^{2}F\left(\epsilon,\nu\right)
\]

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula 
\[
\sum_{\boldsymbol{k}}\alpha_{tr\boldsymbol{k}}^{2}F\left(\epsilon,\nu\right)=\alpha_{tr}^{2}F\left(\epsilon,\nu\right)
\]

\end_inset


\end_layout

\begin_layout Standard
neglecting the 
\begin_inset Formula $\epsilon$
\end_inset

 dependence as usual in the 
\begin_inset Formula $\alpha_{tr}^{2}F\left(\epsilon,\nu\right)$
\end_inset

 function, we get 
\end_layout

\begin_layout Standard
we get 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tilde{\tau}_{tr}^{-1}\left(\epsilon\right)=\frac{2\pi}{\hbar}\int_{0}^{\infty}d\nu\ \alpha_{tr}^{2}F\left(\nu\right)\left(2n_{B}\left(\nu\right)+f\left(\nu-\epsilon\right)+f\left(\nu+\epsilon\right)\right)\left(-\frac{\partial f}{\partial\epsilon}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
using now 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\tau_{tr}^{-1}=\int_{-\infty}^{\infty}d\epsilon\ \tilde{\tau}_{tr}^{-1}\left(\epsilon\right).
\]

\end_inset


\end_layout

\begin_layout Standard
finally, averaging over the derivative of the fermi distribution, we get
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\tau_{tr}^{-1} & =\frac{4\pi}{\hbar\beta}\int_{0}^{\infty}d\nu\ \frac{\alpha_{tr}^{2}F\left(\nu\right)}{\nu}\left[\frac{\beta\nu}{2}\text{csch}\left(\frac{\beta\nu}{2}\right)\right]^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
From this, we can then continue by calculating the 
\begin_inset Formula $\alpha_{tr}^{2}F\left(\epsilon,\nu\right)$
\end_inset

 function for instance in the Debye model with a spherical fermi surface,
 this would give in the end the Bloch-Gruniessen law.
 Where the transport time transitions to a 
\begin_inset Formula $T^{5}$
\end_inset

 temperature dependence in 3D below 
\begin_inset Formula $T_{BG}=v_{s}k_{F}$
\end_inset

 when the phonons are not able to be scattered.
 
\end_layout

\begin_layout Subsection*
Optical mode
\end_layout

\begin_layout Standard
We start by calculating the 
\begin_inset Formula $\alpha_{tr}^{2}F\left(\nu\right)$
\end_inset

 function
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(v_{\boldsymbol{k}x}-v_{\boldsymbol{k}'x}\right)^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{k}'}\right)\mathcal{B}^{-}\left(\boldsymbol{k}-\boldsymbol{k}',\nu\right)}{\sum_{\boldsymbol{k}}2v_{\boldsymbol{k}z}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}=\alpha_{tr\boldsymbol{k}}^{2}F\left(\nu\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Modeling the dispersion as 
\begin_inset Formula 
\[
\epsilon_{\boldsymbol{k}}=\epsilon_{\parallel\boldsymbol{k}}-2t_{\perp}\cos k_{z}a_{z}
\]

\end_inset


\end_layout

\begin_layout Standard
which gives the velocity
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
v_{\boldsymbol{k}z}=2t_{\perp}a_{z}\sin k_{z}a_{z}
\]

\end_inset


\end_layout

\begin_layout Standard
and regarding a dispersionless phonon, we get
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\sum_{\boldsymbol{k}}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}v_{\boldsymbol{k}z}^{2}\delta\left(\epsilon_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{k}'}\right)\mathcal{B}^{-}\left(\nu\right)}{\sum_{\boldsymbol{k}}v_{\boldsymbol{k}z}^{2}\left(-\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}\right)}=\alpha_{tr\boldsymbol{k}'}^{2}F\left(\nu\right)
\]

\end_inset


\end_layout

\begin_layout Standard
With the coupling 
\begin_inset Formula 
\[
g\left(\boldsymbol{k},\boldsymbol{k}'\right)=\alpha\left[2\cos\left(k_{z}a_{z}\right)\right]\left[2\cos\left(k_{z}'a_{z}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
and the spectral function
\end_layout

\begin_layout Standard
\begin_inset Formula 
