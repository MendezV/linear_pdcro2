\begin_layout Section*
Collision integral and its properties for the electron-phonon problem
\end_layout

\begin_layout Standard
For the collision integral we have 
\begin_inset Formula 
\begin{align*}
C_{\boldsymbol{k}} & =-\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+1\right)+\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right)\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(1+n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
simplifying
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
C_{\boldsymbol{k}} & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Using the delta functions 
\begin_inset Formula 
\begin{align*}
C_{\boldsymbol{k}} & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(-\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)-f_{\boldsymbol{k}'}+f_{\boldsymbol{k}}+f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right)\right)\\
\\
 & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(-\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}}\right)\right)\\
\\
 & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)-\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The collision integral can be compactly expressed as
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
C_{\boldsymbol{k}}=\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)-\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Even more compactly, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
B\left(\boldsymbol{k},\nu\right) & =\frac{\pi\hbar}{2M\omega_{\boldsymbol{k}}}\left(\delta\left(\nu+\omega_{\boldsymbol{k}}\right)-\delta\left(\nu-\omega_{\boldsymbol{k}}\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
so that 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
D\left(\bm{q},\omega\right)=\int_{-\infty}^{\infty}\frac{B\left(\bm{q},\omega'\right)}{\omega'-\omega}\frac{d\omega'}{\pi}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula 
\begin{align*}
D''\left(\bm{q},\omega+i\delta\right) & =\int_{-\infty}^{\infty}\pi\delta\left(\omega'-\omega\right)B\left(\bm{q},\omega'\right)\frac{d\omega'}{\pi}\\
 & =B\left(\bm{q},\omega\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
And we verify for the free function that 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
D_{ret}\left(\bm{q},\omega\right) & =\frac{\hbar}{2M\omega_{\boldsymbol{k}}}\left(\frac{2\omega_{\boldsymbol{k}}}{\omega^{2}-\omega_{\boldsymbol{k}}^{2}}\right)\\
 & =\frac{\hbar}{2M\omega_{\boldsymbol{k}}}\left(\frac{1}{\omega+i\delta-\omega_{\boldsymbol{k}}}-\frac{1}{\omega+i\delta+\omega_{\boldsymbol{k}}}\right)\\
 & =\frac{\pi\hbar}{2M\omega_{\boldsymbol{k}}}\int\frac{d\nu}{\pi}\left(\frac{\delta\left(\nu-\omega_{\boldsymbol{k}}\right)}{\omega+i\delta-\nu}-\frac{\delta\left(\nu+\omega_{\boldsymbol{k}}\right)}{\omega+i\delta-\nu}\right)\\
 & =\frac{\pi\hbar}{2M\omega_{\boldsymbol{k}}}\int\frac{d\nu}{\pi}\frac{1}{\omega+i\delta-\nu}\left(\delta\left(\nu-\omega_{\boldsymbol{k}}\right)-\delta\left(\nu+\omega_{\boldsymbol{k}}\right)\right)\\
 & =\frac{\pi\hbar}{2M\omega_{\boldsymbol{k}}}\int\frac{d\nu}{\pi}\frac{1}{\nu-\left(\omega+i\delta\right)}\left(\delta\left(\nu+\omega_{\boldsymbol{k}}\right)-\delta\left(\nu-\omega_{\boldsymbol{k}}\right)\right)\\
 & =\int\frac{d\nu}{\pi}\frac{B\left(\bm{q},\nu\right)}{\nu-\left(\omega+i\delta\right)}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
this imaginary time propagator is the one that results when we take the
 defintion of the retarded greens function obtained by analytically extending
 the imaginary time greens function
\begin_inset Formula 
\[
D\left(\bm{q},\tau\right)=-\left\langle T_{\tau}\varphi_{\boldsymbol{q}}\left(\tau\right)\varphi_{-\boldsymbol{q}}\left(0\right)\right\rangle 
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
B\left(\bm{q},\nu\right)=\frac{\pi\hbar}{2M\omega_{\boldsymbol{k}}}\left(\delta\left(\nu+\omega_{\boldsymbol{k}}\right)-\delta\left(\nu-\omega_{\boldsymbol{k}}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $D_{ret}$
\end_inset

 corresponds to the comutator of the phonon fields and not the direct correlatio
n function per se.
 
\end_layout

\begin_layout Standard
we also have 
\begin_inset Formula 
\[
\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}=\frac{\hbar\alpha^{2}\left(\boldsymbol{k}-\boldsymbol{k}'\right)^{2}}{2M\omega_{\boldsymbol{k}-\boldsymbol{k}'}}
\]

\end_inset


\end_layout

\begin_layout Standard
if we define 
\begin_inset Formula 
\[
g\left(\boldsymbol{k},\boldsymbol{k}'\right)=\alpha\left|\boldsymbol{k}-\boldsymbol{k}'\right|
\]

\end_inset


\end_layout

\begin_layout Standard
and
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
C_{\boldsymbol{k}}=\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Subsection*
Collision integral vanishes at equillibrium
\end_layout

\begin_layout Standard
The cancellation must happen between the in and out parts of the collision
 integral since there is on average zero changes on the state.
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
C_{\boldsymbol{k}} & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right)\right)\\
\\
 & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}\right)+f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right)\right)\\
\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We start by simplifying 
\begin_inset Formula 
\begin{align*}
\left(f_{y}-f_{z}\right)n_{z-y} & =\left(\frac{1}{e^{y}+1}-\frac{1}{e^{z}+1}\right)\frac{1}{e^{z-y}-1}\\
 & =f_{y}f_{z}\frac{e^{z}-e^{y}}{e^{z-y}-1}\\
 & =e^{y}f_{y}f_{z}\\
 & =\left(1-f_{y}\right)f_{z}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
so we have
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)=f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
at equilibrium.
 
\end_layout

\begin_layout Standard
Furthermore, we also have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\left(f_{y}-f_{z}\right)n_{z-y} & =\left(\frac{1}{e^{y}+1}-\frac{1}{e^{z}+1}\right)\frac{1}{e^{y-z}-1}\\
 & =f_{y}f_{z}\frac{e^{z}-e^{y}}{e^{y-z}-1}\\
 & =-e^{z}f_{y}f_{z}\\
 & =-\left(1-f_{z}\right)f_{y}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
so we have 
\begin_inset Formula 
\[
\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}\right)=-f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
so we verify that the collision integral vanishes at equilibrium, since
 the coefficients in front of the delta functions cancel.
 We curiously have the following statistical transmutation
\begin_inset Formula 
\[
n_{B}\left(\epsilon_{\boldsymbol{k}'}-\varepsilon_{\boldsymbol{k}}\right)=\frac{f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right)}{f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)-f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right)}
\]

\end_inset


\end_layout

\begin_layout Subsection*
Linearized collision integral for phonons
\end_layout

\begin_layout Standard
Linearizing the collision integral we have 
\begin_inset Formula 
\[
f_{\boldsymbol{k}}=n_{F\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}
\]

\end_inset


\end_layout

\begin_layout Standard
then 
\begin_inset Formula 
\begin{align*}
f_{\boldsymbol{k}'}\left(1-f_{\boldsymbol{k}}\right) & =\left(n_{F\boldsymbol{k}'}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)\left(1-n_{F\boldsymbol{k}}+\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\right)\\
 & =n_{F\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)+n_{F\boldsymbol{k}'}\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula 
\begin{align*}
f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right) & =n_{F\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)-\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)+n_{F\boldsymbol{k}}\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula 
\[
\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)=n_{F\boldsymbol{k}'}-n_{F\boldsymbol{k}}+\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}
\]

\end_inset


\end_layout

\begin_layout Standard
Since the collision integral vanishes at equillibrium, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
C_{\boldsymbol{k}}^{0} & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)-n_{F\boldsymbol{k}}\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)+n_{F\boldsymbol{k}'}\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Expressing things in terms of the distribution function
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
C_{\boldsymbol{k}}^{0} & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)-n_{F\boldsymbol{k}}\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(-\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)-\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)+n_{F\boldsymbol{k}'}\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\right)\\
 & \text{property of }n(-x)\\
 & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)-n_{F\boldsymbol{k}}\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(-\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}n_{F\boldsymbol{k}}-\left(1-n_{F\boldsymbol{k}'}\right)\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\right)\\
\\
 & \text{factorizing the coefficient of deltas}\\
 & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left[\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)-\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\right]\left(\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)-n_{F\boldsymbol{k}}\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)\\
 & \text{using def of phonon spectral funct}\\
 & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(\left(\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}-\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+\frac{\partial n_{F\boldsymbol{k}}}{\partial\epsilon_{\boldsymbol{k}}}\phi_{\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)-n_{F\boldsymbol{k}}\frac{\partial n_{F\boldsymbol{k}'}}{\partial\epsilon_{\boldsymbol{k}'}}\phi_{\boldsymbol{k}'}\right)\\
 & \text{taking derivatives explicitly (minus in front)}\\
 & =-\beta\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(\left(n_{F\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}}\right)\phi_{\boldsymbol{k}}-n_{F\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}'}\right)\phi_{\boldsymbol{k}'}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+n_{F\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}}\right)\phi_{\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)-n_{F\boldsymbol{k}}n_{F\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}'}\right)\phi_{\boldsymbol{k}'}\right)\\
 & \text{factoring out the specific combination of occ funcs}\\
 & =-\beta\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)n_{F\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(\frac{n_{F\boldsymbol{k}}}{n_{F\boldsymbol{k}'}}\phi_{\boldsymbol{k}}-\frac{\left(1-n_{F\boldsymbol{k}'}\right)}{\left(1-n_{F\boldsymbol{k}}\right)}\phi_{\boldsymbol{k}'}+\phi_{\boldsymbol{k}}\frac{n_{F\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)}{n_{F\boldsymbol{k}'}n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)}-\frac{n_{F\boldsymbol{k}}\left(1-n_{F\boldsymbol{k}'}\right)}{\left(1-n_{F\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)}\phi_{\boldsymbol{k}'}\right)\\
 & \text{factorizing }\phi's\\
 & =-\beta\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)n_{F\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(\frac{n_{F\boldsymbol{k}}}{n_{F\boldsymbol{k}'}}\left(1+\frac{\left(1-n_{F\boldsymbol{k}'}\right)}{n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)}\right)\phi_{\boldsymbol{k}}-\frac{\left(1-n_{F\boldsymbol{k}'}\right)}{\left(1-n_{F\boldsymbol{k}}\right)}\left(1+\frac{n_{F\boldsymbol{k}}}{n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)}\right)\phi_{\boldsymbol{k}'}\right)\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Now we simplify each of these terms individually
\begin_inset Formula 
\begin{align*}
1+\frac{\left(1-n_{F\boldsymbol{k}'}\right)}{n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)} & =1+\frac{e^{y}\left(e^{z-y}-1\right)}{1+e^{y}}\\
 & =1+\frac{\left(e^{z}-e^{y}\right)}{1+e^{y}}\\
 & =\frac{1+e^{y}+\left(e^{z}-e^{y}\right)}{1+e^{y}}\\
 & =\frac{1+e^{z}}{1+e^{y}}=\frac{n_{f\boldsymbol{k}'}}{n_{F\boldsymbol{k}}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Similarly, we have 
\begin_inset Formula 
\begin{align*}
1+\frac{n_{F\boldsymbol{k}}}{n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)} & =1+\frac{\left(e^{z-y}-1\right)}{1+e^{z}}\\
 & =\frac{e^{z}+e^{z-y}}{1+e^{z}}\\
 & =\frac{e^{z}}{e^{y}}\frac{1+e^{y}}{1+e^{z}}=\frac{\left(1-n_{F\boldsymbol{k}}\right)}{\left(1-n_{F\boldsymbol{k}'}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Overall, we have then a linearize collision integral given by 
\begin_inset Formula 
\[
C_{\boldsymbol{k}}^{0}=\beta\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)n_{F\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(\phi_{\boldsymbol{k}'}-\phi_{\boldsymbol{k}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
In terms of a convolution over frequencies we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
C_{\boldsymbol{k}}^{0}=\frac{2}{\hbar kT}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\int d\omega\ \mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\omega\right)n_{F\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)n_{B}\left(\omega\right)\left(\phi_{\boldsymbol{k}'}-\phi_{\boldsymbol{k}}\right)\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega\right)
\]

\end_inset


\end_layout

\begin_layout Standard
which reproduces the Hlubina rice result of 
\begin_inset Formula 
\[
W_{\boldsymbol{k}'\boldsymbol{k}}=\frac{2}{\hbar kT}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)n_{F\boldsymbol{k}'}\left(1-n_{F\boldsymbol{k}}\right)n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)
\]

\end_inset


\end_layout

\begin_layout Subsection*
Single particle rate from the collision integral
\end_layout

\begin_layout Standard
Starting with the single particle rate, we have 
\begin_inset Formula 
\[
\tau_{\boldsymbol{k}}^{-1}=-\left(\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{k}}}\right)_{eq}
\]

\end_inset


\end_layout

\begin_layout Standard
The explanation for this comes from the linearized collision integral for
 the Boltzmann equation
\begin_inset Formula 
\begin{align*}
\frac{dF_{\boldsymbol{k}}}{dt} & =C_{\boldsymbol{k}}\\
 & =\sum_{\boldsymbol{q}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{q}}}\delta F_{\boldsymbol{q}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
cosidering an imbalance in a single momentum state we want to ask how fast
 it relaxes 
\begin_inset Formula 
\begin{align*}
\frac{d\delta F_{\boldsymbol{k}}}{dt} & =C_{\boldsymbol{k}}\\
 & =\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{q}}}\delta F_{\boldsymbol{k}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
so we have exponential relaxation given by
\begin_inset Formula 
\[
\tau_{\boldsymbol{k}}^{-1}=-\left(\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{k}}}\right)_{eq}
\]

\end_inset


\end_layout

\begin_layout Standard
The single particle rate is 
\begin_inset Formula 
\begin{align*}
\left(\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{k}}}\right)_{eq} & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(\delta_{\boldsymbol{k}'\boldsymbol{k}}-1\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)-\left(1-f_{\boldsymbol{k}'}\right)+f_{\boldsymbol{k}}\delta_{\boldsymbol{k}\boldsymbol{k}'}\right)\right)\\
 & +\frac{2\pi}{\hbar}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(\left(\delta_{\boldsymbol{k}'\boldsymbol{k}}-1\right)n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)-f_{\boldsymbol{k}'}+\left(1-f_{\boldsymbol{k}}\right)\delta_{\boldsymbol{k}\boldsymbol{k}'}\right)\\
\\
 & =-\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+1-f_{\boldsymbol{k}'}\right)\right)\\
 & -\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+f_{\boldsymbol{k}'}\right)\\
\\
 & +\sum_{\boldsymbol{k}'}\frac{2\pi}{\hbar}\delta_{\boldsymbol{k}'\boldsymbol{k}}\left|M\left(\boldsymbol{k},\boldsymbol{k}\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f_{\boldsymbol{k}}\right)\right)\\
 & +\sum_{\boldsymbol{k}'}\frac{2\pi}{\hbar}\delta_{\boldsymbol{k}'\boldsymbol{k}}\left|M\left(\boldsymbol{k},\boldsymbol{k}\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(\varepsilon_{\boldsymbol{k}'}-\epsilon_{\boldsymbol{k}}\right)+\left(1-f_{\boldsymbol{k}}\right)\right)\\
\\
 & =-\tau_{\boldsymbol{k}}^{-1}\\
 & +\sum_{\boldsymbol{k}'}\frac{2\pi}{\hbar}\delta_{\boldsymbol{k}'\boldsymbol{k}}\left|M\left(\boldsymbol{k},\boldsymbol{k}\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f_{\boldsymbol{k}}\right)\right)\\
 & +\sum_{\boldsymbol{k}'}\frac{2\pi}{\hbar}\delta_{\boldsymbol{k}'\boldsymbol{k}}\left|M\left(\boldsymbol{k},\boldsymbol{k}\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(-n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)-f_{\boldsymbol{k}}\right)\\
\\
 & =-\tau_{\boldsymbol{k}}^{-1}\\
 & +\sum_{\boldsymbol{k}'}\frac{2\pi}{\hbar}\delta_{\boldsymbol{k}'\boldsymbol{k}}\left|M\left(\boldsymbol{k},\boldsymbol{k}\right)\right|^{2}\delta\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(0^{+}\right)+f_{\boldsymbol{k}}\right)\\
 & +\sum_{\boldsymbol{k}'}\frac{2\pi}{\hbar}\delta_{\boldsymbol{k}'\boldsymbol{k}}\left|M\left(\boldsymbol{k},\boldsymbol{k}\right)\right|^{2}\delta\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(-n_{B}\left(0^{+}\right)-f_{\boldsymbol{k}}\right)\\
\\
 & =-\tau_{\boldsymbol{k}}^{-1}\\
\end{align*}

\end_inset

Such that 
\begin_inset Formula 
\begin{align*}
\tau_{\boldsymbol{k}}^{-1} & =\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\left(\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}-\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+1-f_{\boldsymbol{k}'}\right)\right)\\
 & +\frac{2\pi}{\hbar}\sum_{\boldsymbol{k}'}\left|M\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\delta\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}+\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)\left(n_{B}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'}\right)+f_{\boldsymbol{k}'}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Another calculation of the single particle rate starting from the reduced
 form of the collision integral
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
C_{\boldsymbol{k}}=\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(f_{\boldsymbol{k}'}-f_{\boldsymbol{k}}\right)-f_{\boldsymbol{k}}\left(1-f_{\boldsymbol{k}'}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
taking 
\begin_inset Formula 
\begin{align*}
\left(\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{k}}}\right)_{eq} & =\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(\delta_{\boldsymbol{k}\boldsymbol{k}'}-1\right)-\left(1-f_{\boldsymbol{k}'}\right)+f_{\boldsymbol{k}}\delta_{\boldsymbol{k}\boldsymbol{k}'}\right)\\
\\
 & =\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(-1\right)-\left(1-f_{\boldsymbol{k}'}\right)\right)\\
 & +\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\delta_{\boldsymbol{k}\boldsymbol{k}'}+f_{\boldsymbol{k}}\delta_{\boldsymbol{k}\boldsymbol{k}'}\right)\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
since the spectral function has to vanish at zero frequency, we have 
\begin_inset Formula 
\[
\left(\frac{\delta C_{\boldsymbol{k}}}{\delta f_{\boldsymbol{k}}}\right)_{eq}=-\frac{2}{\hbar}\sum_{\boldsymbol{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\mathcal{B}\left(\boldsymbol{k}-\boldsymbol{k}',\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)\left(n_{B}\left(\epsilon_{\boldsymbol{k}}-\varepsilon_{\boldsymbol{k}'}\right)+f\left(-\varepsilon_{\boldsymbol{k}'}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
which coincides with the diagram calculation.
 The 2 comes from the relation between self energy and qp rate and the 
\begin_inset Formula $\hbar$
\end_inset

 comes from the conversion from energy to rate.
 
\end_layout

\begin_layout Section*
Random relations between kernels and stuff
\end_layout

\begin_layout Subsection*
Entropy generation Kernel near minima
\end_layout

\begin_layout Standard
asdf
\end_layout

\begin_layout Standard
We have 
\begin_inset Formula 
\[
W=kT\sum_{\boldsymbol{k}}\text{log}\left(\frac{1}{F_{\boldsymbol{k}}}-1\right)C_{\boldsymbol{k}}
\]

\end_inset


\end_layout

\begin_layout Standard
Taking one functional derivative
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{\delta W}{\delta F_{\boldsymbol{p}}} & =kT\sum_{\boldsymbol{k}}\text{log}\left(\frac{1}{F_{\boldsymbol{k}}}-1\right)\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{p}}}-\frac{\delta F_{\boldsymbol{k}}}{\delta F_{\boldsymbol{p}}}\frac{1}{F_{\boldsymbol{k}}^{2}}\frac{1}{\frac{1}{F_{\boldsymbol{k}}}-1}C_{\boldsymbol{k}}\\
 & =kT\sum_{\boldsymbol{k}}\text{log}\left(\frac{1}{F_{\boldsymbol{k}}}-1\right)\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{p}}}-\delta_{\boldsymbol{k}\boldsymbol{p}}\frac{1}{F_{\boldsymbol{k}}}\frac{1}{1-F_{\boldsymbol{k}}}C_{\boldsymbol{k}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
if we evaluate at the fermi distribution 
\begin_inset Formula 
\begin{align*}
\frac{\delta W}{\delta F_{\boldsymbol{p}}} & =kT\sum_{\boldsymbol{k}}\beta\left(\epsilon_{\boldsymbol{k}}-\mu\right)\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{p}}}\\
 & =\frac{\delta}{\delta F_{\boldsymbol{p}}}\sum_{\boldsymbol{k}}\left(\epsilon_{\boldsymbol{k}}-\mu\right)C_{\boldsymbol{k}}\\
 & =0
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
since collision locally conserve energy and particle number
\begin_inset Formula 
\[
\sum_{\boldsymbol{k}}C_{\boldsymbol{k}}=0
\]

\end_inset


\end_layout

\begin_layout Standard
and 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sum_{\boldsymbol{k}}\epsilon_{\boldsymbol{k}}C_{\boldsymbol{k}}=0
\]

\end_inset


\end_layout

\begin_layout Standard
this follows from the total rate of change of the total number of particles
 and the total rate of change of the total energy of the system.
\end_layout

\begin_layout Standard
Now we take the second derivative 
\begin_inset Formula 
\begin{align*}
\frac{\delta W}{\delta F_{\boldsymbol{p}}\delta F_{\boldsymbol{q}}} & =kT\sum_{\boldsymbol{k}}\text{log}\left(\frac{1}{F_{\boldsymbol{k}}}-1\right)\frac{\delta C}{\delta F_{\boldsymbol{p}}\delta F_{\boldsymbol{q}}}-\delta_{\boldsymbol{k}\boldsymbol{q}}\frac{1}{F_{\boldsymbol{k}}}\frac{1}{1-F_{\boldsymbol{k}}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{p}}}\\
 & -kT\sum_{\boldsymbol{k}}\delta_{\boldsymbol{k}\boldsymbol{p}}\frac{1}{F_{\boldsymbol{k}}}\frac{1}{1-F_{\boldsymbol{k}}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{q}}}-\delta_{\boldsymbol{k}\boldsymbol{p}}\left(\frac{\delta}{\delta F_{\boldsymbol{q}}}\frac{1}{F_{\boldsymbol{k}}}\frac{1}{1-F_{\boldsymbol{k}}}\right)C_{\boldsymbol{k}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Evaluating at equillibrium the first and the last term vanish for the same
 reason as above, we are left with
\begin_inset Formula 
\begin{align*}
-\frac{1}{kT}\frac{\delta W}{\delta F_{\boldsymbol{p}}\delta F_{\boldsymbol{q}}} & =\frac{1}{f_{\boldsymbol{p}}}\frac{1}{1-f_{\boldsymbol{p}}}\frac{\delta C_{\boldsymbol{p}}}{\delta f_{\boldsymbol{q}}}+\frac{1}{f_{\boldsymbol{q}}}\frac{1}{1-f_{\boldsymbol{q}}}\frac{\delta C_{\boldsymbol{q}}}{\delta f_{\boldsymbol{p}}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
So that 
\begin_inset Formula 
\begin{align*}
\frac{1}{2}\frac{\delta W}{\delta F_{\boldsymbol{p}}\delta F_{\boldsymbol{q}}} & =\frac{1}{2}\left(\frac{1}{\partial f_{\boldsymbol{p}}/\partial\epsilon_{\boldsymbol{p}}}\frac{\delta C_{\boldsymbol{p}}}{\delta f_{\boldsymbol{q}}}+\frac{1}{\partial f_{\boldsymbol{q}}/\partial\epsilon_{\boldsymbol{q}}}\frac{\delta C_{\boldsymbol{q}}}{\delta f_{\boldsymbol{p}}}\right)\\
 & \equiv\frac{1}{2}S\left(\boldsymbol{q},\boldsymbol{p}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection*
General results for the Linearized Boltzman eqn
\end_layout

\begin_layout Standard
we start by defining the functional only to second order
\begin_inset Formula 
\begin{align*}
W & =\frac{1}{2}\sum_{\boldsymbol{q}\boldsymbol{p}}\delta F_{\boldsymbol{q}}\frac{\delta W}{\delta F_{\boldsymbol{p}}\delta F_{\boldsymbol{q}}}\delta F_{\boldsymbol{p}}\\
 & =\frac{1}{2}\sum_{\boldsymbol{q}\boldsymbol{p}}\delta F_{\boldsymbol{q}}S\left(\boldsymbol{q},\boldsymbol{p}\right)\delta F_{\boldsymbol{p}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Now we want to minimize this functional at fixed current, which minimizes
 the rate of entropy production.
 At the same time would maximize the rate of entropy production at fixed
 E field (not very clear why to me).
 Optimizing the functional and fixing the current, we have 
\begin_inset Formula 
\[
\frac{\delta}{\delta F_{\boldsymbol{k}}}\left(W-\boldsymbol{\lambda}\cdot\boldsymbol{J}\right)=0
\]

\end_inset


\end_layout

\begin_layout Standard
where the definition of the current in terms of the distribution function
 is given by 
\begin_inset Formula 
\[
\boldsymbol{J}=\frac{e}{V}\sum_{\boldsymbol{q}}\boldsymbol{v}\left(\boldsymbol{q}\right)F_{\boldsymbol{q}}
\]

\end_inset


\end_layout

\begin_layout Standard
this is a key step conceptually.
 Without this additional current term, we know the optimum of the functional
 is the equilibrium distribution.
 The addition of this linear term shifts the minimum slightly.
 
\end_layout

\begin_layout Standard
Taking the derivative we get
\begin_inset Formula 
\[
\frac{\delta}{\delta F_{\boldsymbol{k}}}\boldsymbol{J}=\frac{-e}{V}\boldsymbol{v}\left(\boldsymbol{k}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{\delta W}{\delta F_{\boldsymbol{k}}} & =\frac{1}{2}\sum_{\boldsymbol{q}\boldsymbol{p}}\delta_{\boldsymbol{q}\boldsymbol{k}}S\left(\boldsymbol{q},\boldsymbol{p}\right)\delta F_{\boldsymbol{p}}+\frac{1}{2}\sum_{\boldsymbol{q}\boldsymbol{p}}\delta F_{\boldsymbol{q}}S\left(\boldsymbol{q},\boldsymbol{p}\right)\delta_{\boldsymbol{p}\boldsymbol{k}}\\
 & =\frac{1}{2}\sum_{\boldsymbol{p}}S\left(\boldsymbol{k},\boldsymbol{p}\right)\delta F_{\boldsymbol{p}}+\frac{1}{2}\sum_{\boldsymbol{q}\boldsymbol{p}}\delta F_{\boldsymbol{q}}S\left(\boldsymbol{q},\boldsymbol{k}\right)\\
 & =\sum_{\boldsymbol{p}}S\left(\boldsymbol{k},\boldsymbol{p}\right)\delta F_{\boldsymbol{p}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Overall we find 
\begin_inset Formula 
\[
\sum_{\boldsymbol{p}}S\left(\boldsymbol{k},\boldsymbol{p}\right)\delta F_{\boldsymbol{p}}^{*}=\frac{-e}{V}\boldsymbol{\lambda}\cdot\boldsymbol{v}\left(\boldsymbol{k}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
where the star denotes the value at the saddle point.
 Inserting this back in the functional
\begin_inset Formula 
\begin{align*}
W^{*} & =\frac{1}{2}\sum_{\boldsymbol{q}\boldsymbol{p}}\delta F_{\boldsymbol{q}}^{*}S\left(\boldsymbol{q},\boldsymbol{p}\right)\delta F_{\boldsymbol{p}}^{*}\\
 & =\frac{1}{2}\sum_{\boldsymbol{q}}\delta F_{\boldsymbol{q}}^{*}\left(\frac{-e}{V}\boldsymbol{\lambda}\cdot\boldsymbol{v}\left(\boldsymbol{q}\right)\right)\\
 & =\frac{1}{2}\frac{-e}{V}\boldsymbol{\lambda}\cdot\sum_{\boldsymbol{q}}\delta F_{\boldsymbol{q}}^{*}\boldsymbol{v}\left(\boldsymbol{q}\right)\\
 & =\frac{1}{2}\boldsymbol{\lambda}\cdot\boldsymbol{J}^{*}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Since this functional is supposed to match the rate of entropy production,
 given by 
\begin_inset Formula 
\[
T\dot{S}=V\boldsymbol{E}\cdot\boldsymbol{J}
\]

\end_inset


\end_layout

\begin_layout Standard
we have the expression for the lagrange multiplier.
\begin_inset Formula 
\[
\boldsymbol{\lambda}=2V\boldsymbol{E}.
\]

\end_inset


\end_layout

\begin_layout Standard
We can then relate the kernel of the functional to the Boltzmann equation
\begin_inset Formula 
\[
\frac{dF_{\boldsymbol{k}}}{dt}=C_{\boldsymbol{k}}
\]

\end_inset


\end_layout

\begin_layout Standard
by linearizing this equation, we find 
\begin_inset Formula 
\[
\frac{dF_{\boldsymbol{k}}}{dt}\sim-e\boldsymbol{E}\cdot\boldsymbol{v}_{\boldsymbol{k}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}
\]

\end_inset


\end_layout

\begin_layout Standard
where we only kept terms linear in the field, there is no explicit time
 or space dependence, and because 
\begin_inset Formula $\dot{\boldsymbol{k}}=-e\boldsymbol{E}$
\end_inset

, we only need to retain 
\begin_inset Formula $\nabla_{\boldsymbol{k}}F_{\boldsymbol{k}}=\boldsymbol{v}_{\boldsymbol{k}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}+\mathcal{O}\left(\boldsymbol{E}\right).$
\end_inset

 
\end_layout

\begin_layout Standard
Linearizing the collision operator as well, we find
\begin_inset Formula 
\[
-e\boldsymbol{E}\cdot\boldsymbol{v}_{\boldsymbol{k}}\frac{\partial f}{\partial\epsilon_{\boldsymbol{k}}}=\sum_{\boldsymbol{q}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{q}}}\delta F_{\boldsymbol{q}}
\]

\end_inset


\end_layout

\begin_layout Standard
comparing with 
\begin_inset Formula 
\[
-e\boldsymbol{E}\cdot\boldsymbol{v}_{\boldsymbol{k}}=\frac{1}{2}\sum_{\boldsymbol{p}}S\left(\boldsymbol{k},\boldsymbol{p}\right)\delta F_{\boldsymbol{p}}
\]

\end_inset


\end_layout

\begin_layout Standard
we find
\begin_inset Formula 
\[
\frac{1}{2}S\left(\boldsymbol{k},\boldsymbol{p}\right)=\frac{1}{\partial f_{\boldsymbol{k}}/\partial\epsilon_{\boldsymbol{k}}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{q}}}
\]

\end_inset


\end_layout

\begin_layout Standard
however, we alredy had 
\begin_inset Formula 
\begin{align*}
S\left(\boldsymbol{q},\boldsymbol{p}\right) & =\frac{1}{\partial f_{\boldsymbol{k}}/\partial\epsilon_{\boldsymbol{k}}}\frac{\delta C_{\boldsymbol{k}}}{\delta F_{\boldsymbol{q}}}+\frac{1}{\partial f_{\boldsymbol{p}}/\partial\epsilon_{\boldsymbol{p}}}\frac{\delta C_{\boldsymbol{p}}}{\delta f_{\boldsymbol{q}}}\\
 & =\frac{1}{2}S\left(\boldsymbol{q},\boldsymbol{p}\right)+\frac{1}{\partial f_{\boldsymbol{p}}/\partial\epsilon_{\boldsymbol{p}}}\frac{\delta C_{\boldsymbol{p}}}{\delta f_{\boldsymbol{q}}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
From which we conclude that 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{1}{2}S\left(\boldsymbol{q},\boldsymbol{p}\right) & =\frac{1}{\partial f_{\boldsymbol{q}}/\partial\epsilon_{\boldsymbol{q}}}\frac{\delta C_{\boldsymbol{q}}}{\delta f_{\boldsymbol{p}}}=\frac{1}{\partial f_{\boldsymbol{p}}/\partial\epsilon_{\boldsymbol{p}}}\frac{\delta C_{\boldsymbol{p}}}{\delta f_{\boldsymbol{q}}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
From the symmetry of 
\begin_inset Formula $S\left(\boldsymbol{q},\boldsymbol{p}\right)$
\end_inset

 we conclude that the expression 
\begin_inset Formula 
\[
\frac{1}{\partial f_{\boldsymbol{q}}/\partial\epsilon_{\boldsymbol{q}}}\frac{\delta C_{\boldsymbol{q}}}{\delta f_{\boldsymbol{p}}}
\]

\end_inset


