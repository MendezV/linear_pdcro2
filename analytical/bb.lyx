\Pi_{zz}\left(i\omega_{n}\right)=-\sum_{\bm{k}\bm{k}'\boldsymbol{q}}\Gamma^{II}\left(\bm{k},\bm{k}'\right)\int\frac{d\nu}{\pi}\frac{d\epsilon_{1}}{2\pi}\frac{d\epsilon_{2}}{2\pi}\frac{\hbar}{2M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)A_{\text{Pd}}\left(\bm{k}',\epsilon_{2}\right)\chi''\left(\boldsymbol{q},\nu\right)\left(1+n_{b}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{b}\left(\nu\right)\right)\left(n_{B}\left(-\nu-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{F}\left(\epsilon_{2}\right)\right)\frac{n_{F}\left(\epsilon_{2}+\nu+\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)-n_{F}\left(\epsilon_{1}\right)}{i\omega_{n}-\nu-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}-\epsilon_{2}+\epsilon_{1}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Analytically continuing to real frequencies and taking the imaginary part
 and using the Sokhotski-Plemej formula: 
\begin_inset Newline newline
\end_inset


\begin_inset Formula 
\begin{equation}
\frac{1}{\omega+\zeta\pm i\delta}=P\frac{1}{\omega+\zeta}\mp i\pi\delta\left(\omega+\zeta\right),
\end{equation}

\end_inset

we get 
\begin_inset Formula 
\begin{align*}
\text{Im}\Pi_{zz}\left(\omega\right) & =\pi\sum_{\bm{k}\bm{k}'\boldsymbol{q}}\Gamma^{II}\left(\bm{k},\bm{k}'\right)\int\frac{d\nu}{\pi}\frac{d\epsilon_{1}}{2\pi}\frac{d\epsilon_{2}}{2\pi}\frac{\hbar}{2M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)A_{\text{Pd}}\left(\bm{k}',\epsilon_{2}\right)\chi''\left(\boldsymbol{q},\nu\right)\\
 & \times\left(1+n_{b}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{b}\left(\nu\right)\right)\left(n_{B}\left(-\nu-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{F}\left(\epsilon_{2}\right)\right)\left[n_{F}\left(\epsilon_{2}+\nu+\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)-n_{F}\left(\epsilon_{1}\right)\right]\delta\left(\omega-\nu-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}-\epsilon_{2}+\epsilon_{1}\right)\\
\\
 & =\sum_{\bm{k}\bm{k}'\boldsymbol{q}}\Gamma^{II}\left(\bm{k},\bm{k}'\right)\frac{d\epsilon_{1}}{2\pi}\frac{d\epsilon_{2}}{2\pi}\frac{\hbar}{2M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)A_{\text{Pd}}\left(\bm{k}',\epsilon_{2}\right)\chi''\left(\boldsymbol{q},\omega-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}-\epsilon_{2}+\epsilon_{1}\right)\\
 & \times\left(1+n_{b}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{b}\left(\omega-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}-\epsilon_{2}+\epsilon_{1}\right)\right)\left(n_{B}\left(\epsilon_{2}-\omega-\epsilon_{1}\right)+n_{F}\left(\epsilon_{2}\right)\right)\left[n_{F}\left(\omega+\epsilon_{1}\right)-n_{F}\left(\epsilon_{1}\right)\right]\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Where in the second step we performed the integral over 
\begin_inset Formula $\nu.$
\end_inset

 To calculate the optical conductivity we simply divide by the frequency
 
\begin_inset Formula 
\begin{align*}
 & \text{Re}\sigma_{zz}\left(\omega\right)\\
 & =\frac{\text{Im}\Pi_{zz}\left(\omega\right)}{\omega}\\
 & =\sum_{\bm{k}\bm{k}'\boldsymbol{q}}\Gamma^{II}\left(\bm{k},\bm{k}'\right)\frac{d\epsilon_{1}}{2\pi}\frac{d\epsilon_{2}}{2\pi}\frac{\hbar}{2M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)A_{\text{Pd}}\left(\bm{k}',\epsilon_{2}\right)\chi''\left(\boldsymbol{q},\omega-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}-\epsilon_{2}+\epsilon_{1}\right)\\
 & \times\left(1+n_{b}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{b}\left(\omega-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}-\epsilon_{2}+\epsilon_{1}\right)\right)\left(n_{B}\left(\epsilon_{2}-\omega-\epsilon_{1}\right)+n_{F}\left(\epsilon_{2}\right)\right)\frac{\left[n_{F}\left(\omega+\epsilon_{1}\right)-n_{F}\left(\epsilon_{1}\right)\right]}{\omega}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
taking the dc limit
\begin_inset Formula 
\begin{align*}
 & =\sum_{\bm{k}\bm{k}'\boldsymbol{q}}\Gamma^{II}\left(\bm{k},\bm{k}'\right)\frac{d\epsilon_{1}}{2\pi}\frac{d\epsilon_{2}}{2\pi}\frac{\hbar}{2M\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)A_{\text{Pd}}\left(\bm{k}',\epsilon_{2}\right)\chi''\left(\boldsymbol{q},\epsilon_{1}-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}-\epsilon_{2}\right)\\
 & \times\left(1+n_{b}\left(\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\right)+n_{b}\left(\epsilon_{1}-\omega_{\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}-\epsilon_{2}\right)\right)\left(n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)+n_{F}\left(-\epsilon_{2}\right)\right)\left(-\frac{\partial n_{f}}{\partial\epsilon_{1}}\right)
\end{align*}

\end_inset


\end_layout

