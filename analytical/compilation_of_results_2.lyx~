\begin_body

\begin_layout Title
Compilation of results 
\end_layout

\begin_layout Standard
We have the interaction hamiltonian given by 
\begin_inset Formula 
\begin{align*}
H_{\text{int}}= & \frac{1}{\sqrt{N}}\sum_{\substack{\bm{k}\bm{k}'\\
\alpha\beta
}
}g\left(\boldsymbol{k},\boldsymbol{k}'\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{k}-\boldsymbol{k}'}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
 & +\frac{1}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{i\alpha\beta}\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
And the three current operators given by 
\begin_inset Newline newline
\end_inset


\begin_inset Formula 
\begin{align}
\bm{J}_{N}^{0}\left(\omega_{n}\right) & =\sum_{\boldsymbol{k}\sigma i\nu_{n}}\boldsymbol{v}_{\boldsymbol{k}}p_{\boldsymbol{k}\sigma}^{\dagger}\left(i\nu_{n}\right)p_{\boldsymbol{k}\sigma}\left(\omega_{n}+\nu_{n}\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\boldsymbol{J}_{N}^{1}\left(\omega_{n}\right)=\frac{1}{\sqrt{N\beta}}\sum_{\begin{array}{c}
\boldsymbol{k}\boldsymbol{k}'\alpha\beta\\
i\nu_{l},i\nu_{n}
\end{array}}\boldsymbol{f}\left(\boldsymbol{k},\boldsymbol{k}'\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left(i\nu_{l}\right)\left[\bm{S}_{\boldsymbol{k}-\boldsymbol{k}'}\left(i\nu_{l}-i\nu_{n}\right)\cdot\bm{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\left(i\nu_{n}+i\omega_{n}\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\boldsymbol{J}_{N}^{2}\left(\omega_{n}\right) & =\frac{1}{N\beta}\sum_{\begin{array}{c}
\boldsymbol{k}\boldsymbol{k}'\boldsymbol{q}\alpha\beta i\\
i\nu_{l},i\mu_{m},i\nu_{n}
\end{array}}\boldsymbol{\Lambda}_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)X_{i,\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}}\left(i\nu_{l}-i\mu_{m}-i\nu_{n}\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left(i\nu_{l}\right)\left[\bm{S}_{\boldsymbol{q}}\left(i\mu_{m}\right)\cdot\bm{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\left(i\nu_{n}+i\omega_{n}\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
The coupling functions are given by 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
g\left(\boldsymbol{k},\boldsymbol{k}'\right) & =\sum_{ik}g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)\\
 & =\frac{4g^{2}}{U}u\left(\boldsymbol{k}\right)u\left(\boldsymbol{k}'\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula 
\begin{equation}
\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)=-\lambda\sum_{k}\left(g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)+\overline{g_{ik}\left(\boldsymbol{k}',\boldsymbol{k}\right)}\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
with
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)=\frac{4g^{2}}{U}e^{-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{k}}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
as such the factorization of the coupling constant 
\begin_inset Formula $g\left(\boldsymbol{k},\boldsymbol{k}'\right)$
\end_inset

 happens generically.
\end_layout

\begin_layout Standard
The bare vertex functions are given by 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\boldsymbol{f}\left(\boldsymbol{k},\boldsymbol{k}'\right)=\sum_{ij}\boldsymbol{g}_{ij}\left(\boldsymbol{k},\boldsymbol{k}'\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\boldsymbol{\Lambda}_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)=-\lambda\sum_{j}\left(\boldsymbol{g}_{ij}\left(\boldsymbol{k},\boldsymbol{k}'\right)+\boldsymbol{g}_{ji}\left(\boldsymbol{k},\boldsymbol{k}'\right)\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula 
\begin{equation}
\boldsymbol{g}_{ij}\left(\boldsymbol{k},\boldsymbol{k}'\right)=-i2\frac{g_{i0}g_{j0}}{U}\left(\bm{R}_{i}-\bm{R}_{j}\right)e^{-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{j}}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
if there is no spatial dependence of the hybridization, we get
\begin_inset Formula 
\[
\boldsymbol{g}_{ij}\left(\boldsymbol{k},\boldsymbol{k}'\right)=\frac{4g^{2}}{U}\frac{\left(\bm{R}_{i}-\bm{R}_{j}\right)}{2i}e^{-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{j}}.
\]

\end_inset


\end_layout

\begin_layout Standard
In the case where we only have nearest neigbour interactions between different
 layers with atoms being directly on top of each other, we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
g\left(\boldsymbol{k},\boldsymbol{k}'\right) & =\frac{4g^{2}}{U}\left[2\cos\left(k_{z}a_{z}\right)\right]\left[2\cos\left(k_{z}'a_{z}\right)\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\lambda_{+}\left(\boldsymbol{k},\boldsymbol{k}'\right) & =\lambda_{-}\left(\boldsymbol{k},\boldsymbol{k}'\right)=-\lambda g\left(\boldsymbol{k},\boldsymbol{k}'\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
and
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\boldsymbol{\Lambda}_{+}\left(\boldsymbol{k},\boldsymbol{k}'\right) & =-\frac{4g^{2}\lambda}{U}\left(2a_{z}\right)\hat{z}\sin\left(k_{z}a_{z}+k_{z}'a_{z}\right)\\
 & =\boldsymbol{\Lambda}_{-}\left(\boldsymbol{k},\boldsymbol{k}'\right)=-\lambda\boldsymbol{f}\left(\boldsymbol{k},\boldsymbol{k}'\right)
\end{align}

\end_inset


\end_layout

\begin_layout Section
Self Energy
\end_layout

\begin_layout Standard
There are two leading order contributions to the self energy to leading
 order in 
\begin_inset Formula 
\[
\frac{4g^{2}}{U}>\frac{4g^{2}}{U}\lambda\left(\frac{\hbar}{M\omega_{0}}\right)^{1/2}\gg\left(\frac{4g^{2}}{U}\right)^{2}.
\]

\end_inset


\end_layout

\begin_layout Subsection
kondo
\end_layout

\begin_layout Standard
The first contribution comes from the pure Kondo coupling and is given by
 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Sigma\left(\boldsymbol{k},i\omega_{n}\right)=-\frac{1}{\beta N}\sum_{\bm{k}'}\sum_{i\nu_{n}}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}D\left(\boldsymbol{k}'-\boldsymbol{k},i\nu_{n}-i\omega_{n}\right)\mathcal{G}\left(\boldsymbol{k}',i\nu_{n}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Carrying out the matsubara sumation we get 
\begin_inset Newline newline
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Sigma_{K}\left(\boldsymbol{k},i\omega_{n}\right)=\frac{1}{N}\sum_{\bm{k}'}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}A\left(\bm{k}',\epsilon\right)\chi''\left(\boldsymbol{k}'-\boldsymbol{k},\nu\right)\left[\frac{n_{B}\left(\nu\right)+n_{F}\left(\epsilon\right)}{i\omega_{n}+\nu-\epsilon}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
In the high temperature limit 
\begin_inset Formula $T>J$
\end_inset

 the susceptibility becomes momentum independent and we have
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\Sigma_{K}\left(\boldsymbol{k},i\omega_{n}\right) & =\frac{1}{N}\sum_{\bm{k}'}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}A\left(\bm{k}',\epsilon\right)\chi''\left(\nu\right)\left[\frac{n_{B}\left(\nu\right)+n_{F}\left(\epsilon\right)}{i\omega_{n}+\nu-\epsilon}\right]\\
 & =\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\rho_{I\boldsymbol{k}}\left(\epsilon\right)\chi''\left(\nu\right)\left[\frac{n_{B}\left(\nu\right)+n_{F}\left(\epsilon\right)}{i\omega_{n}+\nu-\epsilon}\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Since the integration over 
\begin_inset Formula $\nu$
\end_inset

 is bounded by the spin bandwidth and we are in the high temperature limit
 we can expand the bose distribution function.
 We can also drop the fermi function since it is bounded by 1.
 
\begin_inset Formula 
\[
\Sigma_{K}\left(\boldsymbol{k},\omega^{+}\right)=k_{b}T\int\frac{d\nu}{\pi}\frac{\chi''\left(\nu\right)}{\nu}\int\frac{d\epsilon}{\pi}\frac{\rho_{\boldsymbol{k}}\left(\epsilon\right)}{\omega^{+}+\nu-\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
No further progress can be made without the explicit structure of 
\begin_inset Formula $g\left(\boldsymbol{k},\boldsymbol{k}'\right).$
\end_inset

 However if we use the factorization property, we get
\begin_inset Formula 
\begin{align*}
\rho_{I\boldsymbol{k}}\left(\epsilon\right) & =\frac{1}{N}\sum_{\bm{k}'}\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}A\left(\bm{k}',\epsilon\right)\\
 & =\left(\frac{4g^{2}}{U}\right)^{2}u\left(\boldsymbol{k}\right)^{2}\frac{1}{N}\sum_{\bm{k}'}u\left(\boldsymbol{k}'\right)^{2}A\left(\bm{k}',\epsilon\right)\\
 & =\left(\frac{4g^{2}}{U}\right)^{2}u\left(\boldsymbol{k}\right)^{2}\rho_{I}\left(\epsilon\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Then, we have 
\begin_inset Formula 
\[
\Sigma_{K}\left(\boldsymbol{k},\omega^{+}\right)=k_{b}T\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\int\frac{d\nu}{\pi}\frac{\chi''\left(\nu\right)}{\nu}\int\frac{d\epsilon}{\pi}\frac{\rho_{I}\left(\epsilon\right)}{\omega^{+}+\nu-\epsilon}.
\]

\end_inset


\end_layout

\begin_layout Standard
Since the susceptibility is itself proportional to 
\begin_inset Formula $1/T$
\end_inset

 this contribution to the self energy is 
\begin_inset Formula $T-$
\end_inset

independent in the high temperature limit.
 
\end_layout

\begin_layout Subsection
imaginary part
\end_layout

\begin_layout Standard
performing analytical continuation we have 
\begin_inset Formula 
\begin{align*}
\Sigma_{K}''\left(\boldsymbol{k},\omega\right) & =-k_{b}T\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\int\frac{d\nu}{\pi}\frac{\chi''\left(\nu\right)}{\nu}\int d\epsilon\delta\left(\omega+\nu-\epsilon\right)\rho_{I}\left(\epsilon\right)\\
 & =-k_{b}T\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\int\frac{d\nu}{\pi}\frac{\chi''\left(\nu\right)}{\nu}\rho_{I}\left(\omega+\nu\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
near the fermi surface we then have 
\begin_inset Formula 
\[
\Sigma_{K}''\left(\boldsymbol{k},0\right)=-k_{b}T\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\int\frac{d\nu}{\pi}\frac{\chi''\left(\nu\right)}{\nu}\rho_{I}\left(\nu\right)
\]

\end_inset


\end_layout

\begin_layout Standard
using the phenomenological form of the susceptibility at high temperatures
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\Sigma_{K}''\left(\boldsymbol{k},0\right) & =-k_{b}T\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\int\frac{d\nu}{\pi}\frac{\kappa}{J}\beta^{-1}\theta\left(\alpha\pi J-\left|\nu\right|\right)\rho_{I}\left(\nu\right)\\
 & =-\frac{\kappa}{J}\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\int_{-\alpha\pi J}^{\alpha\pi J}\frac{d\nu}{\pi}\rho_{I}\left(\nu\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
For the scattering time, we have 
\begin_inset Formula 
\begin{align*}
\frac{1}{\tau_{\boldsymbol{k}}} & =-2\Sigma_{K}''\left(\boldsymbol{k},0\right)\\
 & =\frac{2\kappa}{J}\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\int_{-\alpha\pi J}^{\alpha\pi J}\frac{d\nu}{\pi}\frac{1}{N}\sum_{\bm{k}'}u\left(\boldsymbol{k}'\right)^{2}A\left(\bm{k}',\epsilon\right)\\
 & \approx\frac{2\kappa}{J}\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\int_{-\alpha\pi J}^{\alpha\pi J}\frac{d\nu}{\pi}\frac{1}{N}\sum_{\bm{k}'}u\left(\boldsymbol{k}'\right)^{2}\pi\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\\
 & =2\pi\kappa\alpha\left(\frac{4g^{2}u\left(\boldsymbol{k}\right)}{U}\right)^{2}\frac{1}{N}\sum_{\bm{k}'}u\left(\boldsymbol{k}'\right)^{2}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Overall we get 
\begin_inset Formula 
\[
\frac{1}{\tau_{\boldsymbol{k}}}=2\pi\kappa\alpha\frac{1}{N}\sum_{\bm{k}'}\delta\left(\varepsilon_{\boldsymbol{k}}\right)\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
taking the average of the scatttering rate about the fermi suface, we get
 
\begin_inset Formula 
\begin{align*}
\frac{1}{\tau} & =2\pi\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\frac{\left[\frac{1}{N}\sum_{\bm{k}'}u\left(\boldsymbol{k}'\right)^{2}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\right]^{2}}{\frac{1}{N}\sum_{\bm{k}}\delta\left(\varepsilon_{\boldsymbol{k}}\right)}\\
 & =2\pi\kappa\alpha\frac{\frac{1}{N^{2}}\sum_{\bm{k}'\boldsymbol{k}}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\delta\left(\varepsilon_{\boldsymbol{k}}\right)\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}}{\frac{1}{N}\sum_{\bm{k}}\delta\left(\varepsilon_{\boldsymbol{k}}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
In the limit of our previous model, with a momentum independent interaction,
 we recover the scaling 
\begin_inset Formula 
\[
\frac{1}{\tau}\propto\left(\frac{g^{2}}{U}\right)^{2}\alpha\kappa\nu_{0}
\]

\end_inset


\end_layout

\begin_layout Standard
without any dependence on the dynamics of the spins.
 
\end_layout

\begin_layout Standard
We can reexpress this as 
\begin_inset Formula 
\[
\frac{1}{\tau}=2\pi\nu_{0}^{-1}\lambda_{K}
\]

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula 
\begin{align*}
\lambda_{K} & =\kappa\alpha\frac{1}{N^{2}}\sum_{\bm{k}'\boldsymbol{k}}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\delta\left(\varepsilon_{\boldsymbol{k}}\right)\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}\\
 & \sim\kappa\alpha\left(\frac{g^{2}}{U}\right)^{2}\nu_{0}^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Subsubsection
more precisely
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{1}{\tau} & =2\pi\kappa\alpha\frac{\frac{1}{N^{2}}\sum_{\bm{k}'\boldsymbol{k}}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\delta\left(\varepsilon_{\boldsymbol{k}}\right)\left|g\left(\boldsymbol{k},\boldsymbol{k}'\right)\right|^{2}}{\frac{1}{N}\sum_{\bm{k}}\delta\left(\varepsilon_{\boldsymbol{k}}\right)}\\
 & =2\pi\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\frac{\left[\frac{1}{N}\sum_{\bm{k}'}u\left(\boldsymbol{k}'\right)^{2}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\right]^{2}}{\frac{1}{N}\sum_{\bm{k}}\delta\left(\varepsilon_{\boldsymbol{k}}\right)}\\
 & =2\pi\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\frac{\left[\frac{1}{N}\sum_{\bm{k}'}4\cos^{2}\left(k_{z}'a_{z}\right)\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\right]^{2}}{\frac{1}{N}\sum_{\bm{k}}\delta\left(\varepsilon_{\boldsymbol{k}}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Now we evaluate 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{1}{N}\sum_{\bm{k}'}\cos^{2}\left(k_{z}a_{z}\right)\delta\left(\varepsilon_{\boldsymbol{k}'}\right) & =\nu_{0}a_{z}\int\frac{dk_{z}}{2\pi}\cos^{2}\left(k_{z}a_{z}\right)\\
 & =\nu_{0}\frac{1}{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We also have 
\begin_inset Formula 
\begin{align*}
\frac{1}{N}\sum_{\bm{k}}\delta\left(\varepsilon_{\boldsymbol{k}}\right) & =\nu_{0}a_{z}\int\frac{dk_{z}}{2\pi}\\
 & =\nu_{0}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{1}{\tau} & =2\pi\kappa\alpha\left(\frac{16g^{2}}{U}\right)^{2}\frac{\left[\nu_{0}\frac{1}{2}\right]^{2}}{\nu_{0}}\\
 & =2\pi\kappa\alpha\left(\frac{8g^{2}}{U}\right)^{2}\nu_{0}\\
 & =2\pi\left(\frac{8g^{2}}{U}\right)\left(\kappa\alpha\left(\frac{8g^{2}}{U}\right)\nu_{0}\right)\\
 & =2\pi\left(\frac{4g^{2}}{U}\right)\lambda_{K}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula 
\[
\lambda_{K}=\kappa\alpha\left(\frac{16g^{2}}{U}\right)\nu_{0}
\]

\end_inset


\end_layout

\begin_layout Subsection
Magnetoelastic
\end_layout

\begin_layout Standard
For the magnetoelastic coupling we have 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\Sigma_{ME}\left(\boldsymbol{k},i\omega_{n}\right) & =\frac{1}{\beta^{2}N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{i\nu_{n}iz_{n}}\sum_{\ell}\left|\lambda_{\ell}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}D_{\ell}\left(\boldsymbol{q},iz_{n}\right)S\left(\boldsymbol{p},i\nu_{n}\right)\mathcal{G}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},i\omega_{n}+i\nu_{n}+iz_{n}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Performing the matsubara sumations, we get 
\begin_inset Formula 
\[
\Sigma_{ME}\left(\boldsymbol{k},i\omega_{n}\right)=\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{dz}{\pi}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\ell}\left|\lambda_{\ell}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon\right)B_{\ell}\left(\boldsymbol{q},z\right)\chi''\left(\boldsymbol{p},\nu\right)\left[n_{B}\left(z\right)+n_{F}\left(\epsilon\right)\right]\left[\frac{n_{B}\left(\nu\right)+n_{F}\left(\epsilon-z\right)}{i\omega_{n}+z+\nu-\epsilon}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
In the high temperature limit the spin susceptibility is momentum independent,
 we also have that for optical phonons, the spectral function 
\begin_inset Formula $B\left(\boldsymbol{q},z\right)$
\end_inset

 is momentum independent.
 We will assume all the out of plane optical modes have the same frequency
 so that 
\begin_inset Formula $B_{\ell}\left(\boldsymbol{q},z\right)=B\left(\boldsymbol{q},z\right).$
\end_inset

 Only the coupling constant and the electron spectral function enter the
 momentum integrals and we get 
\begin_inset Formula 
\[
\Sigma_{ME}\left(\boldsymbol{k},i\omega_{n}\right)=\int\frac{dz}{\pi}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\rho_{II\boldsymbol{k}}\left(\epsilon\right)B\left(z\right)\chi''\left(\nu\right)\left[n_{B}\left(z\right)+n_{F}\left(\epsilon\right)\right]\left[\frac{n_{B}\left(\nu\right)+n_{F}\left(\epsilon-z\right)}{i\omega_{n}+z+\nu-\epsilon}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
Where we defined 
\begin_inset Formula 
\[
\rho_{II\boldsymbol{k}}\left(\epsilon\right)=\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{\ell}\left|\lambda_{\ell}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Now we take the high temperature limit in the bose functions, since we are
 above the debye scale and the spin bandwith
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Sigma_{ME}\left(\boldsymbol{k},\omega^{+}\right)=\left(k_{b}T\right)^{2}\int\frac{dz}{\pi}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\frac{B\left(z\right)}{z}\frac{\chi''\left(\nu\right)}{\nu}\frac{\rho_{II\boldsymbol{k}}\left(\epsilon\right)}{\omega^{+}+z+\nu-\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
again, since the susceptibility is proportional to 
\begin_inset Formula $1/T$
\end_inset

 we have that the self energy overall scales linearly with the temperature.
 
\end_layout

\begin_layout Standard
We can derive an additional propert
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\rho_{II\boldsymbol{k}}\left(\epsilon\right) & =\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{\ell}\left|\lambda_{\ell}\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}A\left(\boldsymbol{k}+\boldsymbol{q}+\boldsymbol{p},\epsilon\right)\\
