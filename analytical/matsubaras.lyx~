\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathcal{G}\left(\boldsymbol{k}',i\nu_{n}\right)=\int\frac{d\epsilon}{\pi}\frac{A\left(\bm{k}',\epsilon\right)}{i\nu_{n}-\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
plugging in 
\begin_inset Formula 
\begin{align*}
\Sigma\left(\boldsymbol{k},i\omega_{n}\right) & =\frac{1}{\beta}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\bm{k}'}A\left(\bm{k}',\epsilon\right)B\left(\boldsymbol{k}'-\boldsymbol{k},\nu\right)\sum_{i\nu_{n}}\frac{1}{i\nu_{n}-i\omega_{n}-\nu}\frac{1}{i\nu_{n}-\epsilon}\\
 & =\frac{1}{\beta}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\bm{k}'}A\left(\bm{k}',\epsilon\right)B\left(\boldsymbol{k}'-\boldsymbol{k},\nu\right)\sum_{i\nu_{n}}\frac{1}{i\nu_{n}-\left(i\omega_{n}+\nu\right)}\frac{1}{i\nu_{n}-\epsilon}\\
 & =\sum_{\bm{k}'}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}A\left(\bm{k}',\epsilon\right)B\left(\boldsymbol{k}'-\boldsymbol{k},\nu\right)\left[+\frac{n_{F}\left(i\omega_{n}+\nu\right)-n_{F}\left(\epsilon\right)}{i\omega_{n}+\nu-\epsilon}\right]\\
\end{align*}

\end_inset


\end_layout

