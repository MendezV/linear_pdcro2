\begin_layout Standard
\begin_inset Formula 
\[
{\displaystyle \frac{1}{\beta}\sum_{\omega_{n}}\frac{1}{(i\omega_{n}-\xi_{1})(i\omega_{n}-\xi_{2})}=}-\eta\frac{n_{\eta}\left(\xi_{1}\right)-n_{\eta}\left(\xi_{2}\right)}{\xi_{1}-\xi_{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
with the spectral reps
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
D\left(\boldsymbol{q},i\nu_{n}\right)=\int\frac{d\nu}{\pi}\frac{B\left(\boldsymbol{k}',\nu\right)}{i\nu_{n}-\nu},
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathcal{G}\left(\boldsymbol{k}-\boldsymbol{q},i\nu_{n}\right)=\int\frac{d\epsilon}{\pi}\frac{A\left(\boldsymbol{k}-\boldsymbol{q},\epsilon\right)}{i\omega_{n}-i\nu_{n}-\epsilon}
\]

\end_inset


\end_layout

\begin_layout Standard
plugging in 
\begin_inset Formula 
\begin{align*}
\Sigma\left(\boldsymbol{k},i\omega_{n}\right) & =\frac{1}{\beta}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\bm{q}}A\left(\boldsymbol{k}-\boldsymbol{q},\epsilon\right)B\left(\boldsymbol{q},\nu\right)\sum_{i\nu_{n}}\frac{1}{i\nu_{n}-\nu}\frac{1}{i\omega_{n}-i\nu_{n}-\epsilon}\\
 & =-\frac{1}{\beta}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\bm{q}}A\left(\boldsymbol{k}-\boldsymbol{q},\epsilon\right)B\left(\boldsymbol{q},\nu\right)\sum_{i\nu_{n}}\frac{1}{i\nu_{n}-\nu}\frac{1}{i\nu_{n}-\left(i\omega_{n}-\epsilon\right)}\\
 & =-\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}\sum_{\bm{q}}A\left(\boldsymbol{k}-\boldsymbol{q},\epsilon\right)B\left(\boldsymbol{q},\nu\right)\left[\frac{n_{B}\left(\nu\right)-n_{B}\left(\epsilon-i\omega_{n}\right)}{\nu-\left(i\omega_{n}-\epsilon\right)}\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
using 
\begin_inset Formula 
\[
n_{B}\left(\epsilon-i\omega_{n}\right)=-n_{F}\left(\epsilon\right)
\]

\end_inset


\end_layout

\begin_layout Standard
we get 
\begin_inset Formula 
\begin{align*}
\Sigma\left(\boldsymbol{k},i\omega_{n}\right) & =-\sum_{\bm{q}}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{k}-\boldsymbol{q},\epsilon\right)B\left(\boldsymbol{q},\nu\right)\left[-\frac{n_{B}\left(\nu\right)+n_{F}\left(\epsilon\right)}{i\omega_{n}-\nu-\epsilon}\right]\\
 & =\sum_{\bm{q}}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{k}-\boldsymbol{q},\epsilon\right)B\left(\boldsymbol{q},\nu\right)\left[\frac{n_{B}\left(\nu\right)+n_{F}\left(\epsilon\right)}{i\omega_{n}-\nu-\epsilon}\right]
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Imaginary part
\begin_inset Formula 
\begin{align*}
\Sigma''\left(\boldsymbol{k},\omega\right) & =-\pi\sum_{\bm{q}}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{k}-\boldsymbol{q},\epsilon\right)B\left(\boldsymbol{q},\nu\right)\left[n_{B}\left(\nu\right)+n_{F}\left(\epsilon\right)\right]\delta\left(\omega-\nu-\epsilon\right)\\
 & =-\pi\sum_{\bm{q}}\int\frac{d\nu}{\pi}\int\frac{d\epsilon}{\pi}A\left(\boldsymbol{k}-\boldsymbol{q},\epsilon\right)B\left(\boldsymbol{q},\omega-\epsilon\right)\left[n_{B}\left(\omega-\epsilon\right)+n_{F}\left(\epsilon\right)\right]
\end{align*}

\end_inset


