\begin_layout Standard
replacing the spectral function by its actual value
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{11}^{\alpha}=\left(\frac{2a_{z}}{a_{pl}^{2}}\frac{e^{2}}{\hbar}\right)2\left[\frac{4g^{2}}{U}\right]^{2}\int\frac{d\epsilon}{\pi}\rho\left(\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\int\frac{dz}{\pi}\rho\left(\epsilon-z\right)B\left(z\right)\left(n_{B}\left(z\right)+n_{F}\left(z-\epsilon\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
B\left(z\right)=\frac{\pi\hbar}{2M\omega_{0}}\left(\delta\left(z-\omega_{0}\right)-\delta\left(\nu+\omega_{0}\right)\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{11}^{\alpha}=\left(\frac{2a_{z}}{a_{pl}^{2}}\frac{e^{2}}{\hbar}\right)2\left[\frac{4g^{2}}{U}\right]^{2}\int\frac{d\epsilon}{\pi}\rho\left(\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\int\frac{dz}{\pi}\rho\left(\epsilon-z\right)B\left(z\right)\left(n_{B}\left(z\right)+n_{F}\left(z-\epsilon\right)\right)
\]

\end_inset


\end_layout

\begin_layout Section
\begin_inset Formula $A\left(\boldsymbol{k},\omega\right)$
\end_inset

 integration 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
A\left(\boldsymbol{p},\epsilon\right) & =V_{uc}\int\frac{d^{2}\boldsymbol{p}}{\left(2\pi\right)^{2}}\frac{\gamma_{p_{z}}}{\left(\epsilon-\varepsilon_{\boldsymbol{p}}\right)^{2}+\gamma_{p_{z}}^{2}}\\
 & =\int d\omega\delta\left(\omega-\varepsilon_{\boldsymbol{p}}\right)V_{uc}\int\frac{d^{2}\boldsymbol{p}}{\left(2\pi\right)^{2}}\frac{\gamma_{p_{z}}}{\left(\epsilon-\varepsilon_{\boldsymbol{p}}\right)^{2}+\gamma_{p_{z}}^{2}}\\
 & =\int d\omega\int\frac{\gamma_{p_{z}}}{\left(\epsilon-\omega\right)^{2}+\gamma_{p_{z}}^{2}}V_{uc}\int\frac{d^{2}\boldsymbol{p}}{\left(2\pi\right)^{2}}\delta\left(\omega-\varepsilon_{\boldsymbol{p}}\right)\\
 & =\int d\omega\frac{\gamma_{p_{z}}}{\left(\epsilon-\omega\right)^{2}+\gamma_{p_{z}}^{2}}\rho\left(\omega\right)\\
 & =\int d\omega\frac{\gamma_{p_{z}}}{\omega^{2}+\gamma_{p_{z}}^{2}}\rho\left(\omega+\epsilon\right)\\
 & \sim\rho\left(\epsilon\right)\int d\omega\frac{\gamma_{p_{z}}}{\omega^{2}+\gamma_{p_{z}}^{2}}\\
 & =\pi\rho\left(\epsilon\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we had 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\gamma_{k_{z}}=\frac{1}{\tau_{k_{z}}} & =\frac{1}{\tau_{ME,k_{z}}}+\frac{1}{\tau_{ME,k_{z}}}\\
 & =\frac{1}{\tau_{K,k_{z}}}\left(1+2\frac{k_{b}T}{\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}\right)\\
 & =4\pi\kappa\alpha\nu_{0}\left(\frac{8g^{2}}{U}\right)^{2}\cos^{2}\left(k_{z}a_{z}\right)\left(1+2\frac{k_{b}T}{\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}\right)\\
 & =\gamma_{0}\cos^{2}\left(k_{z}a_{z}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
with the definition
\begin_inset Formula 
\[
\gamma_{0}=4\pi\kappa\alpha\nu_{0}\left(\frac{8g^{2}}{U}\right)^{2}\left(1+2\frac{k_{b}T}{\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
If we kept the 
\begin_inset Formula $\omega$
\end_inset

 dependence in the density of states, we would have instead 
\begin_inset Formula 
\[
A\left(\boldsymbol{p},\epsilon\right)=\int d\omega\frac{\gamma_{0}\cos^{2}\left(k_{z}a_{z}\right)}{\omega^{2}+\gamma_{0}^{2}\cos^{4}\left(k_{z}a_{z}\right)}\rho\left(\omega+\epsilon\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\sigma_{11}^{\alpha} & =\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\int\frac{dz}{\pi}\int d\omega\int d\omega'\ \frac{\gamma_{0}\cos^{2}\left(q_{z}a_{z}\right)}{\omega^{2}+\gamma_{0}^{2}\cos^{4}\left(q_{z}a_{z}\right)}\frac{\gamma_{0}\cos^{2}\left(p_{z}a_{z}\right)}{\omega^{\prime2}+\gamma_{0}^{2}\cos^{4}\left(p_{z}a_{z}\right)}\ \chi''\left(\epsilon-z\right)\rho\left(\omega'+z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\rho\left(\omega+\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\\
 & =\left[\frac{4g^{2}}{U}\left(2a_{z}\right)\right]^{2}\int\frac{d\epsilon}{\pi}\int\frac{dz}{\pi}\int d\omega\int d\omega'\left[\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\sin\left(p_{z}a_{z}+q_{z}a_{z}\right)^{2}\ \frac{\gamma_{0}\cos^{2}\left(q_{z}a_{z}\right)}{\omega^{2}+\gamma_{0}^{2}\cos^{4}\left(q_{z}a_{z}\right)}\frac{\gamma_{0}\cos^{2}\left(p_{z}a_{z}\right)}{\omega^{\prime2}+\gamma_{0}^{2}\cos^{4}\left(p_{z}a_{z}\right)}\right]\ \chi''\left(\epsilon-z\right)\rho\left(\omega'+z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\rho\left(\omega+\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Focusing on the momentum integral we have 
\begin_inset Formula 
\begin{align*}
\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\sin\left(p_{z}a_{z}+q_{z}a_{z}\right)^{2}\ \frac{\gamma_{0}\cos^{2}\left(q_{z}a_{z}\right)}{\omega^{2}+\gamma_{0}^{2}\cos^{4}\left(q_{z}a_{z}\right)}\frac{\gamma_{0}\cos^{2}\left(p_{z}a_{z}\right)}{\omega^{\prime2}+\gamma_{0}^{2}\cos^{4}\left(p_{z}a_{z}\right)}\\
\frac{1}{\gamma_{0}^{2}}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\sin\left(p_{z}a_{z}+q_{z}a_{z}\right)^{2}\ \frac{\cos^{2}\left(q_{z}a_{z}\right)}{\frac{\omega^{2}}{\gamma_{0}^{2}}+\cos^{4}\left(q_{z}a_{z}\right)}\frac{\cos^{2}\left(p_{z}a_{z}\right)}{\frac{\omega^{\prime2}}{\gamma_{0}^{2}}+\cos^{4}\left(p_{z}a_{z}\right)}\\
=\pi^{2}f\left(\omega,\omega';\gamma_{0}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{11}^{\alpha}=\left[\frac{4g^{2}}{U}\left(2a_{z}\right)\right]^{2}\int d\epsilon dzd\omega d\omega'\ f\left(\omega,\omega';\gamma_{0}\right)\chi''\left(\epsilon-z\right)\rho\left(\omega'+z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\rho\left(\omega+\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)
\]

\end_inset


\end_layout

\begin_layout Section
Kernel
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
f\left(\omega,\omega';\gamma_{0}\right)=\frac{1}{\pi^{2}\gamma_{0}^{2}}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\sin\left(p_{z}a_{z}+q_{z}a_{z}\right)^{2}\ \frac{\cos^{2}\left(q_{z}a_{z}\right)}{\frac{\omega^{2}}{\gamma_{0}^{2}}+\cos^{4}\left(q_{z}a_{z}\right)}\frac{\cos^{2}\left(p_{z}a_{z}\right)}{\frac{\omega^{\prime2}}{\gamma_{0}^{2}}+\cos^{4}\left(p_{z}a_{z}\right)}\\
=\frac{1}{4\pi^{4}\gamma_{0}^{2}}\frac{1}{a_{z}^{2}}\int dpdq\ \sin\left(p+q\right)^{2}\ \frac{\cos^{2}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}\frac{\cos^{2}\left(p\right)}{\nu^{\prime2}+\cos^{4}\left(p\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we defined 
\begin_inset Formula 
\[
\frac{\omega^{2}}{\gamma_{0}^{2}}=\nu^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\nu^{\prime2}=\frac{\omega^{\prime2}}{\gamma_{0}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Now we calculate 
\begin_inset Formula 
\[
\int dpdq\ \sin\left(p+q\right)^{2}\ \frac{\cos^{2}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}\frac{\cos^{2}\left(p\right)}{\nu^{\prime2}+\cos^{4}\left(p\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
Expanding the 
\begin_inset Formula $sin$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\int dpdq\ \left(\sin\left(q\right)\cos\left(p\right)+\cos\left(q\right)\sin\left(p\right)\right)^{2}\ \frac{\cos^{2}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}\frac{\cos^{2}\left(p\right)}{\nu^{\prime2}+\cos^{4}\left(p\right)}\\
\int dpdq\ \left(\sin^{2}\left(q\right)\cos^{2}\left(p\right)+2\sin\left(q\right)\cos\left(p\right)\cos\left(q\right)\sin\left(p\right)+\cos^{2}\left(q\right)\sin^{2}\left(p\right)\right)\ \frac{\cos^{2}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}\frac{\cos^{2}\left(p\right)}{\nu^{\prime2}+\cos^{4}\left(p\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
There are three integrals that we need to solve 
\begin_inset Formula 
\[
\int_{-\pi}^{\pi}dq\frac{\sin^{2}\left(q\right)\cos^{2}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}=2\int_{0}^{\pi}dq\frac{\sin^{2}\left(q\right)\cos^{2}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\int_{-\pi}^{\pi}dq\frac{\cos^{4}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}=2\int_{0}^{\pi}dq\frac{\cos^{4}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\int_{-\pi}^{\pi}dq\frac{\sin\left(q\right)\cos^{3}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}=0
\]

\end_inset


\end_layout

\begin_layout Standard
For the first integral, we have 
\begin_inset Formula 
\begin{align*}
2\int_{0}^{\pi}dq\frac{\sin^{2}\left(q\right)\cos^{2}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)} & =-2\int_{1}^{-1}dq\frac{\sqrt{1-q^{2}}q^{2}}{\nu^{2}+q^{4}}\\
 & =2\int_{-1}^{1}dq\frac{\sqrt{1-q^{2}}q^{2}}{\nu^{2}+q^{4}}\\
 & =\sqrt{2}\pi\sqrt{\sqrt{\frac{1}{\nu^{2}}+1}+1}-2\pi
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
2\int_{0}^{\pi}dq\frac{\cos^{4}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)} & =2\int_{0}^{\pi}dq\frac{\sin\left(q\right)}{\sin\left(q\right)}\frac{\cos^{4}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}\\
 & =-2\int_{1}^{-1}dq\frac{1}{\sqrt{1-q^{2}}}\frac{q^{4}}{\nu^{2}+q^{4}}\\
 & =2\int_{-1}^{1}dq\frac{1}{\sqrt{1-q^{2}}}\frac{q^{4}}{\nu^{2}+q^{4}}\\
 & =2\int_{-1}^{1}dq\frac{1}{\sqrt{1-q^{2}}}\frac{q^{4}}{\nu^{2}+q^{4}}\\
 & =\left(2\pi-\sqrt{2}\pi\sqrt{\frac{1}{\sqrt{\frac{1}{\nu^{2}}+1}}+\frac{1}{\frac{1}{\nu^{2}}+1}}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Therefore, we have 
\begin_inset Formula 
\begin{align*}
\int dpdq\ \sin\left(p+q\right)^{2}\ \frac{\cos^{2}\left(q\right)}{\nu^{2}+\cos^{4}\left(q\right)}\frac{\cos^{2}\left(p\right)}{\nu^{\prime2}+\cos^{4}\left(p\right)}\\
=\left(2\pi-\sqrt{2}\pi\sqrt{\frac{1}{\sqrt{\frac{1}{\nu^{2}}+1}}+\frac{1}{\frac{1}{\nu^{2}}+1}}\right)\left(\sqrt{2}\pi\sqrt{\sqrt{\frac{1}{\nu^{\prime2}}+1}+1}-2\pi\right)+\left(2\pi-\sqrt{2}\pi\sqrt{\frac{1}{\sqrt{\frac{1}{\nu^{\prime2}}+1}}+\frac{1}{\frac{1}{\nu^{\prime2}}+1}}\right)\left(\sqrt{2}\pi\sqrt{\sqrt{\frac{1}{\nu^{2}}+1}+1}-2\pi\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Therefore, the kernel takes the form
\begin_inset Formula 
\begin{align*}
f\left(\omega,\omega';\gamma_{0}\right) & =\frac{1}{4\pi^{4}\gamma_{0}^{2}}\frac{1}{a_{z}^{2}}\left[\left(2\pi-\sqrt{2}\pi\sqrt{\frac{1}{\sqrt{\frac{1}{\nu^{2}}+1}}+\frac{1}{\frac{1}{\nu^{2}}+1}}\right)\left(\sqrt{2}\pi\sqrt{\sqrt{\frac{1}{\nu^{\prime2}}+1}+1}-2\pi\right)+\nu\leftrightarrow\nu'\right]\\
\\
 & =\frac{1}{\pi^{2}\gamma_{0}^{2}}\frac{1}{a_{z}^{2}}\left[\left(1-\sqrt{\frac{1}{2}\frac{1}{\sqrt{\frac{1}{\nu^{2}}+1}}+\frac{1}{2}\frac{1}{\frac{1}{\nu^{2}}+1}}\right)\left(\sqrt{\frac{1}{2}\sqrt{\frac{1}{\nu^{\prime2}}+1}+\frac{1}{2}}-1\right)+\nu\leftrightarrow\nu'\right]\\
\\
 & =\frac{1}{\pi^{2}\gamma_{0}^{2}}\frac{1}{a_{z}^{2}}\left[\left(1-\sqrt{\frac{1}{2}\frac{1}{\sqrt{\frac{\gamma_{0}^{2}}{\omega^{2}}+1}}+\frac{1}{2}\frac{1}{\frac{\gamma_{0}^{2}}{\omega^{2}}+1}}\right)\left(\sqrt{\frac{1}{2}\sqrt{\frac{\gamma_{0}^{2}}{\omega^{\prime2}}+1}+\frac{1}{2}}-1\right)+\omega\leftrightarrow\omega'\right]\\
\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
This is well approximated by 
\begin_inset Formula 
