\begin_layout Standard
Now we integrate the spectral functions
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\sigma_{11}^{\alpha} & =\frac{\hbar e^{2}}{VN}V^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\int\frac{d^{2}\boldsymbol{p}}{\left(2\pi\right)^{2}}\int\frac{d^{2}\boldsymbol{q}}{\left(2\pi\right)^{2}}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\left[\int\frac{dz}{\pi}B\left(\epsilon-z\right)A\left(\boldsymbol{p},z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\right]A\left(\boldsymbol{q},\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\\
 & =\frac{1}{V_{uc}}\frac{\hbar e^{2}}{N^{2}}V^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\int\frac{d^{2}\boldsymbol{p}}{\left(2\pi\right)^{2}}\int\frac{d^{2}\boldsymbol{q}}{\left(2\pi\right)^{2}}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\left[\int\frac{dz}{\pi}B\left(\epsilon-z\right)A\left(\boldsymbol{p},z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\right]A\left(\boldsymbol{q},\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\\
 & =\frac{1}{V_{uc}}\frac{\hbar e^{2}}{N_{apl}^{2}N_{L}^{2}}A^{2}L^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\int\frac{d^{2}\boldsymbol{p}}{\left(2\pi\right)^{2}}\int\frac{d^{2}\boldsymbol{q}}{\left(2\pi\right)^{2}}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\left[\int\frac{dz}{\pi}B\left(\epsilon-z\right)A\left(\boldsymbol{p},z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\right]A\left(\boldsymbol{q},\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\\
 & =\frac{1}{V_{uc}}\frac{\hbar e^{2}}{N_{L}^{2}}L^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\left[\int\frac{dz}{\pi}B\left(\epsilon-z\right)\rho\left(z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\right]\rho\left(\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\\
 & =\frac{1}{V_{uc}}\hbar e^{2}\left(2a_{z}\right)^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\left[\int\frac{dz}{\pi}B\left(\epsilon-z\right)\rho\left(z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\right]\rho\left(\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\\
 & =\frac{1}{2a_{z}a_{pl}^{2}}\hbar e^{2}\left(2a_{z}\right)^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\left[\int\frac{dz}{\pi}B\left(\epsilon-z\right)\rho\left(z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\right]\rho\left(\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)\\
 & =\frac{2a_{z}}{a_{pl}^{2}}\hbar e^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\left[\int\frac{dz}{\pi}B\left(\epsilon-z\right)\rho\left(z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\right]\rho\left(\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
which results in
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{11}^{\alpha}=\frac{2a_{z}}{a_{pl}^{2}}\hbar e^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2}\int\frac{d\epsilon}{\pi}\left[\int\frac{dz}{\pi}B\left(\epsilon-z\right)\rho\left(z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\right]\rho\left(\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Now we evaluate 
\begin_inset Formula 
\begin{align*}
\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\left|f^{Z}\left(p_{z},q_{z}\right)\right|^{2} & =\frac{1}{\hbar^{2}}\left[\frac{4g^{2}\lambda}{U}\left(2a_{z}\right)\right]^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\sin\left(p_{z}a_{z}+q_{z}a_{z}\right)^{2}\\
 & =\frac{1}{\hbar^{2}}\left[\frac{4g^{2}\lambda}{U}\left(2a_{z}\right)\right]^{2}\int\frac{dp_{z}}{2\pi}\frac{dq_{z}}{2\pi}\frac{1-\cos\left(p_{z}a_{z}+q_{z}a_{z}\right)}{2}\\
 & =\frac{1}{\hbar^{2}}\left[\frac{4g^{2}\lambda}{U}\left(2a_{z}\right)\right]^{2}\frac{1}{2\pi}\frac{1}{2\pi}\frac{2\pi}{a_{z}}\frac{2\pi}{a_{z}}\frac{1}{2}\\
 & =2\left[\frac{4g^{2}\lambda}{U}\right]^{2}\frac{1}{\hbar^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{11}^{\alpha}=\left(\frac{2a_{z}}{a_{pl}^{2}}\frac{e^{2}}{\hbar}\right)2\left[\frac{4g^{2}}{U}\right]^{2}\int\frac{d\epsilon}{\pi}\int\frac{dz}{\pi}B\left(\epsilon-z\right)\rho\left(z\right)\left(n_{B}\left(\epsilon-z\right)+n_{F}\left(-z\right)\right)\rho\left(\epsilon\right)\left(-\frac{\partial n_{F}\left(\epsilon\right)}{\partial\epsilon}\right)
