f\left(\omega,\omega';\gamma_{0}\right) & =\frac{1}{\pi^{2}\gamma_{0}^{2}}\frac{1}{a_{z}^{2}}\left[2\pi^{2}\gamma_{0}^{2}\delta\left(\omega\right)\delta\left(\omega'\right)\right]\\
