Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", "z"}], "]"}], "-", "1"}]], "-", 
      FractionBox["1", 
       RowBox[{
        RowBox[{"Exp", "[", "\[Mu]", "]"}], "-", "1"}]]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"z", "+", "\[Mu]"}], "]"}], "-", "1"}]], "+", 
      FractionBox["1", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"z", "+", "\[Mu]", "+", "\[Epsilon]"}], "]"}], "+", "1"}]]}],
      ")"}]}], "+", 
   RowBox[{
    FractionBox["1", "4"], 
    RowBox[{"Cosh", "[", 
     FractionBox["\[Epsilon]", "2"], "]"}], 
    RowBox[{"Csch", "[", 
     FractionBox["z", "2"], "]"}], 
    RowBox[{"Csch", "[", 
     FractionBox["\[Mu]", "2"], "]"}], 
    RowBox[{"Sech", "[", 
     FractionBox[
      RowBox[{"\[Mu]", "+", "z", "+", "\[Epsilon]"}], "2"], "]"}]}]}], 
  "]"}]], "Input",
