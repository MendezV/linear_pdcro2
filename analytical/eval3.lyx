\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{11}^{\alpha}=\frac{2e^{2}\kappa\alpha}{\pi}\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\left|f^{\alpha}\left(\boldsymbol{p}+\boldsymbol{q},\boldsymbol{q}\right)\right|^{2}A\left(\boldsymbol{p}+\boldsymbol{q},0\right)A\left(\boldsymbol{q},0\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\boldsymbol{f}\left(\boldsymbol{k},\boldsymbol{k}'\right) & =\frac{4g^{2}}{U}\left(2a_{z}\right)\hat{z}\sin\left(k_{z}a_{z}+k_{z}'a_{z}\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{11}^{\alpha}=\frac{2e^{2}\kappa\alpha}{\pi}\frac{1}{N^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\left|f^{\alpha}\left(\boldsymbol{p},\boldsymbol{q}\right)\right|^{2}A\left(\boldsymbol{p},0\right)A\left(\boldsymbol{q},0\right)
\]

\end_inset

With the spectral function 
\begin_inset Formula 
\[
A\left(\boldsymbol{p},0\right)=\frac{\Gamma_{K}\left(\boldsymbol{p}\right)+\Gamma_{ME}\left(\boldsymbol{p}\right)}{\varepsilon_{\boldsymbol{p}}^{2}+\left(\Gamma_{K}\left(\boldsymbol{p}\right)+\Gamma_{ME}\left(\boldsymbol{p}\right)\right)^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
Taking a circular fermi surface and a completely vertical bare vertex, we
 get 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\sigma_{11}^{\alpha} & =\frac{2e^{2}\kappa\alpha}{\pi}\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{3}}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\left|\frac{4g^{2}}{U}\left(2a_{z}\right)\hat{z}\sin\left(p_{z}a_{z}+q_{z}a_{z}\right)\right|^{2}A\left(\boldsymbol{q},0\right)A\left(\boldsymbol{q},0\right)\\
 & =\frac{2e^{2}\kappa\alpha}{\pi}\left(\frac{8g^{2}}{U}a\right)^{2}\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{3}}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\sin^{2}\left(p_{z}a+q_{z}a\right)A\left(\boldsymbol{p},0\right)A\left(\boldsymbol{q},0\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We focus only on calculating 
\begin_inset Formula 
\[
\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{3}}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\sin^{2}\left(p_{z}a+q_{z}a\right)A\left(\boldsymbol{p},0\right)A\left(\boldsymbol{q},0\right)
\]

\end_inset


\end_layout

\begin_layout Standard
Now we calculate the momentum dependent scattering rate 
\begin_inset Formula 
\begin{align*}
\frac{1}{\tau_{\boldsymbol{k}}} & =2\pi\kappa\alpha\frac{1}{N}\sum_{\bm{k}'}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\left|\frac{4g^{2}}{U}u\left(\boldsymbol{k}\right)u\left(\boldsymbol{k}'\right)\right|^{2}\\
 & =2\pi\kappa\alpha\left(\frac{4g^{2}}{U}u\left(\boldsymbol{k}\right)\right)^{2}\frac{V_{uc}}{V}\sum_{\bm{k}'}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\left|u\left(\boldsymbol{k}'\right)\right|^{2}\\
 & =2\pi\kappa\alpha\left(\frac{4g^{2}}{U}\left[2\cos\left(k_{z}a_{z}\right)\right]\right)^{2}\frac{V_{uc}}{V}\sum_{\bm{k}'}\delta\left(\varepsilon_{\boldsymbol{k}'}\right)\left|\left[2\cos\left(k_{z}'a_{z}\right)\right]\right|^{2}\\
 & =2\pi\kappa\alpha\nu_{0}\left(\frac{4g^{2}}{U}\left[2\cos\left(k_{z}a_{z}\right)\right]\right)^{2}a_{z}\int\frac{dk_{z}'}{2\pi}\left|\left[2\cos\left(k_{z}'a_{z}\right)\right]\right|^{2}\\
 & =2\pi\kappa\alpha\nu_{0}\left(\frac{4g^{2}}{U}\left[2\cos\left(k_{z}a_{z}\right)\right]\right)^{2}4\int\frac{dk_{z}'}{2\pi}\cos\left(k_{z}'\right)^{2}\\
 & =4\pi\kappa\alpha\nu_{0}\left(\frac{4g^{2}}{U}\left[2\cos\left(k_{z}a_{z}\right)\right]\right)^{2}\\
 & =4\pi\kappa\alpha\nu_{0}\left(\frac{8g^{2}}{U}\right)^{2}\cos^{2}\left(k_{z}a_{z}\right)=\frac{1}{\tau_{K,k_{z}}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We can do the same for the Magneto-Elastic term
\begin_inset Formula 
\begin{align*}
\frac{1}{\tau_{\boldsymbol{k}}} & =8\pi\kappa\alpha k_{b}T\frac{\hbar\lambda^{2}}{M\omega_{0}^{2}}\left(\frac{8g^{2}}{U}\right)^{2}\nu_{0}\cos^{2}\left(k_{z}a_{z}\right)\\
 & =\frac{1}{\tau_{ME,k_{z}}}=2\frac{k_{b}T}{\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}\frac{1}{\tau_{K,k_{z}}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
the extra factor of 2 comes from the two phonon branches.
 The total scattering rate is then 
\begin_inset Formula 
\begin{align*}
\gamma_{k_{z}}=\frac{1}{\tau_{k_{z}}} & =\frac{1}{\tau_{ME,k_{z}}}+\frac{1}{\tau_{ME,k_{z}}}\\
 & =\frac{1}{\tau_{K,k_{z}}}\left(1+2\frac{k_{b}T}{\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}\right)\\
 & =4\pi\kappa\alpha\nu_{0}\left(\frac{8g^{2}}{U}\right)^{2}\cos^{2}\left(k_{z}a_{z}\right)\left(1+2\frac{k_{b}T}{\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Then, we have 
\begin_inset Formula 
\[
\tau_{k_{z}}=\tau_{K,k_{z}}\frac{1}{1+2\frac{k_{b}T}{\omega_{0}}\frac{\hbar\lambda^{2}}{M\omega_{0}}}
\]

\end_inset


\end_layout

\begin_layout Standard
Now we have 
\begin_inset Formula 
\[
A\left(\boldsymbol{p},0\right)=\frac{\gamma_{p_{z}}}{\varepsilon_{\boldsymbol{p}}^{2}+\gamma_{p_{z}}^{2}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{3}}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\sin^{2}\left(p_{z}a+q_{z}a\right)\frac{\gamma_{p_{z}}}{\varepsilon_{\boldsymbol{p}}^{2}+\gamma_{p_{z}}^{2}}\frac{\gamma_{q_{z}}}{\varepsilon_{\boldsymbol{q}}^{2}+\gamma_{q_{z}}^{2}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{d}}f\left(\varepsilon_{\boldsymbol{p}}\right) & =\int d\epsilon\delta\left(\epsilon-\varepsilon_{\boldsymbol{p}}\right)\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{d}}f\left(\varepsilon_{\boldsymbol{p}}\right)\\
 & =\int d\epsilon f\left(\epsilon\right)\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{d}}\delta\left(\epsilon-\varepsilon_{\boldsymbol{p}}\right)\\
 & =\int d\epsilon f\left(\epsilon\right)\rho\left(\epsilon\right)\\
 & \sim\nu_{0}\int d\epsilon f\left(\epsilon\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\int\frac{d\boldsymbol{p}}{\left(2\pi\right)^{3}}\int\frac{d\boldsymbol{q}}{\left(2\pi\right)^{3}}\sin^{2}\left(p_{z}a+q_{z}a\right)\frac{\gamma_{p_{z}}}{\varepsilon_{\boldsymbol{p}}^{2}+\gamma_{p_{z}}^{2}}\frac{\gamma_{q_{z}}}{\varepsilon_{\boldsymbol{q}}^{2}+\gamma_{q_{z}}^{2}}\\
=\nu_{0}^{2}\int\frac{dp_{z}}{\left(2\pi\right)}\int\frac{dq_{z}}{\left(2\pi\right)}\int d\epsilon d\nu\sin^{2}\left(p_{z}a+q_{z}a\right)\frac{\gamma_{p_{z}}}{\nu^{2}+\gamma_{p_{z}}^{2}}\frac{\gamma_{q_{z}}}{\epsilon^{2}+\gamma_{q_{z}}^{2}}\\
=4\nu_{0}^{2}\int\frac{dp_{z}}{\left(2\pi\right)}\int\frac{dq_{z}}{\left(2\pi\right)}\sin^{2}\left(p_{z}a+q_{z}a\right)\tan^{-1}\left(\frac{W}{\gamma_{p_{z}}}\right)\tan^{-1}\left(\frac{W}{\gamma_{q_{z}}}\right)\\
\sim\nu_{0}^{2}\int\frac{dp_{z}}{2}\int\frac{dq_{z}}{2}\sin^{2}\left(p_{z}a+q_{z}a\right)\\
=\nu_{0}^{2}\left(\frac{\pi}{2a}\right)^{2}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Then we have 
\begin_inset Formula 
\begin{align*}
\sigma_{11}^{\alpha}=\frac{2e^{2}\kappa\alpha}{\pi}\left(\frac{8g^{2}}{U}a\right)^{2}\nu_{0}^{2}\left(\frac{\pi}{2a}\right)^{2}\\
=2e^{2}\pi\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\nu_{0}^{2}\\
=\frac{e^{2}n}{m}\frac{2\pi m\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\nu_{0}^{2}}{n}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
the density of states is 
\begin_inset Formula 
\[
\frac{\pi k_{F}^{2}}{4\pi^{2}}=\frac{mk_{F}^{2}}{2\pi\left(2m\right)}=\frac{mE_{F}}{2\pi}=\frac{N}{V}=n
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{2\pi m\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\left(\frac{m}{2\pi}\right)^{2}}{\frac{\pi k_{F}^{2}}{4\pi^{2}}} & =\frac{m^{3}\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}}{\frac{k_{F}^{2}}{2}}\\
\sigma_{11}^{\alpha}= & =\left(2\pi\right)^{2}m\frac{\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\nu_{0}^{2}}{\frac{k_{F}^{2}}{2}}\\
 & =\left(2\pi\right)^{2}\frac{\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\nu_{0}^{2}}{\frac{k_{F}^{2}}{2m}}\\
 & =\left(2\pi\right)^{2}\frac{\kappa\alpha\left(\frac{4g^{2}}{U}\right)^{2}\nu_{0}^{2}}{E_{F}}\\
 & =\left(2\pi\right)^{2}\frac{\lambda_{K}}{E_{F}}\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
So we have 
\begin_inset Formula 
\[
\sigma_{11}^{\alpha}=\frac{e^{2}n}{m}\left[\left(2\pi\right)^{2}\frac{\lambda_{K}}{E_{F}}\right]
\]

\end_inset


\end_layout

