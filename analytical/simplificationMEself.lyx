\begin_layout Standard
Therefore, we only need to verify that 
\begin_inset Formula 
\begin{align*}
n_{B}\left(-\nu+\epsilon_{\boldsymbol{k}}-\epsilon_{\boldsymbol{p}}\right)n_{F}\left(\epsilon_{\boldsymbol{p}}\right)\left(1-n_{F}\left(-\nu+\epsilon_{\boldsymbol{k}}\right)\right)\left[n_{B}\left(-\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{k}}\right)\right] & =\\
n_{B}\left(\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)n_{F}\left(\epsilon_{\boldsymbol{k}}\right)\left(1-n_{F}\left(\nu+\epsilon_{\boldsymbol{p}}\right)\right)\left[n_{B}\left(\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{p}}\right)\right]
\end{align*}

\end_inset


