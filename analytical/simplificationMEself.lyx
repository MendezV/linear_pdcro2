\begin_layout Standard
we want to check whether this is symmetric with respect to the interchange
 of 
\begin_inset Formula $\boldsymbol{p}$
\end_inset

 and 
\begin_inset Formula $\boldsymbol{k}$
\end_inset

.
 From our previous calculations, we have 
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\frac{1}{kT}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\nu-\epsilon_{\boldsymbol{k}}\right)B\left(\boldsymbol{q},\nu-\epsilon_{\boldsymbol{p}}\right)n_{B}\left(\nu-\epsilon_{\boldsymbol{k}}\right)n_{F}\left(\epsilon_{\boldsymbol{k}}\right)\left(1-n_{F}\left(\nu\right)\right)\left[n_{B}\left(\nu-\epsilon_{\boldsymbol{p}}\right)+n_{F}\left(-\epsilon_{\boldsymbol{p}}\right)\right]
\]

\end_inset


\end_layout

\begin_layout Standard
This form is vaguely intuitive as it is the convolution of the transition
 rate for scattering off of spins convolved with the one for phonons.
 Now we change variables so that the dispersion only appears in a single
 spectral function
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
P_{\boldsymbol{k}\boldsymbol{p}}=\frac{1}{kT}\left|\tilde{\lambda}\left(\boldsymbol{p},\boldsymbol{k}\right)\right|^{2}\sum_{\boldsymbol{q}}\int\frac{d\nu}{\pi}\chi''\left(\boldsymbol{p}-\boldsymbol{k}-\boldsymbol{q},\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)B\left(\boldsymbol{q},\nu\right)n_{B}\left(\nu+\epsilon_{\boldsymbol{p}}-\epsilon_{\boldsymbol{k}}\right)n_{F}\left(\epsilon_{\boldsymbol{k}}\right)\left(1-n_{F}\left(\nu+\epsilon_{\boldsymbol{p}}\right)\right)\left[n_{B}\left(\nu\right)+n_{F}\left(-\epsilon_{\boldsymbol{p}}\right)\right]
