H_{\text{int}}=\frac{4g^{2}}{U}\sum_{\substack{\langle i,j,k\rangle\\
\alpha\beta
}
}\left[1-\lambda(X_{ij}+X_{kj})\right]p_{i\alpha}^{\dagger}(\vec{S}_{j}\cdot\vec{\sigma}_{\alpha\beta})p_{k\beta}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
defining 
\begin_inset Formula 
\[
g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)=\frac{4g^{2}}{U}e^{-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{k}}
\]

\end_inset


\end_layout

\begin_layout Standard
which has the property (which works even with the position dependent hybridizati
ons)
\begin_inset Formula 
\[
g_{ij}\left(\boldsymbol{k},\boldsymbol{k}'\right)=\overline{g_{ji}\left(\boldsymbol{k}',\boldsymbol{k}\right)}
\]

\end_inset


\end_layout

\begin_layout Standard
Then we have 
\begin_inset Formula 
\begin{align*}
-\frac{\lambda}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{\substack{ik\\
\alpha\beta
}
}\left(g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)+\overline{g_{ki}\left(\boldsymbol{k},\boldsymbol{k}'\right)}X_{k}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
-\frac{\lambda}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{\substack{ik\\
\alpha\beta
}
}\left(g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)+\overline{g_{ik}\left(\boldsymbol{k}',\boldsymbol{k}\right)}X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
-\frac{\lambda}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{\substack{ik\\
\alpha\beta
}
}\left(g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)+\overline{g_{ik}\left(\boldsymbol{k}',\boldsymbol{k}\right)}\right)X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
-\frac{1}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{i\alpha\beta}\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we defined 
\begin_inset Formula 
\begin{align*}
\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right) & =-\lambda\sum_{k}\left(g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)+\overline{g_{ik}\left(\boldsymbol{k}',\boldsymbol{k}\right)}\right)\\
 & =-\frac{4g^{2}\lambda}{U}\sum_{k}e^{-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{k}}+e^{-i\bm{k}\bm{R}_{k}+i\bm{k}'\bm{R}_{i}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
with the property 
\begin_inset Formula 
\[
\overline{\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)}=\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)
\]

\end_inset


\end_layout

\begin_layout Standard
just to check that no obvious mistake was made I test for hermiticity 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{1}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{i\alpha\beta}\overline{\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)}\overline{X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)}p_{\boldsymbol{k}'\beta}^{\dagger}\left[\overline{\vec{S}_{\boldsymbol{q}}}\cdot\overline{\vec{\sigma}_{\alpha\beta}}\right]p_{\boldsymbol{k}\alpha} & \text{hermitean conj}\\
\frac{1}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{i\alpha\beta}\overline{\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)}X_{i}\left(\boldsymbol{k}'+\boldsymbol{q}-\boldsymbol{k}\right)p_{\boldsymbol{k}'\beta}^{\dagger}\left[\vec{S}_{-\boldsymbol{q}}\cdot\vec{\sigma}_{\beta\alpha}\right]p_{\boldsymbol{k}\alpha} & \text{FT of X and S}\\
\frac{1}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{i\alpha\beta}\overline{\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)}X_{i}\left(\boldsymbol{k}'-\boldsymbol{q}-\boldsymbol{k}\right)p_{\boldsymbol{k}'\beta}^{\dagger}\left[\vec{S}_{+\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}\alpha} & \boldsymbol{q}\rightarrow-\boldsymbol{q}\\
\frac{1}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{i\alpha\beta}\lambda_{i}\left(\boldsymbol{k}',\boldsymbol{k}\right)X_{i}\left(\boldsymbol{k}'-\boldsymbol{q}-\boldsymbol{k}\right)p_{\boldsymbol{k}'\beta}^{\dagger}\left[\vec{S}_{+\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}\alpha} & \text{symmetry }\alpha_{i}\\
\frac{1}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{i\alpha\beta}\lambda_{i}\left(\boldsymbol{k},\boldsymbol{k}'\right)X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}
\end{align*}

\end_inset


\end_layout

