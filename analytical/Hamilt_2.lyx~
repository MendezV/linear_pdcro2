\begin_layout Standard
For the first term in the interaction Hamiltonian, we have 
\begin_inset Formula 
\[
H_{\text{int}}=H_{\text{int}}^{I}+H_{\text{int}}^{II}
\]

\end_inset


\end_layout

\begin_layout Standard
where we have:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
H_{\text{int}}^{I} & =\frac{1}{N^{3/2}}\frac{4}{U}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{\substack{\langle i,j,k\rangle\\
\alpha\beta
}
}g_{i0}g_{k0}e^{-i\bm{q}\bm{R}_{j}-i\bm{k}\left(\bm{R}_{j}+\bm{R}_{i}\right)+i\bm{k}'\left(\bm{R}_{j}+\bm{R}_{k}\right)}p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
 & =\frac{1}{\sqrt{N}}\sum_{ik}\sum_{\substack{\bm{k}\bm{k}'\\
\alpha\beta
}
}g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{k}-\boldsymbol{k}'}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
 & =\frac{1}{\sqrt{N}}\sum_{\substack{\bm{k}\bm{k}'\\
\alpha\beta
}
}g\left(\boldsymbol{k},\boldsymbol{k}'\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{k}-\boldsymbol{k}'}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
and we defined the form factor
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)=\frac{4}{U}g_{i0}g_{k0}e^{-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{k}}
\]

\end_inset


\end_layout

\begin_layout Standard
and 
\begin_inset Formula 
\[
g\left(\boldsymbol{k},\boldsymbol{k}'\right)=\sum_{ik}g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)
\]

\end_inset


\end_layout

\begin_layout Standard
If we do the same for the phonon part 
\begin_inset Formula 
\begin{align*}
H_{\text{int}}^{II} & =-\lambda\frac{1}{N^{2}}\frac{4}{U}\sum_{\bm{k}\bm{k}'\bm{q}\boldsymbol{q}'}\sum_{\substack{\langle i,j,k\rangle\\
\alpha\beta
}
}g_{ij}g_{kj}\left(X_{i}\left(\boldsymbol{q}'\right)+X_{k}\left(\boldsymbol{q}'\right)\right)e^{-i\bm{q}\bm{R}_{j}-i\bm{k}\bm{R}_{i}+i\bm{k}'\bm{R}_{k}-i\bm{q}'\bm{R}_{j}}p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}\\
 & =-\frac{\lambda}{N}\sum_{\bm{k}\bm{k}'\bm{q}}\sum_{\substack{ik\\
\alpha\beta
}
}g_{ik}\left(\boldsymbol{k},\boldsymbol{k}'\right)\left(X_{i}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)+X_{k}\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{q}\right)\right)p_{\boldsymbol{k}\alpha}^{\dagger}\left[\vec{S}_{\boldsymbol{q}}\cdot\vec{\sigma}_{\alpha\beta}\right]p_{\boldsymbol{k}'\beta}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
If we assume that the 
\begin_inset Formula $g_{kj}$
