\Pi\left(\boldsymbol{k},i\omega_{n}\right) & =\frac{1}{\beta}\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{iz_{n}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}B\left(\boldsymbol{p}-\boldsymbol{q},z\right)A\left(\boldsymbol{p},\nu\right)A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)\left(\frac{n_{F}\left(\nu\right)-n_{F}\left(iz_{n}+z\right)}{\nu-iz_{n}-z}\right)\frac{1}{i\omega_{n}+iz_{n}-\epsilon}\\
 & =\frac{1}{\beta}\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{iz_{n}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}B\left(\boldsymbol{p}-\boldsymbol{q},z\right)A\left(\boldsymbol{p},\nu\right)A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)\left(\frac{n_{F}\left(\nu\right)+n_{B}\left(z\right)}{\nu-iz_{n}-z}\right)\frac{1}{i\omega_{n}+iz_{n}-\epsilon}\\
 & =-\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}B\left(\boldsymbol{p}-\boldsymbol{q},z\right)A\left(\boldsymbol{p},\nu\right)A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)\left[n_{F}\left(\nu\right)+n_{B}\left(z\right)\right]\frac{n_{F}\left(\nu-z\right)-n_{F}\left(\epsilon-i\omega_{n}\right)}{\nu-z-\epsilon+i\omega_{n}}\\
 & =\sum_{\boldsymbol{q}\boldsymbol{p}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}B\left(\boldsymbol{p}-\boldsymbol{q},z\right)A\left(\boldsymbol{p},\nu\right)A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)\left[n_{F}\left(\nu\right)+n_{B}\left(z\right)\right]\frac{n_{F}\left(\epsilon\right)-n_{F}\left(\nu-z\right)}{i\omega_{n}+\nu-z-\epsilon}
\end{align*}

