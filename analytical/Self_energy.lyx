\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\frac{n_{F}\left(\nu\right)-n_{F}\left(z+\epsilon\right)}{i\omega_{n}+\nu-z-\epsilon}\left(n_{F}\left(\epsilon\right)+n_{B}\left(-z\right)\right)\\
=\frac{n_{F}\left(\epsilon\right)-n_{F}\left(z+\nu\right)}{i\omega_{n}+\epsilon-z-\nu}\left(n_{F}\left(\nu\right)+n_{B}\left(-z\right)\right)\\
=\frac{n_{F}\left(\epsilon\right)-n_{F}\left(z+\nu\right)}{i\omega_{n}+\epsilon-z-\nu}\left(n_{F}\left(\nu\right)+n_{B}\left(-z\right)\right)\\
=\frac{n_{F}\left(-\epsilon\right)-n_{F}\left(z-\nu\right)}{i\omega_{n}-\epsilon-z+\nu}\left(n_{F}\left(-\nu\right)+n_{B}\left(-z\right)\right)\\
=-\frac{n_{F}\left(\epsilon\right)-n_{F}\left(\nu-z\right)}{i\omega_{n}-\epsilon-z+\nu}\left(n_{F}\left(-\nu\right)+n_{B}\left(-z\right)\right)\\
=\frac{n_{F}\left(\epsilon\right)-n_{F}\left(\nu-z\right)}{i\omega_{n}-\epsilon-z+\nu}\left(n_{F}\left(\nu\right)+n_{B}\left(z\right)\right)
\end{align*}

