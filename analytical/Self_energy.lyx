\Pi\left(\boldsymbol{k},i\omega_{n}\right) & =\frac{1}{\beta^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{i\nu_{n}iz_{n}}D\left(\boldsymbol{p}-\boldsymbol{q},i\nu_{n}-iz_{n}\right)\mathcal{G}\left(\boldsymbol{p},i\nu_{n}\right)\mathcal{G}\left(\boldsymbol{k}+\boldsymbol{q},i\omega_{n}+iz_{n}\right)\\
 & =\frac{1}{\beta^{2}}\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{i\nu_{n}iz_{n}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}\frac{B\left(\boldsymbol{p}-\boldsymbol{q},z\right)}{i\nu_{n}-iz_{n}-z}\frac{A\left(\boldsymbol{p},\nu\right)}{i\nu_{n}-\nu}\frac{A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)}{i\omega_{n}+iz_{n}-\epsilon}
\end{align*}

\end_inset


