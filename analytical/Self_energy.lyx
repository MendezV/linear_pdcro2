\int\frac{d\nu}{\pi}\frac{d\mu}{\pi}\frac{dz}{\pi}B\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{p},z\right)C\left(\boldsymbol{p},\mu\right)A\left(\boldsymbol{k},\nu\right)\left[n_{B}\left(-z\right)-n_{B}\left(\mu\right)\right]\left[\frac{n_{F}\left(ik_{n}'+z+\mu\right)-n_{F}\left(\nu\right)}{ik_{n}'+z+\mu-\nu}\right]\\
\int\frac{d\nu}{\pi}\frac{d\mu}{\pi}\frac{dz}{\pi}B\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{p},z\right)C\left(\boldsymbol{p},\mu\right)A\left(\boldsymbol{k},\nu\right)\left[n_{B}\left(-z\right)-n_{B}\left(\mu\right)\right]\left[-\frac{n_{B}\left(z+\mu\right)+n_{F}\left(\nu\right)}{ik_{n}'+z+\mu-\nu}\right]
\end{align*}

