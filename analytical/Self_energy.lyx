\begin_layout Standard
We first perform the sum 
\begin_inset Formula 
\begin{align*}
 & \frac{1}{\beta}\sum_{ip_{n}}D\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{p},ik_{n}-ip_{n}-ik_{n}'\right)S\left(\boldsymbol{p},ip_{n}\right)\\
 & =\int\frac{d\mu}{\pi}\frac{dz}{\pi}\frac{1}{\beta}\sum_{p_{n}}\frac{B\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{p},z\right)}{ik_{n}-ip_{n}-ik_{n}'-z}\frac{C\left(\boldsymbol{p},\mu\right)}{ip_{n}-\mu}\\
 & =\int\frac{d\mu}{\pi}\frac{dz}{\pi}B\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{p},z\right)C\left(\boldsymbol{p},\mu\right)\left(\frac{n_{B}\left(ik_{n}-ik_{n}'-z\right)-n_{B}\left(\mu\right)}{ik_{n}-ik_{n}'-z-\mu}\right)\\
 & =\int\frac{d\mu}{\pi}\frac{dz}{\pi}B\left(\boldsymbol{k}-\boldsymbol{k}'-\boldsymbol{p},z\right)C\left(\boldsymbol{p},\mu\right)\left(\frac{n_{B}\left(-z\right)-n_{B}\left(\mu\right)}{ik_{n}-ik_{n}'-z-\mu}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
