 & =\frac{1}{\beta}\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{i\nu_{n}iz_{n}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}B\left(\boldsymbol{p}-\boldsymbol{q},z\right)A\left(\boldsymbol{p},\nu\right)A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)\frac{n_{F}\left(\epsilon\right)+n_{B}\left(-z\right)}{i\nu_{n}-z+i\omega_{n}-\epsilon}\frac{1}{i\nu_{n}-\nu}\\
\\
 & =\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{i\nu_{n}iz_{n}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}B\left(\boldsymbol{p}-\boldsymbol{q},z\right)A\left(\boldsymbol{p},\nu\right)A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)\frac{n_{F}\left(z+\epsilon-i\omega_{n}\right)-n_{F}\left(\nu\right)}{z+\epsilon-i\omega_{n}-\nu}\left(n_{F}\left(\epsilon\right)+n_{B}\left(-z\right)\right)\\
 & =\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{i\nu_{n}iz_{n}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}B\left(\boldsymbol{p}-\boldsymbol{q},z\right)A\left(\boldsymbol{p},\nu\right)A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)\frac{n_{F}\left(z+\epsilon\right)-n_{F}\left(\nu\right)}{z+\epsilon-i\omega_{n}-\nu}\left(n_{F}\left(\epsilon\right)+n_{B}\left(-z\right)\right)\\
 & =\sum_{\boldsymbol{q}\boldsymbol{p}}\sum_{i\nu_{n}iz_{n}}\int\frac{d\epsilon}{\pi}\int\frac{d\nu}{\pi}\int\frac{dz}{\pi}B\left(\boldsymbol{p}-\boldsymbol{q},z\right)A\left(\boldsymbol{p},\nu\right)A\left(\boldsymbol{k}+\boldsymbol{q},\epsilon\right)\frac{n_{F}\left(\nu\right)-n_{F}\left(z+\epsilon\right)}{i\omega_{n}+\nu-z-\epsilon}\left(n_{F}\left(\epsilon\right)+n_{B}\left(-z\right)\right)
