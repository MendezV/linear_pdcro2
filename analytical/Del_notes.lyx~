\sigma=\beta\frac{N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int\frac{d\epsilon}{2\pi}\frac{d\nu}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon\right)A_{\text{Pd}}\left(\bm{k},\epsilon+\nu\right)S\left(\bm{q},\nu\right)\left(n_{F}\left(\epsilon\right)-n_{F}\left(\epsilon+\nu\right)\right)n_{b}\left(\nu\right)
\end{equation}

\end_inset


