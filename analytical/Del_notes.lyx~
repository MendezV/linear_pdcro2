\Pi\left(\omega\right) & =\frac{2N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int\frac{d\epsilon_{1}}{2\pi}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)\int_{0}^{\infty}\frac{d\nu}{2\pi}\frac{S\left(\bm{q},\nu\right)}{1+n_{B}\left(\nu\right)}\left(n_{F}\left(\epsilon_{1}\right)-n_{F}\left(\epsilon_{2}\right)\right)\\
 & \times\left(\frac{n_{B}\left(\nu\right)-n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)}{\epsilon_{2}-\epsilon_{1}+\nu}+\frac{n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)+1+n_{B}\left(\nu\right)}{\epsilon_{2}-\epsilon_{1}-\nu}-\frac{n_{B}\left(\nu\right)-n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)}{\omega+i\delta+\epsilon_{2}-\epsilon_{1}+\nu}-\frac{n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)+1+n_{B}\left(\nu\right)}{\omega+i\delta+\epsilon_{2}-\epsilon_{1}-\nu}\right)
\end{align}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
At this point, after performing the matsubara sumations, this function vanishes
 at finite temperature at zero frequency signaling a regular limit at zero
 frequency for the conductivity at finite temperature.
 To calculate the DC conductivity, we need 
\begin_inset Formula 
\begin{align}
\sigma & =\lim_{\omega\rightarrow0}\text{Re}\left[\frac{\Pi\left(\omega\right)}{i\omega}\right]\\
 & =\lim_{\omega\rightarrow0}\text{Im}\left[\frac{\Pi\left(\omega\right)}{\omega}\right]\\
 & =-\lim_{\omega\rightarrow0}\text{Im}\frac{1}{\omega}\frac{2N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int\frac{d\epsilon_{1}}{2\pi}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)\int_{0}^{\infty}\frac{d\nu}{2\pi}\frac{S\left(\bm{q},\nu\right)}{1+n_{B}\left(\nu\right)}\\
 & \times\left(n_{F}\left(\epsilon_{1}\right)-n_{F}\left(\epsilon_{2}\right)\right)\left(\frac{n_{B}\left(\nu\right)-n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)}{\omega+i\delta+\epsilon_{2}-\epsilon_{1}+\nu}+\frac{n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)+1+n_{B}\left(\nu\right)}{\omega+i\delta+\epsilon_{2}-\epsilon_{1}-\nu}\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
At this point, we use the Sokhotski-Plemej formula: 
\begin_inset Newline newline
\end_inset


\begin_inset Formula 
\begin{equation}
\frac{1}{\omega+\zeta\pm i\delta}=P\frac{1}{\omega+\zeta}\mp i\pi\delta\left(\omega+\zeta\right),
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\sigma & =\lim_{\omega\rightarrow0}\frac{1}{\omega}\frac{2N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int\frac{d\epsilon_{1}}{2\pi}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)\int_{0}^{\infty}\frac{d\nu}{2\pi}\frac{S\left(\bm{q},\nu\right)}{1+n_{B}\left(\nu\right)}\left(n_{F}\left(\epsilon_{1}\right)-n_{F}\left(\epsilon_{2}\right)\right)\\
 & \times\left(\left(n_{B}\left(\nu\right)-n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)\right)\pi\delta\left(\omega+\epsilon_{2}-\epsilon_{1}+\nu\right)+\left(n_{B}\left(\epsilon_{1}-\epsilon_{2}\right)+1+n_{B}\left(\nu\right)\right)\pi\delta\left(\omega+\epsilon_{2}-\epsilon_{1}-\nu\right)\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Now we integrate over 
\begin_inset Formula $\epsilon_{1}$
\end_inset

 and omit the limit for the moment
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\sigma & =\frac{1}{\omega}\frac{N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)A_{\text{Pd}}\left(\bm{k},\omega+\epsilon_{2}+\nu\right)\int_{0}^{\infty}\frac{d\nu}{2\pi}\frac{S\left(\bm{q},\nu\right)}{1+n_{B}\left(\nu\right)}\left(n_{F}\left(\omega+\epsilon_{2}+\nu\right)-n_{F}\left(\epsilon_{2}\right)\right)\\
 & \times\left(\left(n_{B}\left(\nu\right)-n_{B}\left(\omega+\nu\right)\right)\right)\\
 & +\frac{1}{\omega}\frac{N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int\frac{d\epsilon_{2}}{2\pi}\int_{0}^{\infty}\frac{d\nu}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)A_{\text{Pd}}\left(\bm{k},\omega+\epsilon_{2}-\nu\right)\frac{S\left(\bm{q},\nu\right)}{1+n_{B}\left(\nu\right)}\left(n_{F}\left(\omega+\epsilon_{2}-\nu\right)-n_{F}\left(\epsilon_{2}\right)\right)\\
 & \times\left(\left(n_{B}\left(\omega-\nu\right)+1+n_{B}\left(\nu\right)\right)\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Using the property of the bose funcition for transforming negative arguments
 into positive arguments, we get 
\begin_inset Formula 
\begin{align*}
\sigma & =\frac{N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int\frac{d\epsilon_{2}}{2\pi}\int_{0}^{\infty}\frac{d\nu}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)A_{\text{Pd}}\left(\bm{k},\omega+\epsilon_{2}+\nu\right)\frac{S\left(\bm{q},\nu\right)}{1+n_{B}\left(\nu\right)}\left(n_{F}\left(\omega+\epsilon_{2}+\nu\right)-n_{F}\left(\epsilon_{2}\right)\right)\\
 & \times\frac{\left(n_{B}\left(\nu\right)-n_{B}\left(\omega+\nu\right)\right)}{\omega}\\
 & +\frac{N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int\frac{d\epsilon_{2}}{2\pi}\int_{0}^{\infty}\frac{d\nu}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)A_{\text{Pd}}\left(\bm{k},\omega+\epsilon_{2}-\nu\right)\frac{S\left(\bm{q},\nu\right)}{1+n_{B}\left(\nu\right)}\left(n_{F}\left(\omega+\epsilon_{2}-\nu\right)-n_{F}\left(\epsilon_{2}\right)\right)\\
 & \times\frac{\left(n_{B}\left(\nu\right)-n_{B}\left(\nu-\omega\right)\right)}{\omega}
\end{align*}

\end_inset


\end_layout

