\begin_body

\begin_layout Title
Out of plane conductivity
\end_layout

\begin_layout Standard
We will perform a simplified calculation starting from the path integral
 
\begin_inset Formula 
\begin{equation}
\mathcal{Z}\left[A,t_{p}\right]=\int\left[\mathcal{D}p\mathcal{D}\bm{S}\right]e^{-\sum_{\alpha}S_{\alpha}+\int d\tau\sum_{j,\sigma\sigma',\alpha}t_{g}e^{ieAd}\bm{S}_{i}^{\alpha}\cdot\bm{\sigma}_{\sigma'\sigma}p_{j\sigma'\alpha+1}^{\dagger}p_{j\sigma\alpha}+\text{h.c}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
where the action is given by 
\begin_inset Formula 
\begin{equation}
S_{\alpha}=\int_{0}^{\beta}d\tau p_{i\sigma\alpha}^{\dagger}\partial_{\tau}p_{i\sigma\alpha}-t_{p}\sum_{\left\langle ij\right\rangle \sigma}p_{i\sigma\alpha}^{\dagger}p_{j\sigma\alpha}+\frac{4t_{c}^{2}}{U}\sum_{\left\langle ij\right\rangle }^{n.n}\bm{S}_{i}^{\alpha}\cdot\bm{S}_{j}^{\alpha},
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $d$
\end_inset

 is the interlayer distance, 
\begin_inset Formula $t_{g}=g^{2}/U$
\end_inset

 and 
\begin_inset Formula $\alpha$
\end_inset

 is a layer index.
 To calculate the conductivity we need to evaluate 
\begin_inset Formula 
\begin{align}
\sigma\left(\omega\right) & =\frac{1}{i\omega}\frac{J\left(\omega\right)}{A\left(\omega\right)}\\
 & =-\frac{1}{i\omega}\frac{\delta^{2}}{\delta A\left(\omega\right)^{2}}\left(-\frac{1}{\beta}\log\left(\frac{\mathcal{Z}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}\right)\right),\\
 & =-\frac{1}{i\omega}\frac{\delta^{2}}{\delta A\left(\omega\right)^{2}}F\left[A\right]
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Expanding the interlayer term in the path integral to second order in the
 hopping amplitude we get
\begin_inset Formula 
\begin{align}
e^{\int d\tau\sum_{j,\sigma\sigma',\alpha}t_{g}e^{ieAd}\bm{S}_{i}^{\alpha}\cdot\bm{\sigma}_{\sigma'\sigma}p_{j\sigma'\alpha+1}^{\dagger}p_{j\sigma\alpha}+\text{h.c}} & \sim1+\int d\tau\sum_{j,\sigma\sigma',\alpha}t_{g}e^{ieAd}\bm{S}_{j}^{\alpha}\cdot\bm{\sigma}_{\sigma'\sigma}p_{j\sigma'\alpha+1}^{\dagger}p_{j\sigma\alpha}+\text{h.c}\\
 & +\frac{1}{2}\left(\int d\tau\sum_{j,\sigma\sigma',\alpha}t_{g}e^{ieAd}\bm{S}_{j}^{\alpha}\cdot\bm{\sigma}_{\sigma'\sigma}p_{j\sigma'\alpha+1}^{\dagger}p_{j\sigma\alpha}+\text{h.c}\right)^{2}
\end{align}

\end_inset


\end_layout

\begin_layout Standard
We get then 
\begin_inset Formula 
\begin{equation}
\log\left(1-\left(1-\frac{\mathcal{Z}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}\right)\right)\sim\log\left(1-\frac{\mathcal{Z}_{1}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}-\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}+\mathcal{O}\left(t_{g}^{4}\right)\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
with 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\mathcal{Z}_{1}\left[A,t_{p}\right]=\int\left[\mathcal{D}p\right]e^{-\sum_{\alpha}S_{\alpha}}\left(\int d\tau\sum_{j,\sigma\sigma',\alpha}t_{g}e^{ieAd}\bm{S}_{j}^{\alpha}\cdot\bm{\sigma}_{\sigma'\sigma}p_{j\sigma'\alpha+1}^{\dagger}p_{j\sigma\alpha}+\text{h.c}\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
and 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\mathcal{Z}_{2}\left[A,t_{p}\right]=\int\left[\mathcal{D}p\right]e^{-\sum_{\alpha}S_{\alpha}}\frac{1}{2}\left(\int d\tau\sum_{j,\sigma\sigma',\alpha}t_{g}e^{ieAd}\bm{S}_{j}^{\alpha}\cdot\bm{\sigma}_{\sigma'\sigma}p_{j\sigma'\alpha+1}^{\dagger}p_{j\sigma\alpha}+\text{h.c}\right)^{2}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
We find that since the zeroth order action does not connect sites on adjacent
 layer, 
\begin_inset Formula $\mathcal{Z}_{1}=0$
\end_inset

 identically and 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\log\left(1-\left(1-\frac{\mathcal{Z}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}\right)\right)=\log\left(1-\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}+\mathcal{O}\left(t_{g}^{4}\right)\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
so we focus on 
\begin_inset Formula $\mathcal{Z}_{2}$
\end_inset

.
 Take the definition 
\begin_inset Formula 
\begin{equation}
\Gamma_{\sigma\sigma'\alpha}\left(A,\tau\right)=t_{g}e^{ieA\left(\tau\right)d}\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{\sigma}_{\sigma'\sigma}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
The term in parenthesis in the definition of 
\begin_inset Formula $\mathcal{Z}_{2}$
\end_inset

 is equivalent to 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\int d\tau\sum_{j,\sigma_{1}\sigma_{2},\alpha}\int d\tau'\sum_{j',\sigma_{1}',\sigma_{2}',\alpha'}\left(\Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)p_{j\sigma_{2}\alpha+1}^{\dagger}p_{j\sigma_{1}\alpha}+\text{h.c}\right)\left(\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}\left(A,\tau'\right)p_{j'\sigma_{2}'\alpha'+1}^{\dagger}p_{j'\sigma_{1}'\alpha'}+\text{h.c}\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Consequently, we have the following equality 
\begin_inset Formula 
\begin{equation}
\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}=\frac{1}{2}\int d\tau\sum_{j,\sigma_{1}\sigma_{2},\alpha}\int d\tau'\sum_{j',\sigma_{1}',\sigma_{2}',\alpha'}\left\langle \left(\Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)p_{j\sigma_{2}\alpha+1}^{\dagger}p_{j\sigma_{1}\alpha}+\text{h.c}\right)\left(\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}\left(A,\tau'\right)p_{j'\sigma_{2}'\alpha'+1}^{\dagger}p_{j'\sigma_{1}'\alpha'}+\text{h.c}\right)\right\rangle _{0}
\end{equation}

\end_inset

where the time-ordered expectation value is taken with respect to the unperturbe
d system without interlayer hopping.
 We now expand the product of the two terms in parenthesis
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\left\langle \left(\Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)+\text{h.c}\right)\left(\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}\left(A,\tau'\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)+\text{h.c}\right)\right\rangle _{0}\\
\\
=\left\langle \Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)\right\rangle _{0}\\
+\left\langle \Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)p_{j'\sigma_{2}'\alpha'+1}^{\dagger}\left(\tau'\right)p_{j'\sigma_{1}'\alpha'}\left(\tau'\right)\right\rangle _{0}\\
+\left\langle \overline{\Gamma_{\sigma_{1}\sigma_{2}\alpha}}\left(A,\tau\right)\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}p_{j\sigma_{1}\alpha}^{\dagger}\left(\tau\right)p_{j\sigma_{2}\alpha+1}\left(\tau\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)\right\rangle _{0}\\
+\left\langle \overline{\Gamma_{\sigma_{1}\sigma_{2}\alpha}}\left(A,\tau\right)\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}p_{j\sigma_{1}\alpha}^{\dagger}\left(\tau\right)p_{j\sigma_{2}\alpha+1}\left(\tau\right)p_{j'\sigma_{2}'\alpha'+1}^{\dagger}\left(\tau'\right)p_{j'\sigma_{1}'\alpha'}\left(\tau'\right)\right\rangle _{0}\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
The only terms that survive are the ones for which the layer index 
\begin_inset Formula $\alpha$
\end_inset

 can have a chance to be properly matched 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\left\langle \left(\Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)+\text{h.c}\right)\left(\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}\left(A,\tau'\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)+\text{h.c}\right)\right\rangle _{0}\\
\\
=\delta_{\alpha\alpha'}\left\langle \Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)\right\rangle _{0}\\
+\delta_{\alpha\alpha'}\left\langle \overline{\Gamma_{\sigma_{1}\sigma_{2}\alpha}}\left(A,\tau\right)\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}p_{j\sigma_{1}\alpha}^{\dagger}\left(\tau\right)p_{j\sigma_{2}\alpha+1}\left(\tau\right)p_{j'\sigma_{2}'\alpha'+1}^{\dagger}\left(\tau'\right)p_{j'\sigma_{1}'\alpha'}\left(\tau'\right)\right\rangle _{0}\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Using Wicks theorem we can simplify further and cancel more terms for which
 the layer indices cannot be properly matched
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\left\langle \left(\Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)+\text{h.c}\right)\left(\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}\left(A,\tau'\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)+\text{h.c}\right)\right\rangle _{0}\\
\\
=\delta_{\alpha\alpha'}t_{g}^{2}e^{ie\left(A\left(\tau\right)-A\left(\tau'\right)\right)d}\left\langle \left(\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{\sigma}_{\sigma_{1}\sigma_{2}}\right)\left(\bm{S}_{j'}^{\alpha'}\left(\tau'\right)\cdot\bm{\sigma}_{\sigma_{2}'\sigma_{1}'}\right)\right\rangle _{0}\left\langle p_{j\sigma_{1}\alpha}\left(\tau\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)\right\rangle _{0}\left\langle p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)\right\rangle _{0}\\
+\delta_{\alpha\alpha'}t_{g}^{2}e^{ie\left(A\left(\tau\right)-A\left(\tau'\right)\right)d}\left\langle \left(\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{\sigma}_{\sigma_{2}\sigma_{1}}\right)\left(\bm{S}_{j'}^{\alpha'}\left(\tau'\right)\cdot\bm{\sigma}_{\sigma_{1}'\sigma_{2}'}\right)\right\rangle _{0}\left\langle p_{j\sigma_{2}\alpha+1}\left(\tau\right)p_{j'\sigma_{2}'\alpha'+1}^{\dagger}\left(\tau'\right)\right\rangle _{0}\left\langle p_{j\sigma_{1}\alpha}^{\dagger}\left(\tau\right)p_{j'\sigma_{1}'\alpha'}\left(\tau'\right)\right\rangle _{0}\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Taking the time-ordered expectation values, we get 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\left\langle \left(\Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)+\text{h.c}\right)\left(\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}\left(A,\tau'\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)+\text{h.c}\right)\right\rangle _{0}\\
\\
=-\delta_{\alpha\alpha'}\delta_{\sigma_{1}\sigma_{1}'}\delta_{\sigma_{2}\sigma_{2}'}t_{g}^{2}e^{ie\left(A\left(\tau\right)-A\left(\tau'\right)\right)d}\left\langle \left(\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{\sigma}_{\sigma_{1}\sigma_{2}}\right)\left(\bm{S}_{j'}^{\alpha'}\left(\tau'\right)\cdot\bm{\sigma}_{\sigma_{2}'\sigma_{1}'}\right)\right\rangle _{0}G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
-\delta_{\alpha\alpha'}\delta_{\sigma_{1}\sigma_{1}'}\delta_{\sigma_{2}\sigma_{2}'}t_{g}^{2}e^{-ie\left(A\left(\tau\right)-A\left(\tau'\right)\right)d}\left\langle \left(\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{\sigma}_{\sigma_{2}\sigma_{1}}\right)\left(\bm{S}_{j'}^{\alpha'}\left(\tau'\right)\cdot\bm{\sigma}_{\sigma_{1}'\sigma_{2}'}\right)\right\rangle _{0}G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Performing the sum over spins, we get 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\sum_{\sigma_{1}\sigma_{2}}\sum_{\sigma_{1}',\sigma_{2}'}\left\langle \left(\Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)+\text{h.c}\right)\left(\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}\left(A,\tau'\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)+\text{h.c}\right)\right\rangle _{0}\\
\\
=-\delta_{\alpha\alpha'}t_{g}^{2}e^{ie\left(A\left(\tau\right)-A\left(\tau'\right)\right)d}\left(\sum_{\sigma_{1}\sigma_{2}}\left\langle \left(\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{\sigma}_{\sigma_{1}\sigma_{2}}\right)\left(\bm{S}_{j'}^{\alpha'}\left(\tau'\right)\cdot\bm{\sigma}_{\sigma_{2}\sigma_{1}}\right)\right\rangle _{0}\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
-\delta_{\alpha\alpha'}t_{g}^{2}e^{-ie\left(A\left(\tau\right)-A\left(\tau'\right)\right)d}\left(\sum_{\sigma_{1}\sigma_{2}}\left\langle \left(\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{\sigma}_{\sigma_{2}\sigma_{1}}\right)\left(\bm{S}_{j'}^{\alpha'}\left(\tau'\right)\cdot\bm{\sigma}_{\sigma_{1}\sigma_{2}}\right)\right\rangle _{0}\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We now use the following identity for pauli matrices
\begin_inset Formula 
\begin{equation}
\sum_{\sigma_{2}}\left(\bm{a}\cdot\bm{\sigma}_{\sigma_{1}\sigma_{2}}\right)\left(\bm{b}\cdot\bm{\sigma}_{\sigma_{2}\sigma_{3}}\right)=\bm{a}\cdot\bm{b}\mathbb{I}+\left(\bm{a}\times\bm{b}\right)\cdot\bm{\sigma}_{\sigma_{1}\sigma_{3}}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
which implies that 
\begin_inset Formula 
\begin{equation}
\sum_{\sigma_{1}\sigma_{2}}\left\langle \left(\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{\sigma}_{\sigma_{1}\sigma_{2}}\right)\left(\bm{S}_{j'}^{\alpha'}\left(\tau'\right)\cdot\bm{\sigma}_{\sigma_{2}\sigma_{1}}\right)\right\rangle _{0}=2\left\langle \left(\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{S}_{j'}^{\alpha'}\left(\tau'\right)\right)\right\rangle _{0}.
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
Now we define the structure factor for a layer of spins
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\left\langle T\bm{S}_{j}^{\alpha}\left(\tau\right)\cdot\bm{S}_{j'}^{\alpha}\left(\tau'\right)\right\rangle =S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
such that
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\sum_{\sigma_{1}\sigma_{2}}\sum_{\sigma_{1}',\sigma_{2}'}\left\langle \left(\Gamma_{\sigma_{1}\sigma_{2}\alpha}\left(A,\tau\right)p_{j\sigma_{2}\alpha+1}^{\dagger}\left(\tau\right)p_{j\sigma_{1}\alpha}\left(\tau\right)+\text{h.c}\right)\left(\overline{\Gamma_{\sigma_{1}'\sigma_{2}'\alpha'}}\left(A,\tau'\right)p_{j'\sigma_{1}'\alpha'}^{\dagger}\left(\tau'\right)p_{j'\sigma_{2}'\alpha'+1}\left(\tau'\right)+\text{h.c}\right)\right\rangle _{0}\\
\\
=-2\delta_{\alpha\alpha'}t_{g}^{2}e^{ie\left(A\left(\tau\right)-A\left(\tau'\right)\right)d}S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
-2\delta_{\alpha\alpha'}t_{g}^{2}e^{-ie\left(A\left(\tau\right)-A\left(\tau'\right)\right)d}S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
\\
-4\delta_{\alpha\alpha'}\cos\left[e\left(A\left(\tau\right)-A\left(\tau'\right)\right)d\right]S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Inserting this in our expression for 
\begin_inset Formula $\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}$
\end_inset

, we have 
\begin_inset Formula 
\begin{align}
\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]} & =-2\int d\tau\sum_{j,\alpha}\int d\tau'\sum_{j',\alpha'}\delta_{\alpha\alpha'}t_{g}^{2}\cos\left[e\left(A\left(\tau\right)-A\left(\tau'\right)\right)d\right]S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
 & =-2N_{l}t_{g}^{2}\int d\tau\int d\tau'\sum_{j'j}\cos\left[e\left(A\left(\tau\right)-A\left(\tau'\right)\right)d\right]S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right),
\end{align}

\end_inset


\end_layout

\begin_layout Standard
where 
\begin_inset Formula $N_{l}$
\end_inset

 is the number of layers in the system.
 Now we can express this in momentum space as follows
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\sum_{j'j}S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)G_{j'j}\left(\tau-\tau'\right) & =\frac{1}{N_{s}^{3}}\sum_{j'j}\sum_{\boldsymbol{k}'\boldsymbol{k}\boldsymbol{q}}e^{-i\left(\boldsymbol{k}-\boldsymbol{k}'+\boldsymbol{q}\right)\cdot\left(\boldsymbol{r}_{j}-\boldsymbol{r}_{j'}\right)}S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}',\tau'-\tau\right)\\
 & =\frac{1}{N_{s}^{2}}\sum_{j}\sum_{\boldsymbol{k}\boldsymbol{k}'\boldsymbol{q}}e^{-i\left(\boldsymbol{k}-\boldsymbol{k}'+\boldsymbol{q}\right)\cdot\boldsymbol{r}_{j}}\delta\left(\boldsymbol{k}-\boldsymbol{k}'+\boldsymbol{q}\right)S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}',\tau'-\tau\right)\\
 & =\frac{1}{N_{s}^{2}}\sum_{j}\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}+\boldsymbol{q},\tau'-\tau\right)\\
 & =\frac{1}{N_{s}}\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}+\boldsymbol{q},\tau'-\tau\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
where we used the following relations
\begin_inset Formula 
\begin{equation}
S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)=\frac{1}{N_{s}}\sum_{\boldsymbol{q}}e^{-i\boldsymbol{q}\cdot\left(\boldsymbol{r}_{j}-\boldsymbol{r}_{j'}\right)}S\left(\bm{q},\tau-\tau'\right),
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
and
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
G_{jj'}\left(\tau-\tau\right)=\frac{1}{N_{s}}\sum_{\boldsymbol{k}}e^{-i\boldsymbol{k}\cdot\left(\boldsymbol{r}_{j}-\boldsymbol{r}_{j'}\right)}G\left(\boldsymbol{k},\tau-\tau\right),
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
here 
\begin_inset Formula $N_{s}$
\end_inset

 is the number of sites within a layer.
 With this, the expression simplifies to 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]} & =-2\int d\tau\sum_{j,\alpha}\int d\tau'\sum_{j',\alpha'}\delta_{\alpha\alpha'}t_{g}^{2}\cos\left[e\left(A\left(\tau\right)-A\left(\tau'\right)\right)d\right]S\left(\bm{r}_{j},\bm{r}_{j'},\tau-\tau'\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
 & =-\frac{2N_{l}}{N_{s}}t_{g}^{2}\int d\tau\int d\tau'\cos\left[e\left(A\left(\tau\right)-A\left(\tau'\right)\right)d\right]\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}+\boldsymbol{q},\tau'-\tau\right).
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Taking the second order coefficient in the expansion with respect to the
 external field, we get the following terms
\begin_inset Formula 
\begin{align}
\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}=\\
-\frac{2N_{l}}{N_{s}}t_{g}^{2}\int d\tau\int d\tau'\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}+\boldsymbol{q},\tau'-\tau\right)\\
-\frac{2N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\int d\tau\int d\tau'A\left(\tau'\right)A\left(\tau\right)\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}+\boldsymbol{q},\tau'-\tau\right)\\
+\frac{N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\int d\tau\int d\tau'\left[\left(A\left(\tau\right)\right)^{2}+\left(A\left(\tau'\right)\right)^{2}\right]\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}+\boldsymbol{q},\tau'-\tau\right)\\
+\mathcal{O}\left(A^{3}\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Using the fourier transform 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
G\left(\boldsymbol{k},\tau-\tau'\right)=\frac{1}{\beta}\sum_{i\nu_{n}}G\left(\boldsymbol{k},i\nu_{n}\right)e^{i\nu_{n}\left(\tau-\tau'\right)}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
S\left(\boldsymbol{q},\tau-\tau'\right)=\frac{1}{\beta}\sum_{i\nu_{n}}S\left(\boldsymbol{q},i\nu_{n}\right)e^{i\nu_{n}\left(\tau-\tau'\right)},
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
we will express everything in frequency space.
 We deal term by term, for the first term in the expression for 
\begin_inset Formula $\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}$
\end_inset

, we get:
\begin_inset Formula 
\begin{align}
-\frac{2N_{l}}{N_{s}}t_{g}^{2}\sum_{\boldsymbol{k}\boldsymbol{q}}\int d\tau d\tau'S\left(\boldsymbol{q},\tau-\tau'\right)G_{jj'}\left(\tau-\tau'\right)G_{j'j}\left(\tau'-\tau\right)\\
-\frac{2N_{l}}{N_{s}}t_{g}^{2}\frac{1}{\beta^{3}}\sum_{iz_{n}i\nu_{n}i\mu_{n}}\sum_{\boldsymbol{k}\boldsymbol{q}}\int d\tau d\tau'S\left(\boldsymbol{q},iz_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\mu_{n}\right)e^{i\left(\nu_{n}+z_{n}-\mu_{n}\right)\left(\tau-\tau'\right)}\\
-\frac{2N_{l}}{N_{s}}t_{g}^{2}\frac{1}{\beta}\sum_{iz_{n}i\nu_{n}}\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},iz_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\left(\nu_{n}+z_{n}\right)\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
For the second term we get
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\int d\tau d\tau'A\left(\tau'\right)A\left(\tau\right)S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}+\boldsymbol{q},\tau'-\tau\right)\\
\frac{1}{\beta^{3}}\int d\tau d\tau'\sum_{iz_{n}i\nu_{n}i\mu_{n}}A\left(\tau\right)A\left(\tau'\right)S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},iz_{n}\right)e^{i\left(\nu_{n}+\mu_{n}-z_{n}\right)\left(\tau-\tau'\right)}\\
=\frac{1}{\beta}\sum_{iz_{n}i\nu_{n}i\mu_{n}}\left(\frac{1}{\beta}\int d\tau A\left(\tau\right)e^{i\left(\nu_{n}+\mu_{n}-z_{n}\right)\left(\tau-\tau'\right)}\right)\left(\frac{1}{\beta}\int d\tau'A\left(\tau'\right)e^{-i\left(\nu_{n}+\mu_{n}-z_{n}\right)\tau'}\right)S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},iz_{n}\right)\\
=\frac{1}{\beta}\sum_{iz_{n}i\nu_{n}i\mu_{n}}A\left(-i\left(z_{n}-\nu_{n}-\mu_{n}\right)\right)A\left(i\left(z_{n}-\nu_{n}-\mu_{n}\right)\right)S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},iz_{n}\right)\\
=\frac{1}{\beta}\sum_{i\nu_{n}i\omega_{n}i\mu_{n}}\left|A\left(i\omega_{n}\right)\right|^{2}S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\omega_{n}+i\mu_{n}+i\nu_{n}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
for the last term, we get:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\int d\tau d\tau'A\left(\tau\right)A\left(\tau\right)S\left(\boldsymbol{q},\tau-\tau'\right)G\left(\boldsymbol{k},\tau-\tau'\right)G\left(\boldsymbol{k}+\boldsymbol{q},\tau'-\tau\right)\\
\frac{1}{\beta^{3}}\int d\tau d\tau'\sum_{i\nu_{n}}\sum_{i\nu_{n}'}\sum_{i\omega_{n}}\sum_{i\omega_{n}'}\sum_{i\mu_{n}}A\left(i\omega_{n}\right)A\left(i\omega_{n}'\right)S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},iz_{n}\right)e^{i\omega_{n}\tau}e^{i\omega_{n}'\tau}e^{i\left(\nu_{n}+\mu_{n}-z_{n}\right)\left(\tau-\tau'\right)}\\
=\frac{1}{\beta^{2}}\int d\tau\sum_{iz_{n}}\sum_{i\omega_{n}}\sum_{i\omega_{n}'}\sum_{i\mu_{n}}A\left(i\omega_{n}\right)A\left(i\omega_{n}'\right)S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\nu_{n}+i\mu_{n}\right)e^{i\left(\omega_{n}+\omega_{n}'\right)\tau}\\
=\frac{1}{\beta}\sum_{i\nu_{n}i\omega_{n}i\mu_{n}}A\left(i\omega_{n}\right)A\left(-i\omega_{n}\right)S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\nu_{n}+i\mu_{n}\right)\\
=\frac{1}{\beta}\sum_{i\nu_{n}i\omega_{n}i\mu_{n}}\left|A\left(i\omega_{n}\right)\right|^{2}S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\nu_{n}+i\mu_{n}\right)\\
=\frac{1}{\beta}\sum_{i\nu_{n}i\omega_{n}i\mu_{n}}\left|A\left(i\omega_{n}\right)\right|^{2}S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\nu_{n}+i\mu_{n}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Overall, we get the following expression
\begin_inset Formula 
\begin{align}
\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}=\\
-\frac{2N_{l}}{N_{s}}t_{g}^{2}\frac{1}{\beta}\sum_{iz_{n}i\nu_{n}}\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},iz_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\left(\nu_{n}+z_{n}\right)\right)\\
+\frac{2N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\frac{1}{\beta}\sum_{\boldsymbol{k}\boldsymbol{q}}\sum_{i\nu_{n}i\omega_{n}i\mu_{n}}\left|A\left(i\omega_{n}\right)\right|^{2}S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)\left(G\left(\boldsymbol{k}+\boldsymbol{q},i\nu_{n}+i\mu_{n}\right)-G\left(\boldsymbol{k}+\boldsymbol{q},i\omega_{n}+i\mu_{n}+i\nu_{n}\right)\right)
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Then, the functional derivative yields
\begin_inset Formula 
\begin{align*}
 & -\frac{1}{\beta}\frac{\delta^{2}}{\delta A\left(\omega\right)^{2}}\log\frac{\mathcal{Z}\left[A\right]}{\mathcal{Z}\left[0\right]}\\
 & =\frac{\delta^{2}}{\delta A\left(\omega\right)^{2}}\log\left(1-\frac{\mathcal{Z}_{2}\left[A,t_{p}\right]}{\mathcal{Z}\left[0\right]}+\mathcal{O}\left(t_{g}^{4}\right)\right)\\
 & =\frac{-\frac{2N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\frac{1}{\beta^{2}}\sum_{\boldsymbol{k}\boldsymbol{q}}\sum_{i\nu_{n}i\mu_{n}}S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)\left(G\left(\boldsymbol{k}+\boldsymbol{q},i\nu_{n}+i\mu_{n}\right)-G\left(\boldsymbol{k}+\boldsymbol{q},i\omega_{n}+i\mu_{n}+i\nu_{n}\right)\right)}{1-\frac{2N_{l}}{N_{s}}t_{g}^{2}\frac{1}{\beta}\sum_{iz_{n}i\nu_{n}}\sum_{\boldsymbol{k}\boldsymbol{q}}S\left(\boldsymbol{q},iz_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)G\left(\boldsymbol{k}+\boldsymbol{q},i\left(\nu_{n}+z_{n}\right)\right)}\\
 & +\mathcal{O}\left(A,t_{g}^{4}\right).\\
 & =-\frac{2N_{l}}{N_{s}}\left(edt_{g}\right)^{2}\frac{1}{\beta^{2}}\sum_{i\nu_{n}i\mu_{n}}S\left(\boldsymbol{q},i\mu_{n}\right)G\left(\boldsymbol{k},i\nu_{n}\right)\left(G\left(\boldsymbol{k}+\boldsymbol{q},i\nu_{n}+i\mu_{n}\right)-G\left(\boldsymbol{k}+\boldsymbol{q},i\omega_{n}+i\mu_{n}+i\nu_{n}\right)\right)\\
 & +\mathcal{O}\left(A,t_{g}^{4}\right).
\end{align*}

\end_inset


\end_layout

