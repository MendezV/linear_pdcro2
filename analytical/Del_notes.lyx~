\begin_layout Standard
Evaluating the fermionic Matsubara sum
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\frac{1}{\beta}\sum_{i\nu_{n}}\frac{1}{i\nu_{n}-\epsilon_{1}}\frac{1}{i\omega_{n}+i\mu_{n}+i\nu_{n}-\epsilon_{2}} & =\int_{\mathcal{C}_{1}}\frac{dz}{2\pi i}\frac{1}{z-\epsilon_{1}}\frac{1}{z+i\omega_{n}+i\mu_{n}-\epsilon_{2}}n_{F}\left(z\right)\\
 & =\int_{\mathcal{C}_{3}}\frac{dz}{2\pi i}\frac{1}{z-\epsilon_{1}}\frac{1}{z+i\omega_{n}+i\mu_{n}-\epsilon_{2}}n_{F}\left(z\right)\\
 & =\frac{n_{F}\left(\epsilon_{1}\right)}{i\omega_{n}+i\mu_{n}+\epsilon_{1}-\epsilon_{2}}+\frac{n_{F}\left(-\left(i\omega_{n}+i\mu_{n}-\epsilon_{2}\right)\right)}{-\left(i\omega_{n}+i\mu_{n}-\epsilon_{2}\right)-\epsilon_{1}}\\
 & =\frac{n_{F}\left(\epsilon_{1}\right)}{i\omega_{n}+i\mu_{n}+\epsilon_{1}-\epsilon_{2}}-\frac{n_{F}\left(\epsilon_{2}\right)}{i\omega_{n}+i\mu_{n}-\epsilon_{2}+\epsilon_{1}}\\
\\
 & =\frac{n_{F}\left(\epsilon_{1}\right)-n_{F}\left(\epsilon_{2}\right)}{i\omega_{n}+i\mu_{n}+\epsilon_{1}-\epsilon_{2}}.
\end{align}

\end_inset


\end_layout

\begin_layout Standard
So we get 
\begin_inset Formula 
\begin{align*}
 & \frac{1}{\beta}\sum_{i\nu_{n}}G\left(\bm{k},i\nu_{n}\right)G\left(\bm{k}+\bm{q},i\omega_{n}+i\mu_{n}+i\nu_{n}\right)\\
 & =\int\frac{d\epsilon_{1}}{2\pi}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)\frac{n_{F}\left(\epsilon_{1}\right)-n_{F}\left(\epsilon_{2}\right)}{i\omega_{n}+i\mu_{n}+\epsilon_{1}-\epsilon_{2}}.
\end{align*}

