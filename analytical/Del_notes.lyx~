 & =\int_{\mathcal{C}_{1}'}\frac{dz}{2\pi i}\left(-\frac{1}{z-\nu}\frac{1}{z-\left(\epsilon_{1}-\epsilon_{2}-i\omega_{n}\right)}+\frac{1}{z-\left(-\nu\right)}\frac{1}{z-\left(\epsilon_{1}-\epsilon_{2}-i\omega_{n}\right)}\right)n_{B}\left(z\right)\\
 & =\int_{\mathcal{C}_{3}'}\frac{dz}{2\pi i}\left(-\frac{1}{z-\nu}\frac{1}{z-\left(\epsilon_{1}-\epsilon_{2}-i\omega_{n}\right)}+\frac{1}{z-\left(-\nu\right)}\frac{1}{z-\left(\epsilon_{1}-\epsilon_{2}-i\omega_{n}\right)}\right)n_{B}\left(z\right)\\
