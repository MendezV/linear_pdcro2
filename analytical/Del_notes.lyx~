 & =\int\frac{d\epsilon_{1}}{2\pi}A_{\text{Pd}}\left(\bm{k},\epsilon_{1}\right)\int\frac{d\epsilon_{2}}{2\pi}A_{\text{Pd}}\left(\bm{k}+\bm{q},\epsilon_{2}\right)\frac{1}{\beta}\sum_{i\nu_{n}}\frac{1}{i\nu_{n}-\epsilon_{1}}\frac{1}{i\omega_{n}+i\mu_{n}+i\nu_{n}-\epsilon_{2}}
\end{align*}

