Cell[BoxData[
 RowBox[{
  RowBox[{"Tot2", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     FractionBox["2", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"\[Omega]", "+", "\[Omega]0"}], "]"}], "+", "1"}]]}], "+", 
    RowBox[{
     FractionBox["1", "2"], 
     FractionBox["2", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"\[Omega]0", "-", "\[Omega]"}], "]"}], "+", "1"}]]}], "+", 
    FractionBox["2", 
     RowBox[{
      RowBox[{"Exp", "[", "\[Omega]0", "]"}], "-", "1"}]]}]}], ";"}]], "Input",\

