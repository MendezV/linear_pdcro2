Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Z2", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "+", "z"}], ")"}], "2"], "-", 
        SuperscriptBox["x", "2"]}], 
       RowBox[{"2", "y"}]], "+", 
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"Cosh", "[", "y", "]"}], "+", 
         RowBox[{"Cosh", "[", 
          RowBox[{"x", "+", "z"}], "]"}]}], 
        RowBox[{
         RowBox[{"Cosh", "[", "y", "]"}], "+", 
         RowBox[{"Cosh", "[", "x", "]"}]}]], "]"}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"y", "-", 
             RowBox[{"(", 
              RowBox[{"x", "+", "z"}], ")"}]}]]}]}], "]"}], "+", 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"y", "+", 
             RowBox[{"(", 
              RowBox[{"x", "+", "z"}], ")"}]}]]}]}], "]"}], "-", 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"y", "-", "x"}]]}]}], "]"}], "-", 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"y", "+", "x"}]]}]}], "]"}]}], "y"]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.8741397364784603`*^9, 3.874139820373493*^9}, {
   3.8741399375214148`*^9, 3.874139940648571*^9}, {3.874139989517205*^9, 
