Cell[CellGroupData[{

Cell["New term Z(J,omega,omega_0)", "Title",
 CellChangeTimes->{{3.874057280913385*^9, 3.8740572927576313`*^9}, {
  3.8740741202229548`*^9, 
  3.874074124467589*^9}},ExpressionUUID->"48fc304d-28cb-491b-8413-\
0f4100aa82e1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"p", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     FractionBox["x", "J"], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        RowBox[{
         RowBox[{"Exp", "[", "x", "]"}], "-", "1"}]], "+", 
       FractionBox["1", 
        RowBox[{
         RowBox[{"Exp", "[", "x", "]"}], "+", "1"}]]}], ")"}], 
     RowBox[{"(", 
      FractionBox["1", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"\[Omega]0", "-", "x"}], "]"}], "+", "1"}]], ")"}]}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "J"}], ",", 
      RowBox[{"+", "J"}]}], "}"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{"J", ">", "0"}], "&&", 
      RowBox[{"\[Omega]0", ">", "0"}]}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"f", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"p", ",", " ", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{"\[Omega]", ">", "0"}], "&&", 
      RowBox[{"J", ">", "0"}], "&&", 
      RowBox[{"\[Omega]0", ">", "0"}]}]}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.874058028610272*^9, 3.874058039587226*^9}, {
  3.874058124117591*^9, 3.874058132782168*^9}, {3.8740583568364964`*^9, 
  3.874058360551942*^9}, {3.874058391129766*^9, 3.874058391609006*^9}, {
  3.874058581590105*^9, 3.874058599006835*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"64d7c4cd-ab82-4eeb-8eb8-b6bd1f356ab7"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"6", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", " ", "\[Omega]0"}]]}], ")"}], " ", "J"}]], 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "12"}], " ", "\[ImaginaryI]", " ", "J", " ", "\[Pi]"}], "+", 
    RowBox[{"12", " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[ExponentialE]", "\[Omega]0"], " ", "J", " ", "\[Pi]"}],
     "+", 
    RowBox[{"3", " ", 
     SuperscriptBox["\[Pi]", "2"]}], "-", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", "\[Omega]0"], " ", 
     SuperscriptBox["\[Pi]", "2"]}], "-", 
    RowBox[{"12", " ", "J", " ", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", "J"]}], "]"}]}], "+", 
    RowBox[{"12", " ", "J", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", "J"]}], "]"}]}], "+", 
    RowBox[{"12", " ", 
     SuperscriptBox["\[ExponentialE]", "\[Omega]0"], " ", "J", " ", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "J"}]]}], "]"}]}], "-", 
    RowBox[{"12", " ", 
     SuperscriptBox["\[ExponentialE]", "\[Omega]0"], " ", "J", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"J", "-", "\[Omega]0"}]]}], "]"}]}], "-", 
    RowBox[{"12", " ", 
     SuperscriptBox["\[ExponentialE]", "\[Omega]0"], " ", "J", " ", 
     RowBox[{"Log", "[", 
