Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Z1", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"y", "+", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "+", "z"}], ")"}], "2"], 
       RowBox[{"2", "y"}]], "-", 
      FractionBox[
       SuperscriptBox["\[Pi]", "2"], 
       RowBox[{"6", "y"}]], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"y", "-", 
             RowBox[{"(", 
              RowBox[{"x", "+", "z"}], ")"}]}]]}]}], "]"}], "+", 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"-", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"y", "+", 
             RowBox[{"(", 
              RowBox[{"x", "+", "z"}], ")"}]}]]}]}], "]"}], "+", 
        RowBox[{"2", 
         RowBox[{"PolyLog", "[", 
          RowBox[{"2", ",", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", "y"}]]}], "]"}]}]}], "y"], "+", 
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"Cosh", "[", "y", "]"}], "+", 
         RowBox[{"Cosh", "[", 
          RowBox[{"x", "+", "z"}], "]"}]}], 
        RowBox[{
         RowBox[{"Cosh", "[", "y", "]"}], "-", "1"}]], "]"}]}], ")"}]}]}], 
  ";"}]], "Input",
