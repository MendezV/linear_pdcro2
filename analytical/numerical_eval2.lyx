 & \sim\kappa\alpha\left(\frac{2a_{z}}{a_{pl}^{2}}\frac{e^{2}}{\hbar}\right)\left(\frac{\hbar\lambda^{2}}{M\omega_{0}}\right)\left[\frac{8g^{2}}{U}\right]^{2}\frac{k_{b}T}{\hbar\omega_{0}}\rho\left(0\right)^{2}\\
 & \sim\left(\frac{2a_{z}}{a_{pl}^{2}}\frac{e^{2}}{\hbar}\right)\lambda_{ME}\nu_{0}T\\
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
If we want to compare with the out of plane conductivity 
\begin_inset Formula 
\[
\sigma_{\perp}=e^{2}\tau_{tr}\left\langle v_{x\boldsymbol{k}}^{2}\right\rangle 
\]

\end_inset


\end_layout

\begin_layout Standard
with 
\begin_inset Formula 
\[
\tau_{tr}^{-1}\sim\left(\lambda_{ME}+\lambda_{ph}\right)\frac{1}{\beta\hbar}
\]

\end_inset


\end_layout

\begin_layout Standard
then we have 
\begin_inset Formula 
\[
\left(\frac{2a_{z}}{a_{pl}^{2}}\frac{e^{2}}{\hbar}\right)\lambda_{ME}\nu_{0}T=\frac{e^{2}\left\langle v_{x\boldsymbol{k}}\right\rangle ^{2}}{\left(\lambda_{ME}+\lambda_{ph}\right)\frac{k_{b}T}{\hbar}}
\]

\end_inset


\end_layout

\begin_layout Standard
solving for T
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left(k_{b}T\right)^{2}=\frac{e^{2}\left\langle v_{x\boldsymbol{k}}\right\rangle ^{2}}{\left(\frac{2a_{z}}{a_{pl}^{2}}\frac{e^{2}}{\hbar}\right)\lambda_{ME}\nu_{0}\left(\lambda_{ME}+\lambda_{ph}\right)\frac{1}{\hbar}}
\]

\end_inset


\end_layout

\begin_layout Standard
so that we have 
\begin_inset Formula 
\begin{align*}
T^{2} & =\frac{\hbar^{2}\left\langle v_{x\boldsymbol{k}}\right\rangle ^{2}}{\left(\frac{2a_{z}}{a_{pl}^{2}}\right)\nu_{0}\lambda_{ME}\left(\lambda_{ME}+\lambda_{ph}\right)}\\
 & \sim\frac{\hbar^{2}v_{F\perp}^{2}\frac{\nu_{0}}{a_{pl}^{2}a_{z}}}{\left(\frac{2a_{z}}{a_{pl}^{2}}\right)\nu_{0}\lambda_{ME}\left(\lambda_{ME}+\lambda_{ph}\right)}\\
 & \sim\frac{\hbar^{2}v_{F\perp}^{2}}{a_{z}^{2}\lambda_{ME}\left(\lambda_{ME}+\lambda_{ph}\right)}\\
 & \sim G_{z}^{2}v_{F\perp}^{2}\frac{1}{\lambda_{ME}\left(\lambda_{ME}+\lambda_{ph}\right)}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
then, the crossover scale above which 
\begin_inset Formula $\sigma_{ME}>\sigma_{\perp}$
\end_inset

 should happen at 
\begin_inset Formula 
\[
k_{b}T^{*}=G_{z}v_{F\perp}\sqrt{\frac{1}{\lambda_{ME}\left(\lambda_{ME}+\lambda_{ph}\right)}}
\]

\end_inset


\end_layout

\begin_layout Standard
for completeness 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\lambda_{ME}=\kappa\alpha\nu_{0}\left(\frac{\hbar\lambda^{2}}{M\omega_{0}}\right)\frac{1}{\hbar\omega_{0}}\left[\frac{8g^{2}}{U}\right]^{2}
\]

\end_inset


\end_layout

\begin_layout Standard
for 
\begin_inset Formula $\lambda_{ME}\rightarrow0$
\end_inset

 
\begin_inset Formula $T^{*}\rightarrow\infty$
\end_inset

 and 
\begin_inset Formula $\sigma_{\perp}>\sigma_{ME}$
\end_inset

 for all temperatures, and if 
\begin_inset Formula $v_{F\perp}\rightarrow0$
\end_inset

 the crossover scale goes to zero and 
\begin_inset Formula $\sigma_{ME}>\sigma_{\perp}$
\end_inset

 for all temperatures.
 Putting numbers to this assuming 
\end_layout

\begin_layout Section
Small interlayer hopping 
\end_layout

\begin_layout Standard
We have a contribution to the conductivity given by 
\begin_inset Formula 
\[
\sigma_{\perp}=e^{2}\tau_{tr}\left\langle v_{x\boldsymbol{k}}^{2}\right\rangle 
\]

\end_inset


\end_layout

\begin_layout Standard
The dispersion is now 
\begin_inset Formula 
\[
\varepsilon_{\boldsymbol{k}}=\varepsilon_{\boldsymbol{k}_{xy}}+2t_{z}\left(1-\cos k_{z}d\right)
\]

\end_inset


\end_layout

\begin_layout Standard
so that the velocity becomes 
\begin_inset Formula 
\[
v_{\boldsymbol{k}}^{z}=\frac{2d}{\hbar}t_{z}\sin k_{z}d
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left\langle v_{x\boldsymbol{k}}^{2}\right\rangle =\frac{4d^{2}t_{z}^{2}}{\hbar^{2}}\left\langle \sin^{2}k_{z}d\right\rangle 
\]

\end_inset


\end_layout

\begin_layout Standard
Now we evaluate 
\begin_inset Formula 
\begin{align*}
\left\langle \sin^{2}k_{z}d\right\rangle  & =\frac{1}{V}\sum_{\boldsymbol{k}}\delta\left(\varepsilon_{\boldsymbol{k}}\right)\sin^{2}k_{z}d\\
 & =\int\frac{d\boldsymbol{k}}{\left(2\pi\right)^{3}}\delta\left(\varepsilon_{\boldsymbol{k}}\right)\sin^{2}k_{z}d\\
 & \sim\int\frac{d\boldsymbol{k}}{\left(2\pi\right)^{3}}\delta\left(\varepsilon_{\boldsymbol{k}_{xy}}\right)\sin^{2}k_{z}d\\
 & =\frac{\nu_{0}}{a_{xy}^{2}}\int_{-\pi/d}^{\pi/d}\frac{dk_{z}}{\left(2\pi\right)}\sin^{2}k_{z}d\\
 & =\frac{\nu_{0}}{a_{xy}^{2}}\frac{1}{2d}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Overall we have 
\begin_inset Formula 
\begin{align*}
\sigma_{\perp} & =e^{2}\tau_{tr}\left(4d^{2}t_{z}^{2}\frac{\nu_{0}}{a_{xy}^{2}}\frac{1}{2d}\right)\\
 & =2\frac{a_{z}}{a_{xy}^{2}}\frac{e^{2}}{\hbar}\frac{t_{z}^{2}\nu_{0}}{\hbar\Gamma_{tr}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Inserting the transport rate we have 
\begin_inset Formula 
\[
\sigma_{\perp}=2\frac{a_{z}}{a_{xy}^{2}}\frac{e^{2}}{\hbar}\frac{t_{z}^{2}\nu_{0}}{\hbar\frac{\left(2\pi\lambda_{ep}+2\pi\lambda_{ME}\right)k_{b}T}{\hbar}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{\perp}=2\frac{a_{z}}{a_{xy}^{2}}\frac{e^{2}}{\hbar}\frac{t_{z}^{2}\nu_{0}}{\left(2\pi\lambda_{ep}+2\pi\lambda_{ME}\right)k_{b}T}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sigma_{\perp}\sim\frac{a_{z}}{a_{xy}^{2}}\frac{e^{2}}{\hbar}\frac{t_{\perp}^{2}\nu_{0}}{\lambda_{ME}k_{b}T}
\]

\end_inset


\end_layout

