\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comparison of $T-$dependence of in-plane resistivity between experiments \cite  {Hicks2015} (dotted lines) and theoretical model in Eq.~\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {total_H}\unskip \@@italiccorr )}} (solid lines). The only free parameters in the fits are the phonon frequencies and bare el-ph and EME couplings. All other parameters are fixed; see \cite  {sunko_probing_2020,Supplementary_material}. For the phonon data, we have used $\omega _D = 29$meV, $\omega _0 = 120$meV, $\widetilde  {\omega }_0 = 40$meV, $\lambda _{\rm  {el-ph, a}} = 0.04$, $\lambda _{\rm  {el-ph, o}} = 0.02$, $\lambda _{\rm  EME} = 0.05$ and $S=3/2$.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:main}{{2}{4}{Comparison of $T-$dependence of in-plane resistivity between experiments \cite {Hicks2015} (dotted lines) and theoretical model in Eq.~\eqref {total_H} (solid lines). The only free parameters in the fits are the phonon frequencies and bare el-ph and EME couplings. All other parameters are fixed; see \cite {sunko_probing_2020,Supplementary_material}. For the phonon data, we have used $\omega _D = 29$meV, $\omega _0 = 120$meV, $\widetilde {\omega }_0 = 40$meV, $\lambda _{\rm {el-ph, a}} = 0.04$, $\lambda _{\rm {el-ph, o}} = 0.02$, $\lambda _{\rm EME} = 0.05$ and $S=3/2$}{figure.2}{}}
