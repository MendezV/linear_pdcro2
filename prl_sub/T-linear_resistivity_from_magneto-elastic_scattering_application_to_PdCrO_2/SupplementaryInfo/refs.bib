@article{patel_theory_2019,
	title = {Theory of a {Planckian} metal},
	volume = {123},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/1906.03265},
	doi = {10.1103/PhysRevLett.123.066601},
	abstract = {We present a lattice model of fermions with \$N\$ flavors and random interactions which describes a Planckian metal at low temperatures, \$T {\textbackslash}rightarrow 0\$, in the solvable limit of large \$N\$. We begin with quasiparticles around a Fermi surface with effective mass \$m{\textasciicircum}{\textbackslash}ast\$, and then include random interactions which lead to fermion spectral functions with frequency scaling with \$k\_B T/{\textbackslash}hbar\$. The resistivity, \${\textbackslash}rho\$, obeys the Drude formula \${\textbackslash}rho = m{\textasciicircum}{\textbackslash}ast/(n e{\textasciicircum}2 {\textbackslash}tau\_\{{\textbackslash}textrm\{tr\}\})\$, where \$n\$ is the density of fermions, and the transport scattering rate is \$1/{\textbackslash}tau\_\{{\textbackslash}textrm\{tr\}\} = f {\textbackslash}, k\_B T/{\textbackslash}hbar\$; we find \$f\$ of order unity, and essentially independent of the strength and form of the interactions. The random interactions are a generalization of the Sachdev-Ye-Kitaev models; it is assumed that processes non-resonant in the bare quasiparticle energies only renormalize \$m{\textasciicircum}{\textbackslash}ast\$, while resonant processes are shown to produce the Planckian behavior.},
	number = {6},
	urldate = {2020-01-28},
	journal = {Physical Review Letters},
	author = {Patel, Aavishkar A. and Sachdev, Subir},
	month = aug,
	year = {2019},
