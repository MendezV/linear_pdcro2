	file = {APS Snapshot:/Users/evyatart/Zotero/storage/LU68M33T/PhysRevB.105.html:text/html;Full Text PDF:/Users/evyatart/Zotero/storage/6AZV4ZUD/Stangier et al. - 2022 - Breakdown of the Wiedemann-Franz law at the Lifshi.pdf:application/pdf},
}

@article{das_sarma_screening_2015,
	title = {Screening and transport in {2D} semiconductor systems at low temperatures},
