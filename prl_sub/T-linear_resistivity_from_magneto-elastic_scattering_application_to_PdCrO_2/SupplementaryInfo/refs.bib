@article{werman_quantum_2017,
	title = {Quantum chaos in an electron-phonon bad metal},
	url = {http://arxiv.org/abs/1705.07895},
	abstract = {We calculate the scrambling rate \${\textbackslash}lambda\_L\$ and the butterfly velocity \$v\_B\$ associated with the growth of quantum chaos for a solvable large-\$N\$ electron-phonon system. We study a temperature regime in which the electrical resistivity of this system exceeds the Mott-Ioffe-Regel limit and increases linearly with temperature - a sign that there are no long-lived charged quasiparticles - although the phonons remain well-defined quasiparticles. The long-lived phonons determine \${\textbackslash}lambda\_L\$, rendering it parametrically smaller than the theoretical upper-bound \${\textbackslash}lambda\_L {\textbackslash}ll {\textbackslash}lambda\_\{max\}=2{\textbackslash}pi T/{\textbackslash}hbar\$. Significantly, the chaos properties seem to be intrinsic - \${\textbackslash}lambda\_L\$ and \$v\_B\$ are the same for electronic and phononic operators. We consider two models - one in which the phonons are dispersive, and one in which they are dispersionless. In either case, we find that \${\textbackslash}lambda\_L\$ is proportional to the inverse phonon lifetime, and \$v\_B\$ is proportional to the effective phonon velocity. The thermal and chaos diffusion constants, \$D\_E\$ and \$D\_L{\textbackslash}equiv v\_B{\textasciicircum}2/{\textbackslash}lambda\_L\$, are always comparable, \$D\_E {\textbackslash}sim D\_L\$. In the dispersive phonon case, the charge diffusion constant \$D\_C\$ satisfies \$D\_L{\textbackslash}gg D\_C\$, while in the dispersionless case \$D\_L {\textbackslash}ll D\_C\$.},
	language = {english},
	urldate = {2018-10-30},
