	annote = {Comment: 6 pages main text, 2 pages supplementary material. Submitted to journal for review},
	file = {arXiv\:1808.07564 PDF:C\:\\Users\\evyatart\\Zotero\\storage\\QYYCHCKS\\Zhang et al. - 2018 - Thermal Diffusivity Above Mott-Ioffe-Regel Limit.pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\evyatart\\Zotero\\storage\\X3M5R8GU\\1808.html:text/html}
