@article{martelli_thermal_2018,
	title = {Thermal transport and phonon hydrodynamics in strontium titanate},
	volume = {120},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/1802.05868},
	doi = {10.1103/PhysRevLett.120.125901},
	abstract = {We present a study of thermal conductivity, \${\textbackslash}kappa\$, in undoped and doped strontium titanate in a wide temperature range (2-400 K) and detecting different regimes of heat flow. In undoped SrTiO\$\_\{3\}\$, \${\textbackslash}kappa\$ evolves faster than cubic with temperature below its peak and in a narrow temperature window. Such a behavior, previously observed in a handful of solids, has been attributed to a Poiseuille flow of phonons, expected to arise when momentum-conserving scattering events outweigh momentum-degrading ones. The effect disappears in presence of dopants. In SrTi\$\_\{1-x\}\$Nb\$\_\{x\}\$O\$\_\{3\}\$, a significant reduction in lattice thermal conductivity starts below the temperature at which the average interdopant distance and the thermal wavelength of acoustic phonons become comparable. In the high-temperature regime, thermal diffusivity becomes proportional to the inverse of temperature, with a prefactor set by sound velocity and Planckian time (\${\textbackslash}tau\_\{p\}={\textbackslash}frac\{{\textbackslash}hbar\}\{k\_\{B\}T\}\$).},
	number = {12},
	urldate = {2020-01-08},
	journal = {Physical Review Letters},
	author = {Martelli, Valentina and Jiménez, Julio Larrea and Continentino, Mucio and Baggio-Saitovitch, Elisa and Behnia, Kamran},
	month = mar,
	year = {2018},
	note = {arXiv: 1802.05868},
	keywords = {Condensed Matter - Strongly Correlated Electrons, Condensed Matter - Superconductivity, Condensed Matter - Materials Science},
	pages = {125901},
	annote = {Comment: 5 pages including 4 figures},
	file = {arXiv Fulltext PDF:C\:\\Users\\evyatart\\Zotero\\storage\\8ACFZJV3\\Martelli et al. - 2018 - Thermal transport and phonon hydrodynamics in stro.pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\evyatart\\Zotero\\storage\\BEZH5GCI\\1802.html:text/html}
}

