}

@article{butler_electron-phonon_1978,
	title = {Electron-phonon interaction and lattice thermal conductivity},
	volume = {18},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.18.6483},
	doi = {10.1103/PhysRevB.18.6483},
	abstract = {Phonons in a metal have a finite lifetime due to the emission of electron-hole pairs. This process leads to an electron-phonon contribution Wpep to the thermal resistance, which limits the lattice thermal conductivity κp. We present a summary of the available experimental data on Wpep, emphasizing uncertainties and contrasting results from different types of experiments. Methods of obtaining better data are suggested. We show that the available data are in fair agreement with a simple theoretical estimate lim(T→O)Wpep(TθD)2=0.42 Ω13aNλ(K cm/W), where Ωa is the atomic volume in Å3, N is the Fermi-energy density of states (1 spin) in states/eV, and λ is the electron-phonon mass enhancement. The fact that most of the experimental points fall below this estimate is probably the result of anisotropy and mode dependence of the electron-phonon coupling.},
