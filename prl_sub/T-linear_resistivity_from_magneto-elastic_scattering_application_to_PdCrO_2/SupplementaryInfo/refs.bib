@article{mousatov_planckian_2019,
	title = {On the {Planckian} bound for heat diffusion in insulators},
	url = {http://arxiv.org/abs/1908.04792},
	abstract = {High temperature thermal transport in insulators has been conjectured to be subject to a Planckian bound on the transport lifetime τ τPl ≡ /(kBT ), despite phonon dynamics being entirely classical at these temperatures. We argue that this Planckian bound is due to a quantum mechanical bound on the sound velocity: vs {\textless} vM . The ‘melting velocity’ vM is deﬁned in terms of the melting temperature of the crystal, the interatomic spacing and Planck’s constant. We show that for several classes of insulating crystals, both simple and complex, τ /τPl ≈ vM /vs at high temperatures. The velocity bound therefore implies the Planckian bound.},
	language = {english},
	urldate = {2020-02-13},
	author = {Mousatov, Connie H. and Hartnoll, Sean A.},
	month = sep,
	year = {2019},
	note = {arXiv: 1908.04792},
	keywords = {Condensed Matter - Statistical Mechanics, Condensed Matter - Materials Science},
	annote = {Comment: 10 pages + refs and appendices. 2 figures. v2: improved derivation of the velocity bound},
