\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Rate of change of the scattering rates from fit and experiments. In the case where the resistivity is completely saturated we expect this quantity to be constant. However, neither the electron-phonon contribution, nor the Kondo and EME contributions are linear. Nevertheless, the sum of the scattering rates is almost linear, as evidenced by the constant rate of change. }}{5}{figure.1}\protected@file@percent }
\newlabel{fig:gammatroverT}{{S1}{5}{Rate of change of the scattering rates from fit and experiments. In the case where the resistivity is completely saturated we expect this quantity to be constant. However, neither the electron-phonon contribution, nor the Kondo and EME contributions are linear. Nevertheless, the sum of the scattering rates is almost linear, as evidenced by the constant rate of change}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {}Out-of-plane resistivity}{5}{section*.3}\protected@file@percent }
\newlabel{appendix_caxis}{{}{5}{}{section*.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces c-axis transport: (a) different contributions to the c-axis resistivity for a soft phonon frequency $\omega _0 =2.5 J_H$. Coherent transport dominates over a broad temperature regime but deviates from $T$ linearity at a temperature $T_*$ set by the electron velocity and the magnetoelastic coupling (see main text). The pure incoherent Kondo scattering is always shorted by other conducton channels. (b) Dependence of the c-axis resistivity on variations of the phonon frequency. As $\omega _0$ becomes softer the incoherent conductivty is enhanced and the coherent scattering increases making a saturation regime accessible at high temperatures. }}{6}{figure.2}\protected@file@percent }
\newlabel{fig:outofplane}{{S2}{6}{c-axis transport: (a) different contributions to the c-axis resistivity for a soft phonon frequency $\omega _0 =2.5 J_H$. Coherent transport dominates over a broad temperature regime but deviates from $T$ linearity at a temperature $T_*$ set by the electron velocity and the magnetoelastic coupling (see main text). The pure incoherent Kondo scattering is always shorted by other conducton channels. (b) Dependence of the c-axis resistivity on variations of the phonon frequency. As $\omega _0$ becomes softer the incoherent conductivty is enhanced and the coherent scattering increases making a saturation regime accessible at high temperatures}{figure.2}{}}
