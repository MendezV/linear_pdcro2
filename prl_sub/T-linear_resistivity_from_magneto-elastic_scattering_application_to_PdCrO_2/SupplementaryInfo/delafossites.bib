@article{glamazda_collective_2014,
	title = {Collective excitations in the metallic triangular antiferromagnet \${\textbackslash}mathrm\{{Pd}\}{\textbackslash}mathrm\{{Cr}\}\{{\textbackslash}mathrm\{{O}\}\}\_\{2\}\$},
	volume = {90},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.90.045122},
	doi = {10.1103/PhysRevB.90.045122},
	abstract = {We report a combined Raman-scattering and electron spin resonance (ESR) study of the metallic triangular compound PdCrO2 along with lattice dynamic calculations. Our Raman data reveal (i) an exponential increase of the 706 cm−1 Ag mode involving the out-of-plane motions of the oxygen atoms and (ii) electronic Raman scatterings whose scattering rate is strongly suppressed as the temperature approaches TN=37.5 K. The temperature dependence of the ESR linewidth is described by a critical broadening ΔHpp(T)∝(T−TN)−p with the exponent p=0.63±0.05. These are interpreted in terms of coherence of interplane hoppings along the c axis and a reconstruction of electronic bands on approaching TN. Our results suggest a significant role of an interference between metallic and magnetic layers in explaining collective excitations in PdCrO2.},
	number = {4},
	urldate = {2022-11-23},
	journal = {Physical Review B},
	author = {Glamazda, A. and Lee, W.-J. and Do, S.-H. and Choi, K.-Y. and Lemmens, P. and van Tol, J. and Jeong, J. and Noh, H.-J.},
	month = jul,
	year = {2014},
	note = {Publisher: American Physical Society},
	pages = {045122},
}

