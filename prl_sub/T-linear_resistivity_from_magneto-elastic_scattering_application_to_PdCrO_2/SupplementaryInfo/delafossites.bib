@article{le_magnetic_2018,
	title = {Magnetic interactions in \$\{{\textbackslash}mathrm\{{PdCrO}\}\}\_\{2\}\$ and their effects on its magnetic structure},
	volume = {98},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.98.024429},
	doi = {10.1103/PhysRevB.98.024429},
	abstract = {We report a neutron scattering study of the metallic triangular lattice antiferromagnet PdCrO2. Powder neutron diffraction measurements confirm that the crystalline space group symmetry remains R¯3m below TN. This implies that magnetic interactions consistent with the crystal symmetry do not stabilize the noncoplanar magnetic structure, which was one of two structures previously proposed on the basis of single crystal neutron diffraction measurements. Inelastic neutron scattering measurements find two gaps at low energies, which can be explained as arising from a dipolar-type exchange interaction. This symmetric anisotropic interaction also stabilizes a magnetic structure very similar to the coplanar magnetic structure, which was also suggested by the single crystal diffraction study. The higher-energy magnon dispersion can be modelled by linear spin-wave theory with exchange interactions up to sixth nearest neighbors, but discrepancies remain which hint at additional effects unexplained by the linear theory.},
	number = {2},
	urldate = {2022-11-06},
	journal = {Physical Review B},
	author = {Le, Manh Duc and Jeon, Seyyoung and Kolesnikov, A. I. and Voneshen, D. J. and Gibbs, A. S. and Kim, Jun Sung and Jeong, Jinwon and Noh, Han-Jin and Park, Changhwi and Yu, Jaejun and Perring, T. G. and Park, Je-Geun},
	month = jul,
	year = {2018},
	note = {Publisher: American Physical Society},
	pages = {024429},
}

@article{shibauchi_quantum_2014,
	title = {A {Quantum} {Critical} {Point} {Lying} {Beneath} the {Superconducting} {Dome} in {Iron} {Pnictides}},
	volume = {5},
	url = {https://doi.org/10.1146/annurev-conmatphys-031113-133921},
	doi = {10.1146/annurev-conmatphys-031113-133921},
	abstract = {Whether a quantum critical point (QCP) lies beneath the superconducting dome has been a long-standing issue that remains unresolved in many classes of unconventional superconductors, notably cuprates, heavy fermions, and, most recently, iron pnictides. The existence of a QCP may offer a route to understanding the origin of unconventional superconductors’ anomalous non-Fermi liquid properties, the microscopic coexistence between unconventional superconductivity and magnetic or some other exotic order, and, ultimately, the mechanism of superconductivity itself. The isovalent substituted iron pnictide BaFe2(As1−xPx)2 offers a new platform for the study of quantum criticality, providing a unique opportunity to study the evolution of the electronic properties in a wide range of the phase diagram. Recent experiments in BaFe2(As1−xPx)2 have provided the first clear and unambiguous evidence of a second-order quantum phase transition lying beneath the superconducting dome.},
	number = {1},
	urldate = {2022-11-06},
	journal = {Annual Review of Condensed Matter Physics},
	author = {Shibauchi, T. and Carrington, A. and Matsuda, Y.},
	year = {2014},
	note = {\_eprint: https://doi.org/10.1146/annurev-conmatphys-031113-133921},
	keywords = {antiferromagnetic fluctuations, iron-based superconductors, quantum phase transition, strongly correlated electron systems, unconventional superconductivity},
	pages = {113--135},
}

@article{sunko_probing_2020,
	title = {Probing spin correlations using angle-resolved photoemission in a coupled metallic/{Mott} insulator system},
	volume = {6},
	url = {https://www.science.org/doi/10.1126/sciadv.aaz0611},
	doi = {10.1126/sciadv.aaz0611},
	abstract = {A nearly free electron metal and a Mott insulating state can be thought of as opposite ends of the spectrum of possibilities for the motion of electrons in a solid. Understanding their interaction lies at the heart of the correlated electron problem. In the magnetic oxide metal PdCrO2, nearly free and Mott-localized electrons exist in alternating layers, forming natural heterostructures. Using angle-resolved photoemission spectroscopy, quantitatively supported by a strong coupling analysis, we show that the coupling between these layers leads to an “intertwined” excitation that is a convolution of the charge spectrum of the metallic layer and the spin susceptibility of the Mott layer. Our findings establish PdCrO2 as a model system in which to probe Kondo lattice physics and also open new routes to use the a priori nonmagnetic probe of photoemission to gain insights into the spin susceptibility of correlated electron materials.},
	number = {6},
	urldate = {2022-11-06},
	journal = {Science Advances},
	author = {Sunko, V. and Mazzola, F. and Kitamura, S. and Khim, S. and Kushwaha, P. and Clark, O. J. and Watson, M. D. and Marković, I. and Biswas, D. and Pourovskii, L. and Kim, T. K. and Lee, T.-L. and Thakur, P. K. and Rosner, H. and Georges, A. and Moessner, R. and Oka, T. and Mackenzie, A. P. and King, P. D. C.},
	month = feb,
	year = {2020},
	note = {Publisher: American Association for the Advancement of Science},
	pages = {eaaz0611},
}

@article{frohlich_interaction_1952,
	title = {Interaction of electrons with lattice vibrations},
	volume = {215},
	url = {https://royalsocietypublishing.org/doi/10.1098/rspa.1952.0212},
	doi = {10.1098/rspa.1952.0212},
	abstract = {Using methods of modern field theories a canonical transformation of the Hamiltonian of free electrons in the field of the lattice vibrations is performed. This transformation takes account of the bulk of the interaction of the electrons with the vibrational field and leads to a renormalization of the velocity of sound and of the interaction parameter F. An objection of Wentzel’s against the use of large F is removed in this way. Even in the case of weak interaction the transformed Hamiltonian contains already in zero order terms which require a modification of the usual procedure in the theory of metals, and which at low temperatures lead to an increase of the effective mass of the electrons. Treatment of strong interaction requires the development of a new method.},
	number = {1122},
	urldate = {2022-11-09},
	journal = {Proceedings of the Royal Society of London. Series A. Mathematical and Physical Sciences},
	author = {Fröhlich, Herbert},
	month = dec,
	year = {1952},
	note = {Publisher: Royal Society},
	pages = {291--298},
}

@article{allen_bloch-boltzmann_1993,
	title = {Bloch-{Boltzmann} analysis of electrical transport in intermetallic compounds: \$\{{\textbackslash}mathrm\{{ReO}\}\}\_\{3\}\$, \$\{{\textbackslash}mathrm\{{BaPbO}\}\}\_\{3\}\$, \$\{{\textbackslash}mathrm\{{CoSi}\}\}\_\{2\}\$, and \$\{{\textbackslash}mathrm\{{Pd}\}\}\_\{2\}\${Si}},
	volume = {47},
	shorttitle = {Bloch-{Boltzmann} analysis of electrical transport in intermetallic compounds},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.47.14434},
	doi = {10.1103/PhysRevB.47.14434},
	abstract = {The shape and magnitude of the electrical resistivity ρ(T) is analyzed for four intermetallic compounds, and electron-phonon coupling constants λ are extracted. ReO3 is particularly interesting because a sharp departure from the Bloch-Grüneisen shape can be attributed to high-frequency optical vibrations. The λ values for the oxide metals seem too large to be consistent with the absence of superconductivity, but the results generally agree well with a conventional Fermi-liquid interpretation. The Hall coefficient RH of ReO3 is found to agree well with theory.},
	number = {21},
	urldate = {2022-11-11},
	journal = {Physical Review B},
	author = {Allen, Philip B. and Schulz, Werner W.},
	month = jun,
	year = {1993},
	note = {Publisher: American Physical Society},
	pages = {14434--14439},
}

@article{takatsu_roles_2007,
